  view_file {
    absolute_path_uri: "file:///src/components/LandingPage.tsx"
    end_line: 331
    content: "import React from \'react\';\nimport { useAuth } from \'../context/AuthContext.js\';\nimport { Hero3DScene } from \'./Hero3DScene.js\';\nimport {\n  Cpu,\n  Calculator,\n  FileCode,\n  GraduationCap,\n  ArrowRight,\n  Shield,\n  Zap,\n  Volume2,\n  Camera,\n  Search,\n  Binary,\n  Layers,\n  ChevronDown,\n} from \'lucide-react\';\n\nexport function LandingPage() {\n  const { login } = useAuth();\n\n  const scrollToHowItWorks = () => {\n    document.getElementById(\'how-it-works\')?.scrollIntoView({ behavior: \'smooth\' });\n  };\n\n  return (\n    <div className=\"flex flex-col w-full pb-20\">\n      {/* Hero Section */}\n      <section className=\"min-h-[calc(100vh-4rem)] flex items-center py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center w-full\">\n          {/* Left Hero Content */}\n          <div className=\"lg:col-span-7 flex flex-col gap-6\">\n            <div className=\"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-[#1F2A37] w-fit\">\n              <span className=\"w-2 h-2 rounded-full bg-[#FF7A1A] animate-pulse\"></span>\n              <span className=\"text-xs font-mono text-[#8B98A5]\">\n                AI explains. <strong className=\"text-[#22D3EE]\">Physics decides.</strong>\n              </span>\n            </div>\n\n            <h1 className=\"text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.1]\">\n              Your machine stopped.{\' \'}\n              <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-[#FF7A1A] to-[#22D3EE]\">\n                Copilot knows why.\n              </span>\n            </h1>\n\n            <p className=\"text-base sm:text-lg text-[#8B98A5] max-w-2xl leading-relaxed\">\n              Snap the alarm screen, ask in your language, get the fix from your own controller manual, with the page number.\n            </p>\n\n            <div className=\"flex flex-wrap items-center gap-4 pt-2\">\n              <button\n                onClick={login}\n                className=\"touch-target px-6 py-3 rounded-xl bg-[#FF7A1A] hover:bg-[#E56910] text-[#0B0F14] font-bold text-base flex items-center justify-center gap-2 shadow-xl shadow-orange-500/20 active:scale-95 transition-all\"\n              >\n                <span>Sign in with Google</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </button>\n\n              <button\n                onClick={scrollToHowItWorks}\n                className=\"touch-target px-6 py-3 rounded-xl bg-white/5 hover:bg-white/10 border border-[#1F2A37] text-[#E6EDF3] font-semibold text-base flex items-center justify-center gap-2 transition-all\"\n              >\n                <span>See how it works</span>\n                <ChevronDown className=\"w-4 h-4 text-[#8B98A5]\" />\n              </button>\n            </div>\n\n            <div className=\"grid grid-cols-3 gap-4 pt-4 border-t border-[#1F2A37]/80 text-xs font-mono text-[#8B98A5]\">\n              <div>\n                <span className=\"block text-white font-bold text-sm\">Deterministic</span>\n                <span>Kienzle cutting physics</span>\n              </div>\n              <div>\n                <span className=\"block text-[#22D3EE] font-bold text-sm\">Grounded</span>\n                <span>Controller manual citations</span>\n              </div>\n              <div>\n                <span className=\"block text-[#FF7A1A] font-bold text-sm\">Multilingual</span>\n                <span>Hindi, Tamil, Malayalam</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Right Hero 3D Scene */}\n          <div className=\"lg:col-span-5 w-full\">\n            <Hero3DScene />\n          </div>\n        </div>\n      </section>\n\n      {/* \"Fix today\'s machine\" Section: 3 Cards */}\n      <section className=\"py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full\">\n        <div className=\"flex flex-col gap-2 mb-8\">\n          <span className=\"text-xs font-mono uppercase tracking-wider text-[#FF7A1A]\">Core Diagnostics Suite</span>\n          <h2 className=\"text-2xl sm:text-3xl font-bold text-white tracking-tight\">Fix today\'s machine</h2>\n          <p className=\"text-sm text-[#8B98A5]\">\n            Instant resolution of alarms, optimal cutting physics, and kinematic G-code sanity verification.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          {/* Card 1: Shopfloor Agent */}\n          <div className=\"glass-panel p-6 flex flex-col justify-between\">\n            <div className=\"flex flex-col gap-4\">\n              <div className=\"w-12 h-12 rounded-xl bg-[#FF7A1A]/10 border border-[#FF7A1A]/30 flex items-center justify-center text-[#FF7A1A]\">\n                <Cpu className=\"w-6 h-6\" />\n              </div>\n              <div>\n                <h3 className=\"text-lg font-bold text-white mb-1\">Shopfloor Agent</h3>\n                <p className=\"text-sm text-[#8B98A5] leading-relaxed\">\n                  Voice, photo, or code diagnosis. Analyzes pendant alarms, cross-references your uploaded manuals, and cites exact manual page numbers.\n                </p>\n              </div>\n            </div>\n            <div className=\"mt-6 pt-4 border-t border-[#1F2A37] flex items-center justify-between text-xs font-mono text-[#FF7A1A]\">\n              <span>Camera \342\200\242 Voice \342\200\242 Citations</span>\n              <ArrowRight className=\"w-4 h-4\" />\n            </div>\n          </div>\n\n          {/* Card 2: Cutting Calculator */}\n          <div className=\"glass-panel p-6 flex flex-col justify-between\">\n            <div className=\"flex flex-col gap-4\">\n              <div className=\"w-12 h-12 rounded-xl bg-[#22D3EE]/10 border border-[#22D3EE]/30 flex items-center justify-center text-[#22D3EE]\">\n                <Calculator className=\"w-6 h-6\" />\n              </div>\n              <div>\n                <h3 className=\"text-lg font-bold text-white mb-1\">Cutting Calculator</h3>\n                <p className=\"text-sm text-[#8B98A5] leading-relaxed\">\n                  Rigorous Kienzle force and chip thickness math for milling, turning, drilling, and tapping. Real-time machine power gauge and torque limits.\n                </p>\n              </div>\n            </div>\n            <div className=\"mt-6 pt-4 border-t border-[#1F2A37] flex items-center justify-between text-xs font-mono text-[#22D3EE]\">\n              <span>Physics Engine \342\200\242 Zero Guesswork</span>\n              <ArrowRight className=\"w-4 h-4\" />\n            </div>\n          </div>\n\n          {/* Card 3: G-code Verifier */}\n          <div className=\"glass-panel p-6 flex flex-col justify-between\">\n            <div className=\"flex flex-col gap-4\">\n              <div className=\"w-12 h-12 rounded-xl bg-[#22C55E]/10 border border-[#22C55E]/30 flex items-center justify-center text-[#22C55E]\">\n                <FileCode className=\"w-6 h-6\" />\n              </div>\n              <div>\n                <h3 className=\"text-lg font-bold text-white mb-1\">G-code Verifier</h3>\n                <p className=\"text-sm text-[#8B98A5] leading-relaxed\">\n                  Deterministic syntax & motion parser with 3D kinematic backplot. Catches rapid plunges into stock, missing G43 offsets, and spindle-off feeds.\n                </p>\n              </div>\n            </div>\n            <div className=\"mt-6 pt-4 border-t border-[#1F2A37] flex items-center justify-between text-xs font-mono text-[#22C55E]\">\n              <span>3D Backplot \342\200\242 Gemini Pro Review</span>\n              <ArrowRight className=\"w-4 h-4\" />\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* \"Build tomorrow\'s operator\": Academy Band */}\n      <section className=\"py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full\">\n        <div className=\"glass-panel p-8 sm:p-10 border-l-4 border-l-[#FF7A1A] relative overflow-hidden\">\n          <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8\">\n            <div>\n              <div className=\"flex items-center gap-2 mb-2\">\n                <GraduationCap className=\"w-5 h-5 text-[#FF7A1A]\" />\n                <span className=\"text-xs font-mono uppercase tracking-wider text-[#FF7A1A]\">\n                  Operator Academy \342\200\242 Crash Lab\n                </span>\n              </div>\n              <h2 className=\"text-2xl sm:text-3xl font-bold text-white tracking-tight\">\n                Crash the machine here. Never on the shop floor.\n              </h2>\n              <p className=\"text-sm text-[#8B98A5] mt-1\">\n                Gamified 3D kinematic training missions with real repair cost calculations (INR) and interactive AI instructor hints.\n              </p>\n            </div>\n            <div className=\"px-3 py-1.5 rounded-lg bg-[#FF7A1A]/10 border border-[#FF7A1A]/30 text-xs font-mono text-[#FF7A1A] self-start md:self-auto\">\n              Phase 2: VR operator training\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n            <div className=\"bg-[#111820] p-4 rounded-xl border border-[#1F2A37]\">\n              <div className=\"flex justify-between items-center text-xs font-mono mb-2\">\n                <span className=\"text-[#FF7A1A]\">Mission 01</span>\n                <span className=\"text-[#22C55E]\">100 XP</span>\n              </div>\n              <h4 className=\"text-sm font-bold text-white mb-1\">The Missing Offset</h4>\n              <p className=\"text-xs text-[#8B98A5]\">Fix the dangerous G00 move omitting G43 H01 before the spindle plunges.</p>\n            </div>\n\n            <div className=\"bg-[#111820] p-4 rounded-xl border border-[#1F2A37]\">\n              <div className=\"flex justify-between items-center text-xs font-mono mb-2\">\n                <span className=\"text-[#FF7A1A]\">Mission 02</span>\n                <span className=\"text-[#22C55E]\">120 XP</span>\n              </div>\n              <h4 className=\"text-sm font-bold text-white mb-1\">Rapid Into Stock</h4>\n              <p className=\"text-xs text-[#8B98A5]\">Separate high-speed positioning from controlled feed into raw billet.</p>\n            </div>\n\n            <div className=\"bg-[#111820] p-4 rounded-xl border border-[#1F2A37]\">\n              <div className=\"flex justify-between items-center text-xs font-mono mb-2\">\n                <span className=\"text-[#FF7A1A]\">Mission 03</span>\n                <span className=\"text-[#22C55E]\">150 XP</span>\n              </div>\n              <h4 className=\"text-sm font-bold text-white mb-1\">Stripped Tap</h4>\n              <p className=\"text-xs text-[#8B98A5]\">Synchronize rigid tapping feed rate (F = S x pitch) to prevent tap breakage.</p>\n            </div>\n\n            <div className=\"bg-[#111820] p-4 rounded-xl border border-[#1F2A37]\">\n              <div className=\"flex justify-between items-center text-xs font-mono mb-2\">\n                <span className=\"text-[#FF7A1A]\">Mission 04</span>\n                <span className=\"text-[#22C55E]\">100 XP</span>\n              </div>\n              <h4 className=\"text-sm font-bold text-white mb-1\">Dead Spindle</h4>\n              <p className=\"text-xs text-[#8B98A5]\">Catch inactive spindle rotation (M05) before cutting engagement.</p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* \"How it works\": 4 Step Horizontal Flow */}\n      <section id=\"how-it-works\" className=\"py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full\">\n        <div className=\"flex flex-col gap-2 mb-10 text-center max-w-2xl mx-auto\">\n          <span className=\"text-xs font-mono uppercase tracking-wider text-[#22D3EE]\">Deterministic Workflow</span>\n          <h2 className=\"text-2xl sm:text-3xl font-bold text-white tracking-tight\">How it works</h2>\n          <p className=\"text-sm text-[#8B98A5]\">\n            From machine alarm to grounded physical action in under ten seconds.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n          <div className=\"glass-panel p-6 flex flex-col gap-3\">\n            <div className=\"w-10 h-10 rounded-lg bg-white/5 border border-[#1F2A37] flex items-center justify-center text-[#FF7A1A] font-mono font-bold\">\n              01\n            </div>\n            <h3 className=\"font-bold text-base text-white\">Ask</h3>\n            <p className=\"text-xs text-[#8B98A5] leading-relaxed\">\n              Capture a photo of the CNC pendant, speak through your headset, or type G-code blocks directly.\n            </p>\n          </div>\n\n          <div className=\"glass-panel p-6 flex flex-col gap-3\">\n            <div className=\"w-10 h-10 rounded-lg bg-white/5 border border-[#1F2A37] flex items-center justify-center text-[#22D3EE] font-mono font-bold\">\n              02\n            </div>\n            <h3 className=\"font-bold text-base text-white\">Retrieve</h3>\n            <p className=\"text-xs text-[#8B98A5] leading-relaxed\">\n              Google File Search queries your OEM manuals and shop standards with strict controller metadata filtering.\n            </p>\n          </div>\n\n          <div className=\"glass-panel p-6 flex flex-col gap-3\">\n            <div className=\"w-10 h-10 rounded-lg bg-white/5 border border-[#1F2A37] flex items-center justify-center text-[#22C55E] font-mono font-bold\">\n              03\n            </div>\n            <h3 className=\"font-bold text-base text-white\">Compute</h3>\n            <p className=\"text-xs text-[#8B98A5] leading-relaxed\">\n              Pure TypeScript physics and kinematic collision engines verify limits, feeds, speeds, and toolpath geometries.\n            </p>\n          </div>\n\n          <div className=\"glass-panel p-6 flex flex-col gap-3\">\n            <div className=\"w-10 h-10 rounded-lg bg-white/5 border border-[#1F2A37] flex items-center justify-center text-[#F59E0B] font-mono font-bold\">\n              04\n            </div>\n            <h3 className=\"font-bold text-base text-white\">Answer</h3>\n            <p className=\"text-xs text-[#8B98A5] leading-relaxed\">\n              Gemini delivers concise, actionable instructions in your preferred language with exact manual page citations.\n            </p>\n          </div>\n        </div>\n      </section>\n\n      {/* \"Built on Google\" Stack Grid */}\n      <section className=\"py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full border-t border-[#1F2A37]\">\n        <div className=\"flex flex-col items-center gap-2 mb-6 text-center\">\n          <span className=\"text-xs font-mono uppercase tracking-wider text-[#8B98A5]\">Infrastructure</span>\n          <h3 className=\"text-xl font-bold text-white\">Built on Google Cloud & AI Platform</h3>\n        </div>\n\n        <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 text-center\">\n          <div className=\"p-3 rounded-xl bg-white/5 border border-[#1F2A37] font-mono text-xs text-[#E6EDF3]\">\n            <span className=\"block font-bold text-[#FF7A1A] mb-0.5\">Gemini 2.5</span>\n            <span className=\"text-[10px] text-[#8B98A5]\">Flash & Pro</span>\n          </div>\n          <div className=\"p-3 rounded-xl bg-white/5 border border-[#1F2A37] font-mono text-xs text-[#E6EDF3]\">\n            <span className=\"block font-bold text-[#22D3EE] mb-0.5\">File Search</span>\n            <span className=\"text-[10px] text-[#8B98A5]\">Semantic RAG</span>\n          </div>\n          <div className=\"p-3 rounded-xl bg-white/5 border border-[#1F2A37] font-mono text-xs text-[#E6EDF3]\">\n            <span className=\"block font-bold text-white mb-0.5\">Google AI Studio</span>\n            <span className=\"text-[10px] text-[#8B98A5]\">Build Platform</span>\n          </div>\n          <div className=\"p-3 rounded-xl bg-white/5 border border-[#1F2A37] font-mono text-xs text-[#E6EDF3]\">\n            <span className=\"block font-bold text-[#22C55E] mb-0.5\">Antigravity</span>\n            <span className=\"text-[10px] text-[#8B98A5]\">Workflow Runtime</span>\n          </div>\n          <div className=\"p-3 rounded-xl bg-white/5 border border-[#1F2A37] font-mono text-xs text-[#E6EDF3]\">\n            <span className=\"block font-bold text-[#F59E0B] mb-0.5\">Cloud Run</span>\n            <span className=\"text-[10px] text-[#8B98A5]\">Serverless Container</span>\n          </div>\n          <div className=\"p-3 rounded-xl bg-white/5 border border-[#1F2A37] font-mono text-xs text-[#E6EDF3]\">\n            <span className=\"block font-bold text-[#FF7A1A] mb-0.5\">Firebase</span>\n            <span className=\"text-[10px] text-[#8B98A5]\">Firestore & Auth</span>\n          </div>\n        </div>\n      </section>\n\n      {/* Footer */}\n      <footer className=\"w-full border-t border-[#1F2A37] mt-8 pt-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-[#8B98A5]\">\n        <div>\n          <span>Built for Google Cloud AI Builder Cup 2026</span>\n        </div>\n        <div className=\"flex items-center gap-4\">\n          <a href=\"#\" className=\"hover:text-white transition-colors\">\n            GitHub Repository\n          </a>\n          <span>\342\200\242</span>\n          <span>Station ID: MC-094</span>\n          <span>\342\200\242</span>\n          <span className=\"text-[#22C55E]\">Shift Net: ONLINE</span>\n        </div>\n      </footer>\n    </div>\n  );\n}\n"
    num_lines: 332
    num_bytes: 17165
    line_range_bytes: 17165
  }
}
