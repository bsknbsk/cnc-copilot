      arguments_json: "{\"CommandLine\":\"node -e \\\"\\nimport(\'./src/lib/firebase.js\').then(m => {\\n  console.log(\'firebase imported\');\\n}).catch(e => {\\n  console.error(\'Import error:\', e);\\n});\\nprocess.on(\'unhandledRejection\', (reason) => {\\n  console.error(\'NODE UNHANDLED REJECTION:\', reason);\\n});\\n\\\"\",\"Cwd\":\"/app/applet\",\"WaitMsBeforeAsync\":3000,\"toolAction\":\"Testing firebase module in node\",\"toolSummary\":\"Test firebase in node\"}"
