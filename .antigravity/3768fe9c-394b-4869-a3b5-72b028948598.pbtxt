    content: "import React, { useEffect, useState, useMemo } from \'react\';\nimport { useAuth } from \'../context/AuthContext.js\';\nimport { collection, query, where, orderBy, limit, onSnapshot, doc, getDocs } from \'firebase/firestore\';\nimport { db } from \'../lib/firebase.js\';\n\ninterface DashboardProps {\n  onNavigate: (tab: string, state?: any) => void;\n}\n\nexport interface ActivityItem {\n  id: string;\n  type: \'chat\' | \'calc\' | \'gcode\' | \'academy\';\n  title: string;\n  summary?: string;\n  link?: string;\n  alarm?: string;\n  controller?: string;\n  imageUrl?: string;\n  createdAt?: string;\n}\n\ninterface ManualItem {\n  id: string;\n  name: string;\n  controller: string;\n  docType: string;\n  pages?: number;\n  status: string;\n}\n\ninterface AcademyProgress {\n  xp: number;\n  level: string;\n  streakDays: number;\n  missions?: Record<string, any>;\n}\n\nexport function Dashboard({ onNavigate }: DashboardProps) {\n  const { user, profile, isAdmin } = useAuth();\n  const [activities, setActivities] = useState<ActivityItem[]>([]);\n  const [manuals, setManuals] = useState<ManualItem[]>([]);\n  const [academy, setAcademy] = useState<AcademyProgress | null>(null);\n  const [lastSnapshot, setLastSnapshot] = useState<{ url: string; caption?: string } | null>(null);\n  const [activeTab, setActiveTab] = useState<\'all\' | \'calc\' | \'alarm\' | \'gcode\'>(\'all\');\n\n  // Time & shift computation\n  const now = new Date();\n  const hour = now.getHours();\n\n  let greeting = \'Good morning\';\n  if (hour >= 12 && hour < 17) greeting = \'Good afternoon\';\n  if (hour >= 17 || hour < 4) greeting = \'Good evening\';\n\n  let shiftName = \'Shift 1 (06:00-14:00)\';\n  if (hour >= 14 && hour < 22) shiftName = \'Shift 2 (14:00-22:00)\';\n  if (hour >= 22 || hour < 6) shiftName = \'Shift 3 (22:00-06:00)\';\n\n  const dateFormatted = now.toLocaleDateString(undefined, {\n    weekday: \'long\',\n    month: \'short\',\n    day: \'numeric\',\n    year: \'numeric\',\n  });\n\n  const firstName = (profile?.displayName || user?.displayName || \'Operator\').split(\' \')[0];\n  const preferredControllerName = (profile?.preferredController || \'fanuc\').toUpperCase();\n\n  // Real-time Firestore subscriptions\n  useEffect(() => {\n    if (!user) return;\n\n    // 1. Subscribe to recent activities (up to 20 for metrics & filtering)\n    const activityQuery = query(\n      collection(db, \'users\', user.uid, \'activity\'),\n      orderBy(\'createdAt\', \'desc\'),\n      limit(25)\n    );\n\n    const unsubActivity = onSnapshot(\n      activityQuery,\n      (snap) => {\n        const list: ActivityItem[] = snap.docs.map((d) => ({\n          id: d.id,\n          ...(d.data() as any),\n        }));\n        setActivities(list);\n\n        // Find last image snapshot from activities if available\n        const imgActivity = list.find((a) => a.imageUrl);\n        if (imgActivity && imgActivity.imageUrl) {\n          setLastSnapshot({ url: imgActivity.imageUrl, caption: imgActivity.summary || imgActivity.title });\n        }\n      },\n      (err) => console.warn(\'[Dashboard] Activity stream notice:\', err)\n    );\n\n    // 2. Fetch last screen snapshot from recent messages across chats if not found in activity\n    const fetchLatestMessageSnapshot = async () => {\n      try {\n        const chatsSnap = await getDocs(\n          query(collection(db, \'users\', user.uid, \'chats\'), orderBy(\'updatedAt\', \'desc\'), limit(3))\n        );\n        for (const chatDoc of chatsSnap.docs) {\n          const msgsSnap = await getDocs(\n            query(collection(db, \'users\', user.uid, \'chats\', chatDoc.id, \'messages\'), orderBy(\'createdAt\', \'desc\'), limit(5))\n          );\n          const msgWithImg = msgsSnap.docs.find((m) => m.data().imageUrl);\n          if (msgWithImg) {\n            const data = msgWithImg.data();\n            setLastSnapshot({ url: data.imageUrl, caption: data.text ? data.text.slice(0, 80) : \'Pendant Alarm Screen\' });\n            break;\n          }\n        }\n      } catch {\n        // Handled silently\n      }\n    };\n    fetchLatestMessageSnapshot();\n\n    // 3. Subscribe to Ready OEM manuals\n    const manualsQuery = query(\n      collection(db, \'kb_docs\'),\n      where(\'status\', \'==\', \'Ready\'),\n      limit(8)\n    );\n\n    const unsubManuals = onSnapshot(\n      manualsQuery,\n      (snap) => {\n        const list: ManualItem[] = snap.docs.map((d) => ({\n          id: d.id,\n          ...(d.data() as any),\n        }));\n        setManuals(list);\n      },\n      (err) => console.warn(\'[Dashboard] Manuals stream notice:\', err)\n    );\n\n    // 4. Subscribe to Academy Progress\n    const unsubAcademy = onSnapshot(\n      doc(db, \'users\', user.uid, \'academy\', \'progress\'),\n      (snap) => {\n        if (snap.exists()) {\n          setAcademy(snap.data() as AcademyProgress);\n        }\n      },\n      (err) => console.warn(\'[Dashboard] Academy progress stream notice:\', err)\n    );\n\n    return () => {\n      unsubActivity();\n      unsubManuals();\n      unsubAcademy();\n    };\n  }, [user]);\n\n  // Rule 1: Alert banner: show only when the user\'s latest activity of type \"chat\" in the last 24 h has an alarm code\n  const latestChatWithAlarm = useMemo(() => {\n    const chatActivities = activities.filter((a) => a.type === \'chat\');\n    if (!chatActivities.length) return null;\n    const latest = chatActivities[0];\n    if (!latest.createdAt) return null;\n\n    const diffHours = (now.getTime() - new Date(latest.createdAt).getTime()) / (1000 * 60 * 60);\n    if (diffHours > 24) return null;\n\n    // Check if alarm code exists in alarm field or title\n    const alarmCode = latest.alarm || (latest.title.match(/SV\\d+|ALARM\\s*\\w+|\\b[A-Z]{2,}\\d{3,}\\b/i)?.[0]);\n    if (!alarmCode) return null;\n\n    return {\n      ...latest,\n      detectedAlarm: alarmCode,\n    };\n  }, [activities]);\n\n  // Rule 3: The 4 stat chips for today\n  const todayDateStr = now.toISOString().slice(0, 10);\n  const questionsToday = activities.filter((a) => a.type === \'chat\' && a.createdAt?.startsWith(todayDateStr)).length;\n  const calcsToday = activities.filter((a) => a.type === \'calc\' && a.createdAt?.startsWith(todayDateStr)).length;\n  const verifiedToday = activities.filter((a) => a.type === \'gcode\' && a.createdAt?.startsWith(todayDateStr)).length;\n\n  // Rule 5: Activity counts for last 7 days SVG area chart & 4 readouts\n  const { chartData, totalChats, totalCalcs, totalVerified, crashesAvoided } = useMemo(() => {\n    const days: { date: string; count: number }[] = [];\n    for (let i = 6; i >= 0; i--) {\n      const d = new Date();\n      d.setDate(d.getDate() - i);\n      const dStr = d.toISOString().slice(0, 10);\n      days.push({ date: dStr, count: 0 });\n    }\n\n    let chats = 0;\n    let calcs = 0;\n    let verified = 0;\n\n    activities.forEach((act) => {\n      if (act.type === \'chat\') chats++;\n      if (act.type === \'calc\') calcs++;\n      if (act.type === \'gcode\') verified++;\n\n      if (act.createdAt) {\n        const dStr = act.createdAt.slice(0, 10);\n        const dayEntry = days.find((d) => d.date === dStr);\n        if (dayEntry) dayEntry.count++;\n      }\n    });\n\n    let passedMissions = 0;\n    if (academy?.missions) {\n      Object.values(academy.missions).forEach((m: any) => {\n        if (m?.status === \'completed\' || m?.bestXp > 0) passedMissions++;\n      });\n    }\n\n    return {\n      chartData: days,\n      totalChats: chats,\n      totalCalcs: calcs,\n      totalVerified: verified,\n      crashesAvoided: passedMissions,\n    };\n  }, [activities, academy]);\n\n  // SVG Area path generation for last 7 days\n  const { svgAreaPath, svgLinePath, maxVal, currentDayVal } = useMemo(() => {\n    const counts = chartData.map((d) => d.count);\n    const max = Math.max(...counts, 4); // baseline max 4 for scale\n    const width = 700;\n    const height = 140;\n\n    const points = chartData.map((d, index) => {\n      const x = (index / (chartData.length - 1)) * width;\n      const y = height - (d.count / max) * (height - 30) - 20;\n      return { x, y };\n    });\n\n    let linePath = `M ${points[0].x} ${points[0].y}`;\n    for (let i = 1; i < points.length; i++) {\n      const prev = points[i - 1];\n      const curr = points[i];\n      const cx = (prev.x + curr.x) / 2;\n      linePath += ` C ${cx} ${prev.y}, ${cx} ${curr.y}, ${curr.x} ${curr.y}`;\n    }\n\n    const areaPath = `${linePath} L ${width} ${height} L 0 ${height} Z`;\n\n    return {\n      svgAreaPath: areaPath,\n      svgLinePath: linePath,\n      maxVal: Math.max(...counts),\n      currentDayVal: counts[counts.length - 1] || 0,\n    };\n  }, [chartData]);\n\n  // Rule 7: Filter activities by active tab\n  const filteredActivities = useMemo(() => {\n    if (activeTab === \'all\') return activities.slice(0, 8);\n    if (activeTab === \'calc\') return activities.filter((a) => a.type === \'calc\').slice(0, 8);\n    if (activeTab === \'alarm\') return activities.filter((a) => a.type === \'chat\').slice(0, 8);\n    if (activeTab === \'gcode\') return activities.filter((a) => a.type === \'gcode\').slice(0, 8);\n    return activities.slice(0, 8);\n  }, [activities, activeTab]);\n\n  // Helper for relative timestamps\n  const getRelativeTime = (iso?: string) => {\n    if (!iso) return \'Just now\';\n    const diffMs = now.getTime() - new Date(iso).getTime();\n    const diffMins = Math.floor(diffMs / (60 * 1000));\n    if (diffMins < 1) return \'Just now\';\n    if (diffMins < 60) return `${diffMins}m ago`;\n    const diffHours = Math.floor(diffMins / 60);\n    if (diffHours < 24) return `${diffHours}h ago`;\n    return `${Math.floor(diffHours / 24)}d ago`;\n  };\n\n  return (\n    <div className=\"w-full px-margin py-margin\">\n      <div className=\"flex flex-col w-full\">\n        {/* 1. Alert Banner: show only when user\'s latest activity of type \"chat\" in last 24h has an alarm code */}\n        {latestChatWithAlarm && (\n          <section className=\"w-full mb-space-lg\">\n            <div className=\"relative overflow-hidden rounded-xl bg-surface-container-high p-space-md shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-space-md\">\n              <div className=\"absolute left-0 top-0 bottom-0 w-1.5 bg-primary-container\"></div>\n              <div className=\"flex items-center gap-space-md pl-space-xs\">\n                <div className=\"w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary-container flex-shrink-0 shadow-inner\">\n                  <span className=\"material-symbols-outlined text-[24px]\">warning</span>\n                </div>\n                <div className=\"flex flex-col\">\n                  <div className=\"flex items-center gap-space-xs flex-wrap\">\n                    <span className=\"font-label-md text-label-md font-bold uppercase tracking-wider text-primary-container\">\n                      Active Alarm Diagnosis\n                    </span>\n                    <span className=\"text-tertiary-container\">\342\200\242</span>\n                    <span className=\"font-code-sm text-code-sm font-semibold text-on-surface\">\n                      Alarm {latestChatWithAlarm.detectedAlarm}\n                    </span>\n                  </div>\n                  <p className=\"font-body-md text-body-md text-on-surface-variant mt-0.5\">\n                    Last diagnosis: <strong className=\"text-primary font-mono\">{latestChatWithAlarm.detectedAlarm}</strong> on{\' \'}\n                    <span className=\"text-secondary font-mono\">{latestChatWithAlarm.controller || preferredControllerName}</span>.{\' \'}\n                    {latestChatWithAlarm.title}\n                  </p>\n                </div>\n              </div>\n              <div className=\"flex items-center gap-space-sm w-full md:w-auto self-end md:self-auto flex-shrink-0\">\n                <button\n                  onClick={() => onNavigate(\'agent\', { chatId: latestChatWithAlarm.link })}\n                  className=\"h-12 px-space-lg rounded-xl bg-primary-container text-on-primary-container hover:bg-primary transition-colors flex items-center justify-center gap-space-xs font-headline-sm text-headline-sm font-bold shadow-md w-full md:w-auto cursor-pointer\"\n                  type=\"button\"\n                >\n                  <span>Continue</span>\n                  <span className=\"material-symbols-outlined text-[20px]\">arrow_forward</span>\n                </button>\n              </div>\n            </div>\n          </section>\n        )}\n\n        {/* 2. Header & Live Telemetry / Stat Chips Section */}\n        <section className=\"w-full flex flex-col lg:flex-row lg:items-end justify-between gap-space-lg mb-space-xl\">\n          <div className=\"flex flex-col\">\n            <div className=\"flex items-center gap-space-xs mb-1\">\n              <span className=\"w-2 h-2 rounded-full bg-secondary animate-pulse\"></span>\n              <span className=\"font-label-sm text-label-sm uppercase tracking-wider font-mono text-secondary\">\n                Operational Sync Active\n              </span>\n            </div>\n            <h1 className=\"font-headline-lg text-headline-lg text-on-surface font-bold tracking-tight\">\n              {greeting}, {firstName}\n            </h1>\n            <p className=\"font-label-md text-label-md uppercase tracking-wider text-tertiary font-mono mt-1\">\n              {dateFormatted} <span className=\"text-surface-variant\">|</span> {shiftName} \342\200\242 {preferredControllerName} Cell\n            </p>\n          </div>\n\n          {/* 3. The 4 Stat Chips Deck */}\n          <div className=\"flex flex-wrap items-center gap-space-sm\">\n            {/* Stat Chip 1: Questions today */}\n            <div className=\"bg-surface-container px-space-md py-space-sm rounded-lg flex items-center gap-space-sm shadow-sm border border-outline-variant/30\">\n              <span className=\"material-symbols-outlined text-secondary text-[20px]\">smart_toy</span>\n              <div className=\"flex flex-col\">\n                <span className=\"font-label-sm text-label-sm uppercase text-tertiary\">Questions today</span>\n                <div className=\"flex items-baseline gap-space-xs\">\n                  <span className=\"font-code-md text-code-md font-bold text-on-surface\">{questionsToday}</span>\n                  <span className=\"font-label-sm text-label-sm text-secondary uppercase font-mono ml-1\">\n                    {questionsToday > 0 ? \'LOGGED\' : \'STANDBY\'}\n                  </span>\n                </div>\n              </div>\n            </div>\n\n            {/* Stat Chip 2: Calculations today */}\n            <div className=\"bg-surface-container px-space-md py-space-sm rounded-lg flex items-center gap-space-sm shadow-sm border border-outline-variant/30\">\n              <span className=\"material-symbols-outlined text-secondary-container text-[20px]\">calculate</span>\n              <div className=\"flex flex-col\">\n                <span className=\"font-label-sm text-label-sm uppercase text-tertiary\">Calculations today</span>\n                <div className=\"flex items-baseline gap-space-xs\">\n                  <span className=\"font-code-md text-code-md font-bold text-on-surface\">{calcsToday}</span>\n                  <span className=\"font-label-sm text-label-sm text-tertiary font-mono\">RUNS</span>\n                </div>\n              </div>\n            </div>\n\n            {/* Stat Chip 3: Programs verified today */}\n            <div className=\"bg-surface-container px-space-md py-space-sm rounded-lg flex items-center gap-space-sm shadow-sm border border-outline-variant/30\">\n              <span className=\"material-symbols-outlined text-primary text-[20px]\">terminal</span>\n              <div className=\"flex flex-col\">\n                <span className=\"font-label-sm text-label-sm uppercase text-tertiary\">Programs verified</span>\n                <div className=\"flex items-baseline gap-space-xs\">\n                  <span className=\"font-code-md text-code-md font-bold text-primary\">{verifiedToday}</span>\n                  <span className=\"font-body-sm text-body-sm text-on-surface truncate max-w-[120px]\">\n                    {verifiedToday > 0 ? \'VERIFIED\' : \'0 BLOCKS\'}\n                  </span>\n                </div>\n              </div>\n            </div>\n\n            {/* Stat Chip 4: Crash Lab (Links to /academy) */}\n            <div\n              onClick={() => onNavigate(\'academy\')}\n              className=\"bg-surface-container hover:bg-surface-container-high px-space-md py-space-sm rounded-lg flex items-center gap-space-sm shadow-sm border border-secondary/30 transition-colors group cursor-pointer\"\n            >\n              <div className=\"w-8 h-8 rounded-lg bg-secondary/10 flex items-center justify-center text-secondary group-hover:scale-105 transition-transform\">\n                <span className=\"material-symbols-outlined text-[20px]\">school</span>\n              </div>\n              <div className=\"flex flex-col\">\n                <div className=\"flex items-center gap-space-xs\">\n                  <span className=\"font-label-sm text-label-sm uppercase font-mono font-bold text-secondary\">\n                    Crash Lab\n                  </span>\n                  <span className=\"px-1.5 py-0.5 rounded bg-primary-container/15 text-primary text-label-sm uppercase font-mono text-[10px] font-bold\">\n                    {academy ? `${academy.xp} XP` : \'0 XP\'}\n                  </span>\n                </div>\n                <div className=\"flex items-baseline gap-space-xs\">\n                  <span className=\"font-headline-sm text-headline-sm font-bold text-on-surface\">\n                    {academy ? academy.level : \'Trainee\'}\n                  </span>\n                  <span className=\"material-symbols-outlined text-secondary text-[16px] group-hover:translate-x-0.5 transition-transform\">\n                    arrow_forward\n                  </span>\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n\n        {/* 4. Quick Actions Core Grid (5 Cards with Top Colored Borders) */}\n        <section className=\"grid grid-cols-1 gap-space-md mb-space-xl sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5\">\n          {/* Card 1: Diagnose Alarm */}\n          <div\n            onClick={() => onNavigate(\'agent\', { openCamera: true })}\n            className=\"group relative bg-surface-container-low hover:bg-surface-container p-space-lg rounded-xl flex flex-col justify-between min-h-[180px] shadow-lg transition-all duration-200 cursor-pointer border border-outline-variant/30\"\n          >\n            <div className=\"absolute top-0 left-0 right-0 h-1 bg-primary-container rounded-t-xl opacity-80 group-hover:opacity-100 transition-opacity\"></div>\n            <div className=\"flex items-start justify-between\">\n              <div className=\"w-14 h-14 rounded-xl bg-surface-container flex items-center justify-center text-primary-container shadow-md group-hover:scale-105 transition-transform\">\n                <span className=\"material-symbols-outlined text-[32px]\">photo_camera</span>\n              </div>\n              <div className=\"w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-primary-container group-hover:bg-primary-container group-hover:text-on-primary-container transition-colors\">\n                <span className=\"material-symbols-outlined text-[20px]\">north_east</span>\n              </div>\n            </div>\n            <div className=\"mt-space-md\">\n              <h2 className=\"font-headline-md text-headline-md font-bold text-on-surface tracking-tight group-hover:text-primary transition-colors\">\n                Diagnose Alarm\n              </h2>\n              <p className=\"font-body-sm text-body-sm text-tertiary mt-1\">\n                Capture terminal photo or paste Fanuc/Haas alarm code for instant physics verification.\n              </p>\n            </div>\n          </div>\n\n          {/* Card 2: Calculate Feeds */}\n          <div\n            onClick={() => onNavigate(\'calculator\')}\n            className=\"group relative bg-surface-container-low hover:bg-surface-container p-space-lg rounded-xl flex flex-col justify-between min-h-[180px] shadow-lg transition-all duration-200 cursor-pointer border border-outline-variant/30\"\n          >\n            <div className=\"absolute top-0 left-0 right-0 h-1 bg-secondary rounded-t-xl opacity-80 group-hover:opacity-100 transition-opacity\"></div>\n            <div className=\"flex items-start justify-between\">\n              <div className=\"w-14 h-14 rounded-xl bg-surface-container flex items-center justify-center text-secondary shadow-md group-hover:scale-105 transition-transform\">\n                <span className=\"material-symbols-outlined text-[32px]\">calculate</span>\n              </div>\n              <div className=\"w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-secondary group-hover:bg-secondary group-hover:text-on-secondary transition-colors\">\n                <span className=\"material-symbols-outlined text-[20px]\">north_east</span>\n              </div>\n            </div>\n            <div className=\"mt-space-md\">\n              <h2 className=\"font-headline-md text-headline-md font-bold text-on-surface tracking-tight group-hover:text-secondary transition-colors\">\n                Calculate Feeds\n              </h2>\n              <p className=\"font-body-sm text-body-sm text-tertiary mt-1\">\n                Optimize spindle RPM, chip load (fz), and cutting power with Kienzle force physics.\n              </p>\n            </div>\n          </div>\n\n          {/* Card 3: Verify G-Code */}\n          <div\n            onClick={() => onNavigate(\'gcode\')}\n            className=\"group relative bg-surface-container-low hover:bg-surface-container p-space-lg rounded-xl flex flex-col justify-between min-h-[180px] shadow-lg transition-all duration-200 cursor-pointer border border-outline-variant/30\"\n          >\n            <div className=\"absolute top-0 left-0 right-0 h-1 bg-secondary-fixed rounded-t-xl opacity-80 group-hover:opacity-100 transition-opacity\"></div>\n            <div className=\"flex items-start justify-between\">\n              <div className=\"w-14 h-14 rounded-xl bg-surface-container flex items-center justify-center text-secondary-fixed shadow-md group-hover:scale-105 transition-transform\">\n                <span className=\"material-symbols-outlined text-[32px]\">terminal</span>\n              </div>\n              <div className=\"w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-secondary-fixed group-hover:bg-secondary-fixed group-hover:text-on-secondary-fixed transition-colors\">\n                <span className=\"material-symbols-outlined text-[20px]\">north_east</span>\n              </div>\n            </div>\n            <div className=\"mt-space-md\">\n              <h2 className=\"font-headline-md text-headline-md font-bold text-on-surface tracking-tight group-hover:text-secondary-fixed transition-colors\">\n                Verify G-Code\n              </h2>\n              <p className=\"font-body-sm text-body-sm text-tertiary mt-1\">\n                Simulate toolpath backplot, inspect modal codes, and catch rapid plunges into raw stock.\n              </p>\n            </div>\n          </div>\n\n          {/* Card 4: Academy Crash Lab */}\n          <div\n            onClick={() => onNavigate(\'academy\')}\n            className=\"group relative bg-surface-container-low hover:bg-surface-container p-space-lg rounded-xl flex flex-col justify-between min-h-[180px] shadow-lg transition-all duration-200 cursor-pointer border border-outline-variant/30\"\n          >\n            <div className=\"absolute top-0 left-0 right-0 h-1 bg-secondary rounded-t-xl opacity-80 group-hover:opacity-100 transition-opacity\"></div>\n            <div className=\"flex items-start justify-between\">\n              <div className=\"flex items-center gap-space-xs\">\n                <div className=\"w-14 h-14 rounded-xl bg-surface-container flex items-center justify-center text-secondary shadow-md group-hover:scale-105 transition-transform\">\n                  <span className=\"material-symbols-outlined text-[32px]\">school</span>\n                </div>\n                <span className=\"px-2 py-0.5 rounded-full bg-secondary/10 text-secondary border border-secondary/30 font-label-sm text-label-sm uppercase font-mono tracking-wider\">\n                  {academy ? academy.level : \'Trainee\'}\n                </span>\n              </div>\n              <div className=\"w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-secondary group-hover:bg-secondary group-hover:text-on-secondary transition-colors\">\n                <span className=\"material-symbols-outlined text-[20px]\">north_east</span>\n              </div>\n            </div>\n            <div className=\"mt-space-md\">\n              <h2 className=\"font-headline-md text-headline-md font-bold text-on-surface tracking-tight group-hover:text-secondary transition-colors\">\n                Crash Lab\n              </h2>\n              <p className=\"font-body-sm text-body-sm text-tertiary mt-1\">\n                Interactive CNC training simulator, physics failure challenges, and shopfloor skill drills.\n              </p>\n            </div>\n          </div>\n\n          {/* Card 5: Knowledge Base (Admins Only) */}\n          {isAdmin && (\n            <div\n              onClick={() => onNavigate(\'kb\')}\n              className=\"group relative bg-surface-container-low hover:bg-surface-container p-space-lg rounded-xl flex flex-col justify-between min-h-[180px] shadow-lg transition-all duration-200 cursor-pointer border border-outline-variant/30\"\n            >\n              <div className=\"absolute top-0 left-0 right-0 h-1 bg-tertiary-fixed rounded-t-xl opacity-80 group-hover:opacity-100 transition-opacity\"></div>\n              <div className=\"flex items-start justify-between\">\n                <div className=\"flex items-center gap-space-xs\">\n                  <div className=\"w-14 h-14 rounded-xl bg-surface-container flex items-center justify-center text-tertiary-fixed shadow-md group-hover:scale-105 transition-transform\">\n                    <span className=\"material-symbols-outlined text-[32px]\">menu_book</span>\n                  </div>\n                  <span className=\"px-2 py-0.5 rounded-full bg-primary-container/15 text-primary border border-primary-container/30 font-label-sm text-label-sm uppercase font-mono tracking-wider\">\n                    ADMIN\n                  </span>\n                </div>\n                <div className=\"w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center text-tertiary group-hover:bg-tertiary group-hover:text-on-tertiary transition-colors\">\n                  <span className=\"material-symbols-outlined text-[20px]\">north_east</span>\n                </div>\n              </div>\n              <div className=\"mt-space-md\">\n                <h2 className=\"font-headline-md text-headline-md font-bold text-on-surface tracking-tight group-hover:text-primary transition-colors\">\n                  Knowledge Base\n                </h2>\n                <p className=\"font-body-sm text-body-sm text-tertiary mt-1\">\n                  Upload OEM controller manuals, tool catalogs, & shop standards for AI retrieval.\n                </p>\n              </div>\n            </div>\n          )}\n        </section>\n\n        {/* 5. Visual Activity Telemetry & Last Screen Snapshot Block */}\n        <section className=\"grid grid-cols-1 lg:grid-cols-2 gap-space-lg mb-space-xl\">\n          {/* Card A: Copilot Activity, last 7 days */}\n          <div className=\"bg-surface-container-low rounded-xl p-space-lg flex flex-col justify-between shadow-xl relative overflow-hidden border border-outline-variant/40\">\n            <div className=\"flex items-center justify-between pb-space-sm\">\n              <div className=\"flex items-center gap-space-sm\">\n                <span className=\"material-symbols-outlined text-secondary text-[24px]\">troubleshoot</span>\n                <span className=\"font-headline-sm text-headline-sm font-bold text-on-surface\">\n                  Copilot Activity, last 7 days\n                </span>\n              </div>\n              <div className=\"flex items-center gap-space-xs\">\n                <span className=\"font-label-sm text-label-sm font-mono text-tertiary\">BUFFER: 7 DAYS</span>\n                <span className=\"w-2 h-2 rounded-full bg-secondary animate-pulse\"></span>\n              </div>\n            </div>\n\n            {/* SVG Area Chart in Cyan Gradient Style */}\n            <div className=\"relative w-full h-48 my-space-sm bg-surface-container-lowest rounded-lg p-space-sm flex items-center justify-center overflow-hidden border border-outline-variant/40\">\n              <svg className=\"w-full h-full text-secondary\" fill=\"none\" preserveAspectRatio=\"none\" viewBox=\"0 0 700 140\">\n                <line stroke=\"currentColor\" strokeDasharray=\"4 4\" strokeOpacity=\"0.08\" x1=\"0\" x2=\"700\" y1=\"35\" y2=\"35\" />\n                <line stroke=\"currentColor\" strokeDasharray=\"4 4\" strokeOpacity=\"0.08\" x1=\"0\" x2=\"700\" y1=\"70\" y2=\"70\" />\n                <line stroke=\"currentColor\" strokeDasharray=\"4 4\" strokeOpacity=\"0.08\" x1=\"0\" x2=\"700\" y1=\"105\" y2=\"105\" />\n                <defs>\n                  <linearGradient id=\"copilotLoadGrad\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n                    <stop offset=\"0%\" stopColor=\"#5de6ff\" stopOpacity=\"0.25\" />\n                    <stop offset=\"100%\" stopColor=\"#5de6ff\" stopOpacity=\"0.0\" />\n                  </linearGradient>\n                  <linearGradient id=\"copilotOverloadGrad\" x1=\"0\" x2=\"1\" y1=\"0\" y2=\"0\">\n                    <stop offset=\"70%\" stopColor=\"#5de6ff\" />\n                    <stop offset=\"90%\" stopColor=\"#ff7a1a\" />\n                    <stop offset=\"100%\" stopColor=\"#ff7a1a\" />\n                  </linearGradient>\n                </defs>\n                <path d={svgAreaPath} fill=\"url(#copilotLoadGrad)\" />\n                <path d={svgLinePath} fill=\"none\" stroke=\"url(#copilotOverloadGrad)\" strokeWidth=\"2.5\" />\n                <circle\n                  className=\"fill-primary-container stroke-surface-container-lowest\"\n                  cx=\"700\"\n                  cy=\"35\"\n                  r=\"4\"\n                  strokeWidth=\"2\"\n                />\n              </svg>\n\n              <div className=\"absolute top-3 left-4 flex items-center gap-space-sm bg-surface-container/80 backdrop-blur px-2.5 py-1 rounded\">\n                <span className=\"font-label-sm text-label-sm font-mono text-tertiary\">ACTIVITY TODAY:</span>\n                <span className=\"font-code-sm text-code-sm font-bold text-secondary\">{currentDayVal} OPS</span>\n              </div>\n\n              <div className=\"absolute top-3 right-4 flex items-center gap-space-xs bg-surface-container/90 backdrop-blur px-2.5 py-1 rounded border border-primary-container/30\">\n                <span className=\"material-symbols-outlined text-[14px] text-primary-container\">insights</span>\n                <span className=\"font-label-sm text-label-sm font-mono text-primary-container font-bold\">\n                  PEAK: {maxVal} OPS/DAY\n                </span>\n              </div>\n            </div>\n\n            {/* 4 Readouts Below: Real Data, Never Invented */}\n            <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-space-sm pt-space-xs\">\n              <div className=\"bg-surface-container p-space-sm rounded\">\n                <span className=\"font-label-sm text-label-sm text-tertiary uppercase block\">Total Chats</span>\n                <span className=\"font-code-md text-code-md font-bold text-on-surface\">\n                  {totalChats} <span className=\"font-label-sm text-label-sm font-normal text-tertiary\">msgs</span>\n                </span>\n              </div>\n              <div className=\"bg-surface-container p-space-sm rounded\">\n                <span className=\"font-label-sm text-label-sm text-tertiary uppercase block\">Calculations</span>\n                <span className=\"font-code-md text-code-md font-bold text-on-surface\">\n                  {totalCalcs} <span className=\"font-label-sm text-label-sm font-normal text-tertiary\">runs</span>\n                </span>\n              </div>\n              <div className=\"bg-surface-container p-space-sm rounded\">\n                <span className=\"font-label-sm text-label-sm text-tertiary uppercase block\">Programs Verified</span>\n                <span className=\"font-code-md text-code-md font-bold text-on-surface\">\n                  {totalVerified} <span className=\"font-label-sm text-label-sm font-normal text-tertiary\">audited</span>\n                </span>\n              </div>\n              <div className=\"bg-surface-container p-space-sm rounded\">\n                <span className=\"font-label-sm text-label-sm text-secondary uppercase block font-bold\">\n                  Crashes Avoided\n                </span>\n                <span className=\"font-code-md text-code-md font-bold text-secondary\">\n                  {crashesAvoided} <span className=\"font-label-sm text-label-sm font-normal text-tertiary\">passed</span>\n                </span>\n              </div>\n            </div>\n          </div>\n\n          {/* Card B: Last Screen Snapshot (Real image or designed empty state) */}\n          <div className=\"bg-surface-container-low rounded-xl p-space-lg flex flex-col justify-between shadow-xl border border-outline-variant/40\">\n            <div className=\"flex items-center justify-between pb-space-sm\">\n              <div className=\"flex items-center gap-space-xs\">\n                <span className=\"material-symbols-outlined text-secondary text-[24px]\">videocam</span>\n                <span className=\"font-headline-sm text-headline-sm font-bold text-on-surface\">\n                  Last screen snapshot\n                </span>\n              </div>\n              <div className=\"flex items-center gap-space-xs\">\n                <span className=\"w-2 h-2 rounded-full bg-secondary animate-pulse\"></span>\n                <span className=\"px-space-xs py-0.5 rounded bg-surface-container text-secondary font-label-sm text-label-sm font-mono uppercase\">\n                  {lastSnapshot ? \'CAPTURED SNAPSHOT\' : \'STANDBY\'}\n                </span>\n              </div>\n            </div>\n\n            {/* Frame Viewport */}\n            <div className=\"relative w-full h-48 my-space-sm rounded-lg overflow-hidden bg-surface-container-lowest border border-outline-variant/40 flex items-center justify-center\">\n              {lastSnapshot ? (\n                <>\n                  <img\n                    className=\"w-full h-full object-cover\"\n                    alt=\"Latest CNC Controller Snapshot\"\n                    src={lastSnapshot.url}\n                  />\n                  <div className=\"absolute inset-0 bg-gradient-to-t from-surface-container-lowest/90 via-transparent to-transparent\"></div>\n                  <div className=\"absolute bottom-2 left-3 right-3 flex items-center justify-between\">\n                    <span className=\"font-label-sm text-label-sm font-mono text-on-surface font-semibold bg-surface-container-lowest/80 px-2 py-0.5 rounded truncate max-w-[280px]\">\n                      {lastSnapshot.caption || \'CNC PENDANT CAPTURE\'}\n                    </span>\n                    <button\n                      onClick={() => onNavigate(\'agent\')}\n                      className=\"font-code-sm text-code-sm text-secondary font-mono hover:underline flex items-center gap-1 cursor-pointer\"\n                    >\n                      <span>Diagnose</span>\n                      <span className=\"material-symbols-outlined text-[14px]\">open_in_new</span>\n                    </button>\n                  </div>\n                </>\n              ) : (\n                /* Designed Empty State */\n                <div className=\"flex flex-col items-center justify-center p-6 text-center gap-2\">\n                  <div className=\"w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-tertiary mb-1\">\n                    <span className=\"material-symbols-outlined text-[28px]\">photo_camera</span>\n                  </div>\n                  <p className=\"font-body-sm text-body-sm text-on-surface font-medium\">\n                    Snap a controller screen in the Agent to diagnose it.\n                  </p>\n                  <p className=\"font-label-sm text-label-sm text-tertiary\">\n                    Captures alarms, parameters, and servo loads directly from the pendant.\n                  </p>\n                  <button\n                    onClick={() => onNavigate(\'agent\', { openCamera: true })}\n                    className=\"mt-2 h-9 px-space-md rounded-lg bg-surface-container-high hover:bg-surface-container hover:text-secondary text-on-surface transition-colors font-mono text-xs flex items-center gap-1.5 border border-outline-variant/40 cursor-pointer\"\n                    type=\"button\"\n                  >\n                    <span className=\"material-symbols-outlined text-[16px] text-primary-container\">camera</span>\n                    <span>Open Agent Camera</span>\n                  </button>\n                </div>\n              )}\n            </div>\n\n            <div className=\"grid grid-cols-2 gap-space-sm pt-space-xs\">\n              <div className=\"bg-surface-container p-space-sm rounded\">\n                <span className=\"font-label-sm text-label-sm text-tertiary uppercase block\">Active Workpiece</span>\n                <span className=\"font-headline-sm text-headline-sm font-bold text-on-surface truncate block\">\n                  {profile?.preferredController ? `${preferredControllerName} Setup` : \'Standard Workpiece\'}\n                </span>\n              </div>\n              <div className=\"bg-surface-container p-space-sm rounded\">\n                <span className=\"font-label-sm text-label-sm text-tertiary uppercase block\">Diagnostics Run</span>\n                <div className=\"flex items-baseline justify-between\">\n                  <span className=\"font-code-md text-code-md font-bold text-secondary font-mono\">\n                    {totalChats} Total\n                  </span>\n                  <span className=\"font-label-sm text-label-sm font-mono text-tertiary\">LOGGED</span>\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n\n        {/* 6. Recent Activity & Shop Logs (Filtered by Tabs) */}\n        <section className=\"bg-surface-container-low rounded-xl p-space-lg shadow-xl mb-space-xl border border-outline-variant/40\">\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-space-md pb-space-md\">\n            <div className=\"flex items-center gap-space-sm\">\n              <span className=\"material-symbols-outlined text-secondary text-[24px]\">history</span>\n              <h3 className=\"font-headline-md text-headline-md font-bold text-on-surface tracking-tight\">\n                Recent Activity & Shop Logs\n              </h3>\n            </div>\n\n            {/* Filter Tabs matching HTML */}\n            <div className=\"flex items-center gap-space-xs bg-surface-container p-1 rounded-lg self-start sm:self-auto overflow-x-auto max-w-full border border-outline-variant/30\">\n              <button\n                onClick={() => setActiveTab(\'all\')}\n                className={`px-space-md py-1.5 rounded-md font-label-sm text-label-sm font-mono font-semibold transition-colors whitespace-nowrap cursor-pointer ${\n                  activeTab === \'all\'\n                    ? \'bg-surface-container-high text-on-surface shadow-sm\'\n                    : \'text-tertiary hover:text-on-surface\'\n                }`}\n                type=\"button\"\n              >\n                All ({activities.length})\n              </button>\n              <button\n                onClick={() => setActiveTab(\'calc\')}\n                className={`px-space-md py-1.5 rounded-md font-label-sm text-label-sm font-mono whitespace-nowrap transition-colors cursor-pointer ${\n                  activeTab === \'calc\'\n                    ? \'bg-surface-container-high text-on-surface shadow-sm\'\n                    : \'text-tertiary hover:text-on-surface\'\n                }`}\n                type=\"button\"\n              >\n                Calculations\n              </button>\n              <button\n                onClick={() => setActiveTab(\'alarm\')}\n                className={`px-space-md py-1.5 rounded-md font-label-sm text-label-sm font-mono whitespace-nowrap transition-colors cursor-pointer ${\n                  activeTab === \'alarm\'\n                    ? \'bg-surface-container-high text-on-surface shadow-sm\'\n                    : \'text-tertiary hover:text-on-surface\'\n                }`}\n                type=\"button\"\n              >\n                Alarms\n              </button>\n              <button\n                onClick={() => setActiveTab(\'gcode\')}\n                className={`px-space-md py-1.5 rounded-md font-label-sm text-label-sm font-mono whitespace-nowrap transition-colors cursor-pointer ${\n                  activeTab === \'gcode\'\n                    ? \'bg-surface-container-high text-on-surface shadow-sm\'\n                    : \'text-tertiary hover:text-on-surface\'\n                }`}\n                type=\"button\"\n              >\n                Simulations\n              </button>\n            </div>\n          </div>\n\n          {/* Activity Item Rows */}\n          <div className=\"flex flex-col\">\n            {filteredActivities.length === 0 ? (\n              <div className=\"py-12 px-4 text-center flex flex-col items-center justify-center gap-2 text-tertiary\">\n                <span className=\"material-symbols-outlined text-[36px] text-tertiary-container\">folder_open</span>\n                <p className=\"font-body-md text-body-md text-on-surface font-medium\">No activity yet in this filter.</p>\n                <p className=\"font-body-sm text-body-sm\">\n                  Start with a quick action above to compute speeds, diagnose an alarm, or verify G-code.\n                </p>\n              </div>\n            ) : (\n              filteredActivities.map((item) => (\n                <div\n                  key={item.id}\n                  className=\"py-space-md flex flex-col md:flex-row md:items-center justify-between gap-space-md bg-surface-container/30 hover:bg-surface-container/60 px-space-md rounded-lg my-1 transition-colors border border-outline-variant/20\"\n                >\n                  <div className=\"flex items-center gap-space-md min-w-0\">\n                    <div\n                      className={`w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center flex-shrink-0 ${\n                        item.type === \'calc\'\n                          ? \'text-secondary\'\n                          : item.type === \'chat\'\n                          ? \'text-primary-container\'\n                          : item.type === \'gcode\'\n                          ? \'text-secondary-container\'\n                          : \'text-primary\'\n                      }`}\n                    >\n                      <span className=\"material-symbols-outlined text-[24px]\">\n                        {item.type === \'calc\' && \'engineering\'}\n                        {item.type === \'chat\' && \'crisis_alert\'}\n                        {item.type === \'gcode\' && \'check_circle\'}\n                        {item.type === \'academy\' && \'school\'}\n                      </span>\n                    </div>\n                    <div className=\"flex flex-col min-w-0\">\n                      <div className=\"flex items-center gap-space-xs flex-wrap\">\n                        <span className=\"font-headline-sm text-headline-sm font-bold text-on-surface truncate\">\n                          {item.title}\n                        </span>\n                        {item.alarm && (\n                          <span className=\"px-space-xs py-0.5 rounded bg-surface-container-high text-primary font-label-sm text-label-sm font-mono uppercase\">\n                            ALARM {item.alarm}\n                          </span>\n                        )}\n                      </div>\n                      <span className=\"font-code-sm text-code-sm text-tertiary truncate mt-0.5\">\n                        {getRelativeTime(item.createdAt)} \342\200\242{\' \'}\n                        <span className=\"text-secondary font-medium\">{item.summary || \'Completed operation\'}</span>\n                      </span>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-space-sm flex-shrink-0 self-end md:self-auto\">\n                    {item.type === \'calc\' && (\n                      <button\n                        onClick={() => onNavigate(\'calculator\')}\n                        className=\"h-10 px-space-md rounded-lg bg-primary-container/15 text-primary hover:bg-primary-container/25 transition-colors font-code-sm text-code-sm font-semibold flex items-center gap-space-xs cursor-pointer\"\n                        type=\"button\"\n                      >\n                        <span>Resume</span>\n                        <span className=\"material-symbols-outlined text-[16px]\">arrow_forward</span>\n                      </button>\n                    )}\n                    {item.type === \'chat\' && (\n                      <button\n                        onClick={() => onNavigate(\'agent\', { chatId: item.link })}\n                        className=\"h-10 px-space-md rounded-lg bg-surface-container-high text-tertiary hover:text-on-surface hover:bg-surface-variant transition-colors font-code-sm text-code-sm font-semibold flex items-center gap-space-xs cursor-pointer\"\n                        type=\"button\"\n                      >\n                        <span>View Diagnosis</span>\n                        <span className=\"material-symbols-outlined text-[16px]\">open_in_new</span>\n                      </button>\n                    )}\n                    {item.type === \'gcode\' && (\n                      <button\n                        onClick={() => onNavigate(\'gcode\')}\n                        className=\"h-10 px-space-md rounded-lg bg-secondary/10 text-secondary hover:bg-secondary/20 transition-colors font-code-sm text-code-sm font-semibold flex items-center gap-space-xs cursor-pointer\"\n                        type=\"button\"\n                      >\n                        <span>Open Verifier</span>\n                        <span className=\"material-symbols-outlin"
