  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useEffect, useState } from \'react\';\nimport { useAuth } from \'../context/AuthContext.js\';\nimport {\n  Camera,\n  Calculator,\n  FileCode,\n  GraduationCap,\n  ArrowUpRight,\n  AlertTriangle,\n  BookOpen,\n  Clock,\n  ExternalLink,\n  RotateCcw,\n  RefreshCw,\n  FolderOpen,\n} from \'lucide-react\';\nimport { collection, query, where, orderBy, limit, onSnapshot, doc } from \'firebase/firestore\';\nimport { db } from \'../lib/firebase.js\';\n\ninterface DashboardProps {\n  onNavigate: (tab: string, state?: any) => void;\n}\n\ninterface ActivityItem {\n  id: string;\n  type: \'chat\' | \'calc\' | \'gcode\' | \'academy\';\n  title: string;\n  summary?: string;\n  link?: string;\n  createdAt?: string;\n}\n\ninterface ManualItem {\n  id: string;\n  name: string;\n  controller: string;\n  docType: string;\n  pages?: number;\n  status: string;\n}\n\ninterface AcademyProgress {\n  xp: number;\n  level: string;\n  streakDays: number;\n}\n\nexport function Dashboard({ onNavigate }: DashboardProps) {\n  const { user, profile } = useAuth();\n  const [activities, setActivities] = useState<ActivityItem[]>([]);\n  const [manuals, setManuals] = useState<ManualItem[]>([]);\n  const [academy, setAcademy] = useState<AcademyProgress | null>(null);\n  const [loading, setLoading] = useState(true);\n\n  // Time & shift computation\n  const now = new Date();\n  const hour = now.getHours();\n\n  let greeting = \'Good morning\';\n  if (hour >= 12 && hour < 17) greeting = \'Good afternoon\';\n  if (hour >= 17 || hour < 4) greeting = \'Good evening\';\n\n  let shiftName = \'Shift 1 (06:00 - 14:00)\';\n  if (hour >= 14 && hour < 22) shiftName = \'Shift 2 (14:00 - 22:00)\';\n  if (hour >= 22 || hour < 6) shiftName = \'Shift 3 (22:00 - 06:00)\';\n\n  const dateFormatted = now.toLocaleDateString(undefined, {\n    weekday: \'long\',\n    day: \'numeric\',\n    month: \'short\',\n    year: \'numeric\',\n  });\n\n  const firstName = (profile?.displayName || user?.displayName || \'Operator\').split(\' \')[0];\n\n  // Fetch real data from Firestore\n  useEffect(() => {\n    if (!user) return;\n\n    // 1. Listen to recent activity\n    const activityQuery = query(\n      collection(db, \'users\', user.uid, \'activity\'),\n      orderBy(\'createdAt\', \'desc\'),\n      limit(5)\n    );\n\n    const unsubActivity = onSnapshot(\n      activityQuery,\n      (snap) => {\n        const list: ActivityItem[] = snap.docs.map((d) => ({\n          id: d.id,\n          ...(d.data() as any),\n        }));\n        setActivities(list);\n      },\n      (err) => console.warn(\'[Dashboard] Activity listener warning:\', err)\n    );\n\n    // 2. Listen to ready manuals from kb_docs\n    const manualsQuery = query(\n      collection(db, \'kb_docs\'),\n      where(\'status\', \'==\', \'Ready\'),\n      limit(8)\n    );\n\n    const unsubManuals = onSnapshot(\n      manualsQuery,\n      (snap) => {\n        const list: ManualItem[] = snap.docs.map((d) => ({\n          id: d.id,\n          ...(d.data() as any),\n        }));\n        setManuals(list);\n        setLoading(false);\n      },\n      (err) => {\n        console.warn(\'[Dashboard] Manuals listener warning:\', err);\n        setLoading(false);\n      }\n    );\n\n    // 3. Listen to academy progress\n    const unsubAcademy = onSnapshot(\n      doc(db, \'users\', user.uid, \'academy\', \'progress\'),\n      (snap) => {\n        if (snap.exists()) {\n          setAcademy(snap.data() as AcademyProgress);\n        }\n      },\n      (err) => console.warn(\'[Dashboard] Academy progress warning:\', err)\n    );\n\n    return () => {\n      unsubActivity();\n      unsubManuals();\n      unsubAcademy();\n    };\n  }, [user]);\n\n  // Check for resume banner: latest activity is a chat less than 24h old\n  const latestActivity = activities[0];\n  const isRecentChat =\n    latestActivity &&\n    latestActivity.type === \'chat\' &&\n    latestActivity.createdAt &&\n    now.getTime() - new Date(latestActivity.createdAt).getTime() < 24 * 60 * 60 * 1000;\n\n  // Format relative time\n  const getRelativeTime = (iso?: string) => {\n    if (!iso) return \'Recently\';\n    const diffMs = now.getTime() - new Date(iso).getTime();\n    const diffMins = Math.floor(diffMs / (60 * 1000));\n    if (diffMins < 1) return \'Just now\';\n    if (diffMins < 60) return `${diffMins}m ago`;\n    const diffHours = Math.floor(diffMins / 60);\n    if (diffHours < 24) return `${diffHours}h ago`;\n    return `${Math.floor(diffHours / 24)}d ago`;\n  };\n\n  return (\n    <div className=\"flex flex-col w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 gap-8\">\n      {/* Header Banner */}\n      <div className=\"flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-4 border-b border-[#1F2A37]\">\n        <div className=\"flex flex-col\">\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"w-2 h-2 rounded-full bg-[#22C55E] animate-pulse\"></span>\n            <span className=\"text-xs font-mono text-[#22D3EE] uppercase tracking-wider\">\n              Controller: {(profile?.preferredController || \'fanuc\').toUpperCase()}\n            </span>\n          </div>\n          <h1 className=\"text-2xl sm:text-3xl font-bold text-white tracking-tight\">\n            {greeting}, {firstName}\n          </h1>\n          <p className=\"text-xs sm:text-sm font-mono text-[#8B98A5] mt-1\">\n            {dateFormatted} <span className=\"text-[#1F2A37] mx-1\">|</span> {shiftName}\n          </p>\n        </div>\n\n        {/* Quick Controller Indicator */}\n        <div className=\"flex items-center gap-2 font-mono text-xs\">\n          <div className=\"px-3 py-1.5 rounded-lg bg-white/5 border border-[#1F2A37] text-[#8B98A5] flex items-center gap-2\">\n            <Clock className=\"w-3.5 h-3.5 text-[#22D3EE]\" />\n            <span>Shift Active</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Amber Resume Banner (only if latest activity is a chat < 24h old) */}\n      {isRecentChat && (\n        <div className=\"p-4 rounded-xl bg-[#F59E0B]/10 border border-[#F59E0B]/40 flex items-center justify-between gap-4 transition-all\">\n          <div className=\"flex items-center gap-3 min-w-0\">\n            <div className=\"w-9 h-9 rounded-lg bg-[#F59E0B]/20 flex items-center justify-center text-[#F59E0B] flex-shrink-0\">\n              <AlertTriangle className=\"w-5 h-5\" />\n            </div>\n            <div className=\"flex flex-col min-w-0\">\n              <span className=\"text-xs font-mono font-semibold text-[#F59E0B] uppercase\">Unresolved Diagnosis</span>\n              <p className=\"text-sm font-medium text-white truncate\">\n                Last diagnosis: <strong className=\"text-[#E6EDF3]\">{latestActivity.title}</strong>\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={() => onNavigate(\'agent\', { chatId: latestActivity.link })}\n            className=\"touch-target px-4 py-2 rounded-lg bg-[#F59E0B] hover:bg-[#D97706] text-[#0B0F14] font-bold text-xs font-mono flex items-center gap-1.5 flex-shrink-0 transition-colors\"\n          >\n            <span>Continue</span>\n            <ArrowUpRight className=\"w-4 h-4\" />\n          </button>\n        </div>\n      )}\n\n      {/* Quick Actions: 4 Large Glass Cards (min-h 140px) */}\n      <div>\n        <h2 className=\"text-xs font-mono uppercase tracking-wider text-[#8B98A5] mb-3\">Operator Quick Actions</h2>\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n          {/* Card 1: Diagnose Alarm */}\n          <button\n            onClick={() => onNavigate(\'agent\', { openCamera: true })}\n            aria-label=\"Diagnose Alarm\"\n            className=\"glass-panel p-5 min-h-[140px] flex flex-col justify-between text-left group hover:border-[#FF7A1A]/50 transition-all touch-target\"\n          >\n            <div className=\"flex items-start justify-between\">\n              <div className=\"w-12 h-12 rounded-xl bg-[#FF7A1A]/10 border border-[#FF7A1A]/30 flex items-center justify-center text-[#FF7A1A] group-hover:scale-105 transition-transform\">\n                <Camera className=\"w-6 h-6\" />\n              </div>\n              <ArrowUpRight className=\"w-5 h-5 text-[#8B98A5] group-hover:text-[#FF7A1A] transition-colors\" />\n            </div>\n            <div className=\"mt-4\">\n              <h3 className=\"font-bold text-base text-white group-hover:text-[#FF7A1A] transition-colors\">\n                Diagnose Alarm\n              </h3>\n              <p className=\"text-xs text-[#8B98A5] mt-0.5\">Snap control screen or ask in your language</p>\n            </div>\n          </button>\n\n          {/* Card 2: Calculate Feeds */}\n          <button\n            onClick={() => onNavigate(\'calculator\')}\n            aria-label=\"Calculate Feeds\"\n            className=\"glass-panel p-5 min-h-[140px] flex flex-col justify-between text-left group hover:border-[#22D3EE]/50 transition-all touch-target\"\n          >\n            <div className=\"flex items-start justify-between\">\n              <div className=\"w-12 h-12 rounded-xl bg-[#22D3EE]/10 border border-[#22D3EE]/30 flex items-center justify-center text-[#22D3EE] group-hover:scale-105 transition-transform\">\n                <Calculator className=\"w-6 h-6\" />\n              </div>\n              <ArrowUpRight className=\"w-5 h-5 text-[#8B98A5] group-hover:text-[#22D3EE] transition-colors\" />\n            </div>\n            <div className=\"mt-4\">\n              <h3 className=\"font-bold text-base text-white group-hover:text-[#22D3EE] transition-colors\">\n                Calculate Feeds\n              </h3>\n              <p className=\"text-xs text-[#8B98A5] mt-0.5\">Kienzle force, RPM, MRR and power check</p>\n            </div>\n          </button>\n\n          {/* Card 3: Verify G-code */}\n          <button\n            onClick={() => onNavigate(\'gcode\')}\n            aria-label=\"Verify G-code\"\n            className=\"glass-panel p-5 min-h-[140px] flex flex-col justify-between text-left group hover:border-[#22C55E]/50 transition-all touch-target\"\n          >\n            <div className=\"flex items-start justify-between\">\n              <div className=\"w-12 h-12 rounded-xl bg-[#22C55E]/10 border border-[#22C55E]/30 flex items-center justify-center text-[#22C55E] group-hover:scale-105 transition-transform\">\n                <FileCode className=\"w-6 h-6\" />\n              </div>\n              <ArrowUpRight className=\"w-5 h-5 text-[#8B98A5] group-hover:text-[#22C55E] transition-colors\" />\n            </div>\n            <div className=\"mt-4\">\n              <h3 className=\"font-bold text-base text-white group-hover:text-[#22C55E] transition-colors\">\n                Verify G-code\n              </h3>\n              <p className=\"text-xs text-[#8B98A5] mt-0.5\">Parse motion blocks and 3D backplot check</p>\n            </div>\n          </button>\n\n          {/* Card 4: Crash Lab */}\n          <button\n            onClick={() => onNavigate(\'academy\')}\n            aria-label=\"Crash Lab\"\n            className=\"glass-panel p-5 min-h-[140px] flex flex-col justify-between text-left group hover:border-[#F59E0B]/50 transition-all touch-target\"\n          >\n            <div className=\"flex items-start justify-between\">\n              <div className=\"w-12 h-12 rounded-xl bg-[#F59E0B]/10 border border-[#F59E0B]/30 flex items-center justify-center text-[#F59E0B] group-hover:scale-105 transition-transform\">\n                <GraduationCap className=\"w-6 h-6\" />\n              </div>\n              <div className=\"text-right\">\n                <span className=\"text-[10px] font-mono px-2 py-0.5 rounded bg-[#F59E0B]/20 text-[#F59E0B] font-bold\">\n                  {academy ? academy.level : \'Trainee\'}\n                </span>\n              </div>\n            </div>\n            <div className=\"mt-4\">\n              <div className=\"flex items-center justify-between\">\n                <h3 className=\"font-bold text-base text-white group-hover:text-[#F59E0B] transition-colors\">\n                  Crash Lab\n                </h3>\n                <span className=\"text-xs font-mono text-[#F59E0B] font-bold\">\n                  {academy ? `${academy.xp} XP` : \'0 XP\'}\n                </span>\n              </div>\n              <p className=\"text-xs text-[#8B98A5] mt-0.5\">Simulate shop floor errors and earn badges</p>\n            </div>\n          </button>\n        </div>\n      </div>\n\n      {/* Two-Column Grid: Recent Activity (left) + Grounded Manuals (right) */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8\">\n        {/* Recent Activity: Latest 5 (lg:col-span-7) */}\n        <div className=\"lg:col-span-7 flex flex-col gap-4\">\n          <div className=\"flex items-center justify-between\">\n            <h2 className=\"text-xs font-mono uppercase tracking-wider text-[#8B98A5]\">Recent Activity (Latest 5)</h2>\n            <span className=\"text-xs font-mono text-[#22D3EE]\">{activities.length} Recorded</span>\n          </div>\n\n          <div className=\"glass-panel overflow-hidden p-2\">\n            {activities.length === 0 ? (\n              <div className=\"p-8 text-center flex flex-col items-center justify-center gap-2 text-[#8B98A5]\">\n                <FolderOpen className=\"w-8 h-8 text-[#1F2A37]\" />\n                <p className=\"text-sm font-medium text-[#E6EDF3]\">No activity yet.</p>\n                <p className=\"text-xs\">Start with a quick action above to log diagnoses, cuts, or G-code audits.</p>\n              </div>\n            ) : (\n              <div className=\"divide-y divide-[#1F2A37]/60\">\n                {activities.map((item) => (\n                  <div\n                    key={item.id}\n                    className=\"p-3.5 hover:bg-white/5 rounded-lg flex items-center justify-between gap-3 transition-colors\"\n                  >\n                    <div className=\"flex items-center gap-3 min-w-0\">\n                      <div className=\"w-8 h-8 rounded-lg bg-white/5 border border-[#1F2A37] flex items-center justify-center flex-shrink-0 text-xs\">\n                        {item.type === \'chat\' && <Camera className=\"w-4 h-4 text-[#FF7A1A]\" />}\n                        {item.type === \'calc\' && <Calculator className=\"w-4 h-4 text-[#22D3EE]\" />}\n                        {item.type === \'gcode\' && <FileCode className=\"w-4 h-4 text-[#22C55E]\" />}\n                        {item.type === \'academy\' && <GraduationCap className=\"w-4 h-4 text-[#F59E0B]\" />}\n                      </div>\n                      <div className=\"flex flex-col min-w-0\">\n                        <span className=\"text-sm font-medium text-white truncate\">{item.title}</span>\n                        {item.summary && (\n                          <span className=\"text-xs text-[#8B98A5] truncate\">{item.summary}</span>\n                        )}\n                      </div>\n                    </div>\n\n                    <div className=\"flex items-center gap-3 flex-shrink-0\">\n                      <span className=\"text-[11px] font-mono text-[#8B98A5]\">\n                        {getRelativeTime(item.createdAt)}\n                      </span>\n                      {item.link && (\n                        <button\n                          onClick={() => {\n                            if (item.type === \'chat\') onNavigate(\'agent\', { chatId: item.link });\n                            else if (item.type === \'calc\') onNavigate(\'calculator\');\n                            else if (item.type === \'gcode\') onNavigate(\'gcode\');\n                            else if (item.type === \'academy\') onNavigate(\'academy\');\n                          }}\n                          className=\"px-2.5 py-1 rounded-md bg-white/5 hover:bg-[#FF7A1A]/10 text-xs font-mono text-[#FF7A1A] border border-[#1F2A37] hover:border-[#FF7A1A]/40 transition-colors\"\n                        >\n                          Resume\n                        </button>\n                      )}\n                    </div>\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* Ready OEM Manuals: kb_docs where status = \'Ready\' (lg:col-span-5) */}\n        <div className=\"lg:col-span-5 flex flex-col gap-4\">\n          <div className=\"flex items-center justify-between\">\n            <h2 className=\"text-xs font-mono uppercase tracking-wider text-[#8B98A5]\">Grounded Manuals</h2>\n            <span className=\"text-xs font-mono text-[#22C55E]\">{manuals.length} Ready</span>\n          </div>\n\n          <div className=\"glass-panel p-3\">\n            {manuals.length === 0 ? (\n              <div className=\"p-8 text-center flex flex-col items-center justify-center gap-2 text-[#8B98A5]\">\n                <BookOpen className=\"w-8 h-8 text-[#1F2A37]\" />\n                <p className=\"text-sm font-medium text-[#E6EDF3]\">No manuals uploaded yet.</p>\n                <p className=\"text-xs\">\n                  {profile?.role === \'admin\'\n                    ? \'Use Knowledge Base to upload controller manuals and shop sheets.\'\n                    : \'Your shop administrator will upload controller manuals for AI retrieval.\'}\n                </p>\n              </div>\n            ) : (\n              <div className=\"grid grid-cols-1 gap-2.5\">\n                {manuals.map((doc) => (\n                  <div\n                    key={doc.id}\n                    className=\"p-3 rounded-lg bg-white/5 border border-[#1F2A37] flex items-center justify-between gap-3 hover:border-[#22D3EE]/30 transition-colors\"\n                  >\n                    <div className=\"flex items-center gap-2.5 min-w-0\">\n                      <div className=\"w-8 h-8 rounded bg-[#22D3EE]/10 text-[#22D3EE] flex items-center justify-center flex-shrink-0\">\n                        <BookOpen className=\"w-4 h-4\" />\n                      </div>\n                      <div className=\"flex flex-col min-w-0\">\n                        <span className=\"text-xs font-semibold text-white truncate\">{doc.name}</span>\n                        <div className=\"flex items-center gap-2 text-[10px] font-mono text-[#8B98A5] mt-0.5\">\n                          <span className=\"px-1 py-0.2 rounded bg-white/5\">{doc.controller}</span>\n                          <span>\342\200\242</span>\n                          <span>{doc.docType}</span>\n                        </div>\n                      </div>\n                    </div>\n                    {doc.pages && (\n                      <span className=\"text-[11px] font-mono text-[#22D3EE] flex-shrink-0\">\n                        {doc.pages} p.\n                      </span>\n                    )}\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
