    proposed_command_line: "sleep 2 && curl -s -X POST http://127.0.0.1:3000/api/agent/chat \\\n  -H \"Content-Type: application/json\" \\\n  -d \'{\"message\":\"Fanuc 1004 SPINDLE OVERHEAT\",\"controller\":\"Fanuc 0i-MF\"}\'"
