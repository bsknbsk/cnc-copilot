      id: "call_896891"
      name: "run_command"
      arguments_json: "{\"CommandLine\":\"npx tsx -e \\\"import { GoogleAuth } from \'google-auth-library\'; const auth = new GoogleAuth(); auth.getCredentials().then(c => console.log(\'client_email:\', c.client_email)).catch(e => console.log(\'err:\', e));\\\"\",\"Cwd\":\"/\",\"WaitMsBeforeAsync\":5000,\"toolAction\":\"Checking service account identity\",\"toolSummary\":\"Check GoogleAuth identity\"}"
