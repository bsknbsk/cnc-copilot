nge={(e) => setUploadState({ ...uploadState, pages: parseInt(e.target.value) || 1 })}                    className=\"px-3 py-2 rounded-lg bg-surface-container-lowest border border-outline-variant/30 text-on-surface font-body-sm text-sm focus:outline-none focus:border-secondary\"                  />                </div>              </div>              <div className=\"p-3 rounded-lg bg-surface-container-low border border-dashed border-outline-variant/40 text-center flex flex-col items-center justify-center gap-1 cursor-pointer\">                <span className=\"material-symbols-outlined text-[24px] text-tertiary\">attach_file</span>                <span className=\"font-mono text-xs text-secondary\">Select PDF / STEP / CSV Technical File</span>                <span className=\"font-mono text-[10px] text-tertiary-container\">OCR and tabular vectorization enabled</span>              </div>              <div className=\"flex items-center justify-end gap-2 pt-2 border-t border-surface-container-high mt-1\">                <button                  type=\"button\"                  onClick={() => setUploadModalOpen(false)}                  className=\"px-4 py-2 rounded-lg bg-surface-container-high text-xs font-mono text-tertiary hover:text-on-surface\"                >                  Cancel                </button>                <button                  type=\"submit\"                  disabled={isUploading}                  className=\"px-4 py-2 rounded-lg bg-primary-container text-surface-container-lowest font-headline-sm text-xs font-bold flex items-center gap-1 hover:bg-[#e56910]\"                >                  <span className=\"material-symbols-outlined text-[16px]\">cloud_upload</span>                  <span>{isUploading ? \'Vectorizing...\' : \'Index Document\'}</span>                </button>              </div>            </form>          </div>        </div>      )}    </div>  );}"
