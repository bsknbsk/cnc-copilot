Controller(\'fanuc\')}\n                className={`px-2.5 py-1 rounded-[6px] transition-all cursor-pointer ${\n                  controller === \'fanuc\'\n                    ? \'bg-secondary-fixed text-on-secondary font-bold shadow-sm\'\n                    : \'text-tertiary hover:text-on-surface\'\n                }`}\n              >\n                Fanuc 0i\n              </button>\n              <button\n                onClick={() => setController(\'mitsubishi\')}\n                className={`px-2.5 py-1 rounded-[6px] transition-all cursor-pointer ${\n                  controller === \'mitsubishi\'\n                    ? \'bg-secondary-fixed text-on-secondary font-bold shadow-sm\'\n                    : \'text-tertiary hover:text-on-surface\'\n                }`}\n              >\n                M80\n              </button>\n              <button\n                onClick={() => setController(\'generic\')}\n                className={`px-2.5 py-1 rounded-[6px] transition-all cursor-pointer ${\n                  controller === \'generic\'\n                    ? \'bg-secondary-fixed text-on-secondary font-bold shadow-sm\'\n                    : \'text-tertiary hover:text-on-surface\'\n                }`}\n              >\n                Generic ISO\n              </button>\n            </div>\n\n            {/* Hidden File Input */}\n            <label className=\"h-9 px-3 rounded-lg bg-surface-container hover:bg-surface-container-high border border-outline-variant/40 text-xs font-mono text-on-surface flex items-center gap-1.5 cursor-pointer transition-colors\">\n              <span className=\"material-symbols-outlined text-[16px] text-tertiary\">upload_file</span>\n              Upload .NC\n              <input\n                type=\"file\"\n                accept=\".nc,.tap,.eia,.gcode,.txt\"\n                onChange={handleFileUpload}\n                className=\"hidden\"\n              />\n            </label>\n\n            {/* Verify Button */}\n    