            }
            lines {
              text: "    "
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // We should ideally track this per step, but for Academy missions,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // the faults are simple."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    // Let\'s analyze the code to see if G43, M03, M29 are present *before* or *on* the line."
