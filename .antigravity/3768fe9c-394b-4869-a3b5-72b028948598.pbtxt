  view_file {
    absolute_path_uri: "file:///src/components/ShopfloorAgent.tsx"
    end_line: 773
    content: "import React, { useState, useEffect, useRef } from \'react\';\nimport Markdown from \'react-markdown\';\nimport {\n  collection,\n  doc,\n  onSnapshot,\n  query,\n  orderBy,\n  addDoc,\n  deleteDoc,\n  serverTimestamp,\n} from \'firebase/firestore\';\nimport { db, apiFetch } from \'../lib/firebase.js\';\nimport { useAuth } from \'../context/AuthContext.js\';\n\nexport interface ChatSession {\n  id: string;\n  title: string;\n  controller: string;\n  updatedAt?: string | null;\n  createdAt?: string | null;\n}\n\nexport interface ChatMessage {\n  id: string;\n  role: \'user\' | \'model\';\n  text: string;\n  imageUrl?: string | null;\n  citations?: Array<{\n    documentName: string;\n    pageNumber: number;\n    snippet: string;\n  }> | null;\n  createdAt?: string | null;\n}\n\ninterface ShopfloorAgentProps {\n  initialChatId?: string | null;\n  initialCamera?: boolean;\n  initialQuery?: string;\n  onNavigate?: (tab: string, state?: any) => void;\n}\n\nexport function ShopfloorAgent({\n  initialChatId,\n  initialCamera = false,\n  initialQuery,\n  onNavigate,\n}: ShopfloorAgentProps) {\n  const { user, profile } = useAuth();\n\n  // Chat sessions state\n  const [chats, setChats] = useState<ChatSession[]>([]);\n  const [activeChatId, setActiveChatId] = useState<string | null>(initialChatId || null);\n  const [loadingChats, setLoadingChats] = useState<boolean>(true);\n\n  // Active messages state\n  const [messages, setMessages] = useState<ChatMessage[]>([]);\n  const [loadingMessages, setLoadingMessages] = useState<boolean>(false);\n\n  // Input state\n  const [inputText, setInputText] = useState<string>(initialQuery || \'\');\n  const [attachedImage, setAttachedImage] = useState<string | null>(null);\n  const [isSending, setIsSending] = useState<boolean>(false);\n  const [isListening, setIsListening] = useState<boolean>(false);\n  const [activeController, setActiveController] = useState<string>(\n    profile?.preferredController === \'mitsubishi\'\n      ? \'Mitsubishi M80\'\n      : profile?.preferredController === \'generic\'\n      ? \'Generic ISO G-Code\'\n      : \'Fanuc 0i-MF\'\n  );\n\n  // Camera dialog state\n  const [cameraOpen, setCameraOpen] = useState<boolean>(initialCamera);\n  const fileInputRef = useRef<HTMLInputElement>(null);\n  const messagesEndRef = useRef<HTMLDivElement>(null);\n\n  // Quick preset alarm scenarios\n  const quickAlarms = [\n    {\n      code: \'Fanuc 1004\',\n      title: \'Spindle Overheat\',\n      desc: \'SPINDLE MOTOR HIGH TEMP SENSOR TRIP\',\n      prompt: \'Fanuc 0i-MF Alarm 1004 SPINDLE OVERHEAT. Motor temperature exceeded 140\302\260C during heavy face milling. Cooling fan running.\',\n    },\n    {\n      code: \'Mitsu SV0401\',\n      title: \'VRDY OFF Alarm\',\n      desc: \'SERVO AMPLIFIER READY OFF DURING RUN\',\n      prompt: \'Mitsubishi M80 SV0401 SERVO ALARM (VRDY OFF). Machine went to emergency stop when Z-axis rapid was engaged.\',\n    },\n    {\n      code: \'EX0021\',\n      title: \'Z-Axis Soft Limit\',\n      desc: \'POSITIVE OVERTRAVEL IN RAPID G00\',\n      prompt: \'Alarm EX0021 Z-AXIS OVERTRAVEL (+) tripped before tool change cycle. Need manual recovery instructions.\',\n    },\n    {\n      code: \'G43 Missing\',\n      title: \'Tool Offset Hazard\',\n      desc: \'FEED ENGAGED WITHOUT H-CODE LENGTH OFFSET\',\n      prompt: \'Program started at line N105 without G43 H01 offset activated. Spindle plunging toward workpiece.\',\n    },\n  ];\n\n  // Auto-scroll chat to bottom\n  const scrollToBottom = () => {\n    messagesEndRef.current?.scrollIntoView({ behavior: \'smooth\' });\n  };\n\n  useEffect(() => {\n    scrollToBottom();\n  }, [messages, isSending]);\n\n  // Sync chats for logged in user, or keep memory session for guest\n  useEffect(() => {\n    if (!user?.uid) {\n      // Guest demo session\n      const guestSession: ChatSession = {\n        id: \'guest-session\',\n        title: \'Live Diagnostic Session\',\n        controller: activeController,\n        updatedAt: new Date().toISOString(),\n      };\n      setChats([guestSession]);\n      setActiveChatId(guestSession.id);\n      setLoadingChats(false);\n      return;\n    }\n\n    setLoadingChats(true);\n    const chatsQuery = query(\n      collection(db, \'users\', user.uid, \'chats\'),\n      orderBy(\'updatedAt\', \'desc\')\n    );\n\n    const unsubscribe = onSnapshot(\n      chatsQuery,\n      (snapshot) => {\n        const items: ChatSession[] = [];\n        snapshot.forEach((docSnap) => {\n          const data = docSnap.data();\n          items.push({\n            id: docSnap.id,\n            title: data.title || \'Diagnostic Session\',\n            controller: data.controller || \'Fanuc 0i-MF\',\n            updatedAt: data.updatedAt || null,\n            createdAt: data.createdAt || null,\n          });\n        });\n\n        setChats(items);\n        setLoadingChats(false);\n\n        // Select initial or first chat if none selected\n        if (items.length > 0 && !activeChatId) {\n          setActiveChatId(initialChatId || items[0].id);\n        }\n      },\n      (error) => {\n        console.warn(\'[ShopfloorAgent] Firestore chats listen warning:\', error);\n        setLoadingChats(false);\n      }\n    );\n\n    return () => unsubscribe();\n  }, [user?.uid]);\n\n  // Sync messages for active chat\n  useEffect(() => {\n    if (!activeChatId) {\n      setMessages([]);\n      return;\n    }\n\n    if (!user?.uid) {\n      // Guest demo fallback initial message if empty\n      if (messages.length === 0) {\n        setMessages([\n          {\n            id: \'welcome\',\n            role: \'model\',\n            text: `### \360\237\233\240\357\270\217 CNC Copilot Shopfloor Diagnostic Agent\\n\\nI am connected to your machine controller profile (**${activeController}**).\\n\\n- Type or paste an alarm code (e.g. *Fanuc 1004*, *SV0401*)\\n- Upload a photo of the CNC pendant screen\\n- Or select one of the common alarm presets below to inspect physical remedies and exact OEM manual page numbers.`,\n            createdAt: new Date().toISOString(),\n          },\n        ]);\n      }\n      return;\n    }\n\n    setLoadingMessages(true);\n    const msgsQuery = query(\n      collection(db, \'users\', user.uid, \'chats\', activeChatId, \'messages\'),\n      orderBy(\'createdAt\', \'asc\')\n    );\n\n    const unsubscribe = onSnapshot(\n      msgsQuery,\n      (snapshot) => {\n        const items: ChatMessage[] = [];\n        snapshot.forEach((docSnap) => {\n          const d = docSnap.data();\n          items.push({\n            id: docSnap.id,\n            role: d.role === \'model\' ? \'model\' : \'user\',\n            text: d.text || \'\',\n            imageUrl: d.imageUrl || null,\n            citations: Array.isArray(d.citations) ? d.citations : null,\n            createdAt: d.createdAt || null,\n          });\n        });\n\n        setMessages(items);\n        setLoadingMessages(false);\n      },\n      (error) => {\n        console.warn(\'[ShopfloorAgent] Firestore messages listen notice:\', error);\n        setLoadingMessages(false);\n      }\n    );\n\n    return () => unsubscribe();\n  }, [activeChatId, user?.uid]);\n\n  // Create new chat session\n  const handleCreateNewChat = async () => {\n    if (!user?.uid) {\n      const newGuestId = `guest-${Date.now()}`;\n      const newSession: ChatSession = {\n        id: newGuestId,\n        title: \'New Diagnostic Session\',\n        controller: activeController,\n        updatedAt: new Date().toISOString(),\n      };\n      setChats((prev) => [newSession, ...prev]);\n      setActiveChatId(newGuestId);\n      setMessages([]);\n      return;\n    }\n\n    try {\n      const docRef = await addDoc(collection(db, \'users\', user.uid, \'chats\'), {\n        title: \'New Diagnostic Session\',\n        controller: activeController,\n        createdAt: new Date().toISOString(),\n        updatedAt: new Date().toISOString(),\n      });\n      setActiveChatId(docRef.id);\n      setMessages([]);\n    } catch (err) {\n      console.error(\'[ShopfloorAgent] Failed to create new session:\', err);\n    }\n  };\n\n  // Delete chat session\n  const handleDeleteChat = async (e: React.MouseEvent, chatId: string) => {\n    e.stopPropagation();\n    if (!user?.uid) {\n      setChats((prev) => prev.filter((c) => c.id !== chatId));\n      if (activeChatId === chatId) {\n        setActiveChatId(null);\n        setMessages([]);\n      }\n      return;\n    }\n\n    try {\n      await deleteDoc(doc(db, \'users\', user.uid, \'chats\', chatId));\n      if (activeChatId === chatId) {\n        setActiveChatId(null);\n        setMessages([]);\n      }\n    } catch (err) {\n      console.warn(\'[ShopfloorAgent] Delete chat failed:\', err);\n    }\n  };\n\n  // Handle image upload from file or camera\n  const handleImageSelect = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n\n    const reader = new FileReader();\n    reader.onload = () => {\n      const base64 = reader.result as string;\n      setAttachedImage(base64);\n      setCameraOpen(false);\n    };\n    reader.readAsDataURL(file);\n  };\n\n  // Simulated Web Speech Voice Input\n  const handleToggleVoice = () => {\n    if (isListening) {\n      setIsListening(false);\n      return;\n    }\n\n    const SpeechRecognition =\n      (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;\n\n    if (SpeechRecognition) {\n      try {\n        const recognition = new SpeechRecognition();\n        recognition.lang = profile?.preferredLanguage || \'en-US\';\n        recognition.interimResults = false;\n        recognition.maxAlternatives = 1;\n\n        setIsListening(true);\n\n        recognition.onresult = (event: any) => {\n          const transcript = event.results[0]?.[0]?.transcript || \'\';\n          setInputText((prev) => (prev ? `${prev} ${transcript}` : transcript));\n          setIsListening(false);\n        };\n\n        recognition.onerror = () => {\n          setIsListening(false);\n        };\n\n        recognition.onend = () => {\n          setIsListening(false);\n        };\n\n        recognition.start();\n      } catch {\n        setIsListening(false);\n      }\n    } else {\n      // Speech recognition fallback notification\n      setInputText((prev) =>\n        prev\n          ? `${prev} [Alarm: Spindle overload current exceeded]`\n          : \'Spindle overload current exceeded during roughing cut\'\n      );\n    }\n  };\n\n  // Send message to backend agent API\n  const handleSendMessage = async (textToSend?: string) => {\n    const queryText = (textToSend || inputText).trim();\n    const queryImage = attachedImage;\n\n    if (!queryText && !queryImage) return;\n\n    let targetChatId = activeChatId;\n    if (!targetChatId) {\n      if (user?.uid) {\n        try {\n          const docRef = await addDoc(collection(db, \'users\', user.uid, \'chats\'), {\n            title: queryText.slice(0, 32) || \'Camera Alarm Diagnostic\',\n            controller: activeController,\n            createdAt: new Date().toISOString(),\n            updatedAt: new Date().toISOString(),\n          });\n          targetChatId = docRef.id;\n          setActiveChatId(targetChatId);\n        } catch {\n          targetChatId = `session-${Date.now()}`;\n          setActiveChatId(targetChatId);\n        }\n      } else {\n        targetChatId = \'guest-session\';\n        setActiveChatId(targetChatId);\n      }\n    }\n\n    // Optimistically show user message\n    const tempUserMsg: ChatMessage = {\n      id: `temp-${Date.now()}`,\n      role: \'user\',\n      text: queryText,\n      imageUrl: queryImage,\n      createdAt: new Date().toISOString(),\n    };\n\n    setMessages((prev) => [...(Array.isArray(prev) ? prev : []), tempUserMsg]);\n    setInputText(\'\');\n    setAttachedImage(null);\n    setIsSending(true);\n\n    try {\n      const response = await apiFetch(\'/api/agent/chat\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          message: queryText,\n          image: queryImage,\n          controller: activeController,\n          language: profile?.preferredLanguage || \'en\',\n          chatId: targetChatId,\n        }),\n      });\n\n      if (!response.ok) {\n        const errJson = await response.json().catch(() => ({}));\n        throw new Error(errJson.message || `API error ${response.status}`);\n      }\n\n      const data = await response.json();\n\n      // If user is guest, append assistant message locally\n      if (!user?.uid) {\n        const assistantMsg: ChatMessage = {\n          id: `resp-${Date.now()}`,\n          role: \'model\',\n          text: data.reply || \'Diagnostic complete.\',\n          citations: data.citations || null,\n          createdAt: new Date().toISOString(),\n        };\n        setMessages((prev) => [...(Array.isArray(prev) ? prev : []), assistantMsg]);\n      }\n    } catch (err: any) {\n      console.error(\'[ShopfloorAgent] Send error:\', err);\n      const fallbackMsg: ChatMessage = {\n        id: `err-${Date.now()}`,\n        role: \'model\',\n        text: `### \342\232\240\357\270\217 Diagnostic Interlock Warning\\n\\n${err?.message || \'Unable to connect to diagnostic server.\'}\\n\\nPlease check that your CNC machine E-Stop is released and network link is stable, then retry.`,\n        createdAt: new Date().toISOString(),\n      };\n      setMessages((prev) => [...(Array.isArray(prev) ? prev : []), fallbackMsg]);\n    } finally {\n      setIsSending(false);\n    }\n  };\n\n  const safeChats = Array.isArray(chats) ? chats : [];\n  const safeMessages = Array.isArray(messages) ? messages : [];\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 py-6\">\n      {/* Top Header Card */}\n      <div className=\"bg-surface-container-low rounded-2xl border border-outline-variant/30 p-4 sm:p-6 mb-6 shadow-xl flex flex-col md:flex-row md:items-center justify-between gap-4\">\n        <div className=\"flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-xl bg-primary-container/10 border border-primary-container/30 flex items-center justify-center text-primary-container shadow-inner\">\n            <span className=\"material-symbols-outlined text-[28px]\">smart_toy</span>\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <h1 className=\"font-headline-md text-xl font-bold text-on-surface\">\n                Shopfloor Diagnostic Copilot\n              </h1>\n              <span className=\"px-2 py-0.5 rounded bg-surface-container border border-outline-variant/40 text-[10px] font-mono uppercase tracking-wider text-primary-container font-semibold\">\n                Multimodal AI\n              </span>\n            </div>\n            <p className=\"font-body-sm text-xs text-tertiary mt-0.5\">\n              Instant alarm diagnostics, camera screen OCR, and cited OEM manual grounding.\n            </p>\n          </div>\n        </div>\n\n        {/* Controller Selector */}\n        <div className=\"flex items-center gap-3\">\n          <div className=\"flex items-center gap-2 bg-surface-container px-3 py-1.5 rounded-xl border border-outline-variant/40\">\n            <span className=\"material-symbols-outlined text-[18px] text-tertiary\">tune</span>\n            <span className=\"text-[11px] font-mono text-tertiary uppercase\">Target:</span>\n            <select\n              value={activeController}\n              onChange={(e) => setActiveController(e.target.value)}\n              className=\"bg-transparent font-mono text-xs text-on-surface focus:outline-none cursor-pointer\"\n            >\n              <option value=\"Fanuc 0i-MF\" className=\"bg-surface-container text-on-surface\">\n                Fanuc 0i-MF\n              </option>\n              <option value=\"Mitsubishi M80\" className=\"bg-surface-container text-on-surface\">\n                Mitsubishi M80\n              </option>\n              <option value=\"Generic ISO G-Code\" className=\"bg-surface-container text-on-surface\">\n                Generic ISO G-Code\n              </option>\n            </select>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={handleCreateNewChat}\n            className=\"h-9 px-3.5 rounded-xl bg-primary-container hover:brightness-110 active:scale-95 text-on-primary font-mono text-xs font-semibold flex items-center gap-1.5 transition-all shadow-md cursor-pointer\"\n          >\n            <span className=\"material-symbols-outlined text-[16px]\">add</span>\n            <span>New Session</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Main Grid: Chat List Sidebar & Active Chat Area */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-4 gap-6 min-h-[620px]\">\n        {/* Left Column: Sessions List */}\n        <div className=\"lg:col-span-1 bg-surface-container-low rounded-2xl border border-outline-variant/30 p-4 flex flex-col shadow-lg\">\n          <div className=\"flex items-center justify-between pb-3 mb-3 border-b border-outline-variant/30\">\n            <span className=\"text-xs font-mono uppercase tracking-wider text-tertiary font-semibold flex items-center gap-1.5\">\n              <span className=\"material-symbols-outlined text-[16px]\">history</span>\n              Diagnostic Sessions\n            </span>\n            <span className=\"px-1.5 py-0.5 rounded bg-surface-container font-mono text-[10px] text-tertiary\">\n              {safeChats.length}\n            </span>\n          </div>\n\n          {loadingChats ? (\n            <div className=\"flex-1 flex flex-col items-center justify-center gap-2 py-8 text-tertiary\">\n              <div className=\"w-5 h-5 border-2 border-primary-container border-t-transparent rounded-full animate-spin\" />\n              <span className=\"font-mono text-xs\">Loading sessions...</span>\n            </div>\n          ) : safeChats.length === 0 ? (\n            <div className=\"flex-1 flex flex-col items-center justify-center text-center p-4 text-tertiary gap-2\">\n              <span className=\"material-symbols-outlined text-[28px] opacity-40\">chat_bubble_outline</span>\n              <p className=\"text-xs font-mono\">No prior sessions</p>\n              <button\n                type=\"button\"\n                onClick={handleCreateNewChat}\n                className=\"mt-2 px-3 py-1 rounded-lg bg-surface-container hover:bg-surface-container-high border border-outline-variant/40 text-[11px] font-mono text-on-surface\"\n              >\n                Start First Session\n              </button>\n            </div>\n          ) : (\n            <div className=\"flex-1 flex flex-col gap-1.5 overflow-y-auto max-h-[520px] pr-1\">\n              {safeChats.map((chat) => (\n                <div\n                  key={chat.id}\n                  onClick={() => setActiveChatId(chat.id)}\n                  className={`group px-3 py-2.5 rounded-xl border transition-all cursor-pointer flex items-center justify-between ${\n                    activeChatId === chat.id\n                      ? \'bg-surface-container-high border-primary-container/50 shadow-sm\'\n                      : \'bg-surface-container/50 border-transparent hover:bg-surface-container hover:border-outline-variant/40\'\n                  }`}\n                >\n                  <div className=\"flex flex-col min-w-0 pr-2\">\n                    <span\n                      className={`text-xs font-medium truncate ${\n                        activeChatId === chat.id ? \'text-primary-container font-semibold\' : \'text-on-surface\'\n                      }`}\n                    >\n                      {chat.title}\n                    </span>\n                    <span className=\"text-[10px] font-mono text-tertiary truncate mt-0.5\">\n                      {chat.controller}\n                    </span>\n                  </div>\n\n                  <button\n                    type=\"button\"\n                    title=\"Delete session\"\n                    onClick={(e) => handleDeleteChat(e, chat.id)}\n                    className=\"opacity-0 group-hover:opacity-100 hover:text-error text-tertiary transition-opacity p-1\"\n                  >\n                    <span className=\"material-symbols-outlined text-[15px]\">delete</span>\n                  </button>\n                </div>\n              ))}\n            </div>\n          )}\n        </div>\n\n        {/* Right Column: Chat History & Input Stream */}\n        <div className=\"lg:col-span-3 bg-surface-container-low rounded-2xl border border-outline-variant/30 flex flex-col shadow-lg overflow-hidden min-h-[580px]\">\n          {/* Messages Scroll Area */}\n          <div className=\"flex-1 p-4 sm:p-6 overflow-y-auto max-h-[540px] flex flex-col gap-4\">\n            {loadingMessages ? (\n              <div className=\"flex-1 flex flex-col items-center justify-center gap-3 py-16 text-tertiary\">\n                <div className=\"w-6 h-6 border-2 border-primary-container border-t-transparent rounded-full animate-spin\" />\n                <span className=\"font-mono text-xs\">Syncing diagnostic thread...</span>\n              </div>\n            ) : safeMessages.length === 0 ? (\n              <div className=\"flex-1 flex flex-col items-center justify-center text-center p-6 gap-6 my-auto\">\n                <div className=\"w-16 h-16 rounded-2xl bg-surface-container border border-outline-variant/40 flex items-center justify-center text-primary-container shadow-inner\">\n                  <span className=\"material-symbols-outlined text-[32px]\">manage_search</span>\n                </div>\n                <div className=\"max-w-md\">\n                  <h3 className=\"font-headline-sm text-base font-bold text-on-surface\">\n                    Industrial Alarm Diagnostic Engine\n                  </h3>\n                  <p className=\"text-xs text-tertiary mt-1 leading-relaxed\">\n                    Enter an alarm code, describe what happened before the cycle stop, or snap a photo of the CNC controller screen.\n                  </p>\n                </div>\n\n                {/* Quick Presets Grid */}\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 w-full max-w-xl text-left\">\n                  {quickAlarms.map((q) => (\n                    <button\n                      key={q.code}\n                      type=\"button\"\n                      onClick={() => handleSendMessage(q.prompt)}\n                      className=\"p-3 rounded-xl bg-surface-container hover:bg-surface-container-high border border-outline-variant/40 hover:border-primary-container/40 transition-all text-left flex flex-col gap-1 cursor-pointer group\"\n                    >\n                      <div className=\"flex items-center justify-between\">\n                        <span className=\"font-mono text-xs font-bold text-primary-container\">\n                          {q.code}\n                        </span>\n                        <span className=\"material-symbols-outlined text-[16px] text-tertiary group-hover:text-primary-container transition-colors\">\n                          arrow_forward\n                        </span>\n                      </div>\n                      <span className=\"text-xs font-semibold text-on-surface\">{q.title}</span>\n                      <span className=\"text-[10px] font-mono text-tertiary\">{q.desc}</span>\n                    </button>\n                  ))}\n                </div>\n              </div>\n            ) : (\n              safeMessages.map((msg) => (\n                <div\n                  key={msg.id}\n                  className={`flex flex-col gap-1.5 max-w-3xl ${\n                    msg.role === \'user\' ? \'self-end items-end\' : \'self-start items-start\'\n                  }`}\n                >\n                  <div className=\"flex items-center gap-2 text-[10px] font-mono text-tertiary px-1\">\n                    <span>{msg.role === \'user\' ? \'Operator\' : \'Copilot Diagnostic\'}</span>\n                    {msg.createdAt && (\n                      <span>\342\200\242 {new Date(msg.createdAt).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })}</span>\n                    )}\n                  </div>\n\n                  {/* Attached user image preview */}\n                  {msg.imageUrl && (\n                    <div className=\"rounded-xl overflow-hidden border border-outline-variant/50 max-w-sm mb-1 shadow-md\">\n                      <img\n                        src={msg.imageUrl}\n                        alt=\"Controller Screen Snapshot\"\n                        className=\"w-full h-auto max-h-56 object-cover bg-black\"\n                      />\n                    </div>\n                  )}\n\n                  {/* Message bubble */}\n                  <div\n                    className={`p-4 rounded-2xl text-xs leading-relaxed shadow-sm ${\n                      msg.role === \'user\'\n                        ? \'bg-primary-container text-on-primary font-medium rounded-tr-sm\'\n                        : \'bg-surface-container border border-outline-variant/40 text-on-surface rounded-tl-sm\'\n                    }`}\n                  >\n                    {msg.role === \'user\' ? (\n                      <p className=\"whitespace-pre-wrap\">{msg.text}</p>\n                    ) : (\n                      <div className=\"prose prose-invert prose-xs max-w-none space-y-2\">\n                        <Markdown>{msg.text}</Markdown>\n                      </div>\n                    )}\n                  </div>\n\n                  {/* OEM Manual Citations Banner */}\n                  {msg.citations && msg.citations.length > 0 && (\n                    <div className=\"mt-1 flex flex-col gap-1 max-w-xl\">\n                      <span className=\"text-[10px] font-mono uppercase tracking-wider text-secondary flex items-center gap-1 font-bold\">\n                        <span className=\"material-symbols-outlined text-[13px]\">menu_book</span>\n                        OEM Manual Grounding\n                      </span>\n                      <div className=\"flex flex-wrap gap-1.5\">\n                        {msg.citations.map((c, idx) => (\n                          <div\n                            key={idx}\n                            className=\"px-2 py-1 rounded-lg bg-surface-container border border-secondary/30 text-[11px] font-mono text-secondary flex items-center gap-1.5\"\n                          >\n                            <span className=\"material-symbols-outlined text-[14px]\">auto_stories</span>\n                            <span>{c.documentName}</span>\n                            <span className=\"px-1 py-0.2 rounded bg-secondary/15 text-[9px] font-bold text-on-surface\">\n                              p.{c.pageNumber}\n                            </span>\n                          </div>\n                        ))}\n                      </div>\n                    </div>\n                  )}\n                </div>\n              ))\n            )}\n\n            {isSending && (\n              <div className=\"self-start flex items-center gap-3 p-4 rounded-2xl bg-surface-container border border-outline-variant/40 text-xs font-mono text-primary-container animate-pulse\">\n                <div className=\"w-4 h-4 border-2 border-primary-container border-t-transparent rounded-full animate-spin\" />\n                <span>Interrogating OEM manuals and diagnostic trees...</span>\n              </div>\n            )}\n\n            <div ref={messagesEndRef} />\n          </div>\n\n          {/* Attached Image Thumbnail Bar */}\n          {attachedImage && (\n            <div className=\"px-4 py-2 bg-surface-container border-t border-outline-variant/30 flex items-center justify-between\">\n              <div className=\"flex items-center gap-2\">\n                <div className=\"w-10 h-10 rounded-lg overflow-hidden border border-outline-variant/50\">\n                  <img src={attachedImage} alt=\"Thumbnail\" className=\"w-full h-full object-cover\" />\n                </div>\n                <span className=\"text-xs font-mono text-on-surface\">Screen Snapshot Attached</span>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => setAttachedImage(null)}\n                className=\"text-tertiary hover:text-error text-xs font-mono flex items-center gap-1 cursor-pointer\"\n              >\n                <span className=\"material-symbols-outlined text-[16px]\">cancel</span>\n                <span>Remove</span>\n              </button>\n            </div>\n          )}\n\n          {/* Bottom Action / Input Form */}\n          <div className=\"p-4 border-t border-outline-variant/30 bg-surface-container-low\">\n            <form\n              onSubmit={(e) => {\n                e.preventDefault();\n                handleSendMessage();\n              }}\n              className=\"flex items-end gap-2\"\n            >\n              {/* Camera Trigger */}\n              <button\n                type=\"button\"\n                onClick={() => fileInputRef.current?.click()}\n                title=\"Upload or Snap Screen Photo\"\n                className=\"w-10 h-10 rounded-xl bg-surface-container hover:bg-surface-container-high border border-outline-variant/40 flex items-center justify-center text-primary-container transition-colors cursor-pointer shrink-0\"\n              >\n                <span className=\"material-symbols-outlined text-[20px]\">photo_camera</span>\n              </button>\n              <input\n                ref={fileInputRef}\n                type=\"file\"\n                accept=\"image/*\"\n                capture=\"environment\"\n                onChange={handleImageSelect}\n                className=\"hidden\"\n              />\n\n              {/* Voice Trigger */}\n              <button\n                type=\"button\"\n                onClick={handleToggleVoice}\n                title={isListening ? \'Listening...\' : \'Voice Input\'}\n                className={`w-10 h-10 rounded-xl border flex items-center justify-center transition-colors cursor-pointer shrink-0 ${\n                  isListening\n                    ? \'bg-error text-on-error border-error animate-pulse\'\n                    : \'bg-surface-container hover:bg-surface-container-high border-outline-variant/40 text-secondary\'\n                }`}\n              >\n                <span className=\"material-symbols-outlined text-[20px]\">\n                  {isListening ? \'mic\' : \'mic_none\'}\n                </span>\n              </button>\n\n              {/* Text Input */}\n              <div className=\"flex-1 relative\">\n                <input\n                  type=\"text\"\n                  value={inputText}\n                  onChange={(e) => setInputText(e.target.value)}\n                  placeholder=\"Describe alarm or code (e.g. Fanuc 1004, SV0401, G43)...\"\n                  disabled={isSending}\n                  className=\"w-full h-10 px-4 rounded-xl bg-surface-container border border-outline-variant/40 text-xs font-mono text-on-surface placeholder:text-tertiary/60 focus:outline-none focus:border-primary-container transition-colors\"\n                />\n              </div>\n\n              {/* Submit Button */}\n              <button\n                type=\"submit\"\n                disabled={isSending || (!inputText.trim() && !attachedImage)}\n                className=\"h-10 px-4 rounded-xl bg-primary-container hover:brightness-110 active:scale-95 disabled:opacity-40 disabled:pointer-events-none text-on-primary font-mono text-xs font-semibold flex items-center gap-1.5 transition-all shadow-md cursor-pointer shrink-0\"\n              >\n                <span>Diagnose</span>\n                <span className=\"material-symbols-outlined text-[16px]\">send</span>\n              </button>\n            </form>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
