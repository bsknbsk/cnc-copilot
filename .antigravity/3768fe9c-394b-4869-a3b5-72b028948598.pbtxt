  view_file {
    absolute_path_uri: "file:///src/App.tsx"
    end_line: 152
    content: "import React, { useState, useEffect } from \'react\';\nimport { AuthProvider, useAuth } from \'./context/AuthContext.js\';\nimport { Navigation } from \'./components/Navigation.js\';\nimport { LandingPage } from \'./components/LandingPage.js\';\nimport { Dashboard } from \'./components/Dashboard.js\';\nimport { CuttingCalculator } from \'./components/calculator/CuttingCalculator.js\';\nimport { KnowledgeBase } from \'./components/KnowledgeBase.js\';\nimport { GCodeVerifier } from \'./components/GCodeVerifier.js\';\nimport { ErrorBoundary } from \'./components/ErrorBoundary.js\';\nimport { GlobalErrorHandler } from \'./components/GlobalErrorHandler.js\';\n\ntype TabType = \'home\' | \'agent\' | \'calculator\' | \'gcode\' | \'academy\' | \'kb\';\n\nfunction getTabFromPath(): TabType {\n  if (typeof window === \'undefined\') return \'home\';\n  const path = window.location.pathname.replace(/^\\/+/, \'\').split(\'/\')[0];\n  if ([\'agent\', \'calculator\', \'gcode\', \'academy\', \'kb\'].includes(path)) {\n    return path as TabType;\n  }\n  return \'home\';\n}\n\nfunction AppContent() {\n  const { user, loading, isAdmin } = useAuth();\n  const [currentTab, setCurrentTab] = useState<TabType>(getTabFromPath);\n  const [, setNavigationState] = useState<any>(null);\n\n  // Synchronize browser history and popstate navigation (e.g. forward/back buttons or direct /agent URL)\n  useEffect(() => {\n    const handlePopState = () => {\n      setCurrentTab(getTabFromPath());\n    };\n    window.addEventListener(\'popstate\', handlePopState);\n    return () => window.removeEventListener(\'popstate\', handlePopState);\n  }, []);\n\n  const handleNavigate = (tab: string, state?: any) => {\n    const targetTab = tab as TabType;\n    setCurrentTab(targetTab);\n    setNavigationState(state || null);\n\n    const targetPath = targetTab === \'home\' ? \'/\' : `/${targetTab}`;\n    if (window.location.pathname !== targetPath) {\n      window.history.pushState({}, \'\', targetPath);\n    }\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  if (loading) {\n    return (\n      <div className=\"min-h-screen bg-surface-container-lowest flex flex-col items-center justify-center gap-4 text-tertiary\">\n        <div className=\"w-12 h-12 rounded-xl bg-surface-container border border-outline-variant/40 flex items-center justify-center text-primary-container animate-spin\">\n          <div className=\"w-6 h-6 border-2 border-primary-container border-t-transparent rounded-full\" />\n        </div>\n        <div className=\"flex flex-col items-center gap-1 font-mono\">\n          <span className=\"text-xs uppercase tracking-wider text-on-surface\">Connecting Kinematic Link</span>\n          <span className=\"text-[11px] text-tertiary-container\">Verifying Firebase credentials...</span>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-surface-container-lowest text-on-surface flex flex-col\">\n      <Navigation currentTab={currentTab} onSelectTab={handleNavigate} />\n\n      <main className=\"flex-1 pt-16\">\n        {currentTab === \'home\' && (\n          <ErrorBoundary route=\"home\" onNavigateHome={() => handleNavigate(\'home\')}>\n            {user ? <Dashboard onNavigate={handleNavigate} /> : <LandingPage />}\n          </ErrorBoundary>\n        )}\n\n        {currentTab === \'agent\' && (\n          <ErrorBoundary route=\"agent\" onNavigateHome={() => handleNavigate(\'home\')}>\n            <div className=\"max-w-7xl mx-auto px-margin py-8\">\n              <div className=\"bg-surface-container-low p-8 rounded-xl border border-outline-variant/30 text-center flex flex-col items-center justify-center gap-4 shadow-xl\">\n                <div className=\"w-16 h-16 rounded-2xl bg-primary-container/10 border border-primary-container/30 flex items-center justify-center text-primary-container\">\n                  <span className=\"material-symbols-outlined text-[36px]\">smart_toy</span>\n                </div>\n                <h2 className=\"font-headline-lg text-xl font-bold text-on-surface\">Shopfloor Agent</h2>\n                <p className=\"font-body-sm text-sm text-tertiary max-w-md\">\n                  Voice, camera diagnostics, and manual grounding are scheduled in Milestone 3.\n                </p>\n                <button\n                  type=\"button\"\n                  onClick={() => handleNavigate(\'home\')}\n                  className=\"h-10 px-4 rounded-xl bg-surface-container hover:bg-surface-container-high border border-outline-variant/40 text-xs font-mono text-on-surface cursor-pointer\"\n                >\n                  Return to Dashboard\n                </button>\n              </div>\n            </div>\n          </ErrorBoundary>\n        )}\n\n        {currentTab === \'calculator\' && (\n          <ErrorBoundary route=\"calculator\" onNavigateHome={() => handleNavigate(\'home\')}>\n            <CuttingCalculator />\n          </ErrorBoundary>\n        )}\n\n        {currentTab === \'gcode\' && (\n          <ErrorBoundary route=\"gcode\" onNavigateHome={() => handleNavigate(\'home\')}>\n            <GCodeVerifier onNavigate={handleNavigate} />\n          </ErrorBoundary>\n        )}\n\n        {currentTab === \'academy\' && (\n          <ErrorBoundary route=\"academy\" onNavigateHome={() => handleNavigate(\'home\')}>\n            <div className=\"max-w-7xl mx-auto px-margin py-8\">\n              <div className=\"bg-surface-container-low p-8 rounded-xl border border-outline-variant/30 text-center flex flex-col items-center justify-center gap-4 shadow-xl\">\n                <div className=\"w-16 h-16 rounded-2xl bg-primary/10 border border-primary/30 flex items-center justify-center text-primary\">\n                  <span className=\"material-symbols-outlined text-[36px]\">school</span>\n                </div>\n                <h2 className=\"font-headline-lg text-xl font-bold text-on-surface\">Operator Academy & Crash Lab</h2>\n                <p className=\"font-body-sm text-sm text-tertiary max-w-md\">\n                  Kinematic crash engine, 4 mission challenges, and AI instructor hints are scheduled in Milestone 6.\n                </p>\n                <button\n                  type=\"button\"\n                  onClick={() => handleNavigate(\'home\')}\n                  className=\"h-10 px-4 rounded-xl bg-surface-container hover:bg-surface-container-high border border-outline-variant/40 text-xs font-mono text-on-surface cursor-pointer\"\n                >\n                  Return to Dashboard\n                </button>\n              </div>\n            </div>\n          </ErrorBoundary>\n        )}\n\n        {currentTab === \'kb\' && (\n          <ErrorBoundary route=\"kb\" onNavigateHome={() => handleNavigate(\'home\')}>\n            <KnowledgeBase onNavigate={handleNavigate} />\n          </ErrorBoundary>\n        )}\n      </main>\n    </div>\n  );\n}\n\nexport default function App() {\n  return (\n    <ErrorBoundary route=\"root\">\n      <GlobalErrorHandler>\n        <AuthProvider>\n          <AppContent />\n        </AuthProvider>\n      </GlobalErrorHandler>\n    </ErrorBoundary>\n  );\n}\n"
    num_lines: 153
    num_bytes: 6897
    line_range_bytes: 6897
  }
}
