nt-label-sm text-label-sm font-mono text-on-surface font-semibold bg-surface-container-lowest/80 px-2 py-0.5 rounded truncate max-w-[280px]\">\n                      {lastSnapshot.caption || \'CNC PENDANT CAPTURE\'}\n                    </span>\n                    <button\n                      onClick={() => onNavigate(\'agent\')}\n                      className=\"font-code-sm text-code-sm text-secondary font-mono hover:underline flex items-center gap-1 cursor-pointer\"\n                    >\n                      <span>Diagnose</span>\n                      <span className=\"material-symbols-outlined text-[14px]\">open_in_new</span>\n                    </button>\n                  </div>\n                </>\n              ) : (\n                /* Designed Empty State */\n                <div className=\"flex flex-col items-center justify-center p-6 text-center gap-2\">\n                  <div className=\"w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-tertiary mb-1\">\n                    <span className=\"material-symbols-outlined text-[28px]\">photo_camera</span>\n                  </div>\n                  <p className=\"font-body-sm text-body-sm text-on-surface font-medium\">\n                    Snap a controller screen in the Agent to diagnose it.\n                  </p>\n                  <p className=\"font-label-sm text-label-sm text-tertiary\">\n                    Captures alarms, parameters, and servo loads directly from the pendant.\n                  </p>\n                  <button\n                    onClick={() => onNavigate(\'agent\', { openCamera: true })}\n                    className=\"mt-2 h-9 px-space-md rounded-lg bg-surface-container-high hover:bg-surface-container hover:text-secondary text-on-surface transition-colors font-mono text-xs flex items-center gap-1.5 border border-outline-variant/40 cursor-pointer\"\n                    type=\"button\"\n                  >\n                    <span className=\"material-symbols-outlined text-[16px] text-primary-container\">camera</span>\n                    <span>Open Agent Camera</span>\n                  </button>\n                </div>\n              )}\n            </div>\n\n            <div className=\"grid grid-cols-2 gap-space-sm pt-space-xs\">\n              <div className=\"bg-surface-container p-space-sm rounded\">\n                <span className=\"font-label-sm text-label-sm text-tertiary uppercase block\">Active Workpiece</span>\n                <span className=\"font-headline-sm text-headline-sm font-bold text-on-surface truncate block\">\n                  {profile?.preferredController ? `${preferredControllerName} Setup` : \'Standard Workpiece\'}\n                </span>\n              </div>\n              <div className=\"bg-surface-container p-space-sm rounded\">\n                <span className=\"font-label-sm text-label-sm text-tertiary uppercase block\">Diagnostics Run</span>\n                <div className=\"flex items-baseline justify-between\">\n                  <span className=\"font-code-md text-code-md font-bold text-secondary font-mono\">\n                    {totalChats} Total\n                  </span>\n                  <span className=\"font-label-sm text-label-sm font-mono text-tertiary\">LOGGED</span>\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>"
