            </div>                  <div className=\"mt-space-md\">                    <h4 className=\"font-headline-sm text-headline-sm font-bold text-on-surface group-hover:text-primary transition-colors line-clamp-2\">                      {docItem.name}                    </h4>                    <span className=\"font-code-sm text-code-sm text-tertiary mt-1 block font-mono\">                      {docItem.docType} \342\200\242 {docItem.pages ? `${docItem.pages} pages` : \'Indexed\'}                    </span>                  </div>                </div>              ))            )}          </div>        </section>        {/* 8. Industrial Footer */}        <footer className=\"w-full mt-space-xl pt-space-md border-t border-outline-variant/30 flex flex-col sm:flex-row items-center justify-between gap-space-sm font-label-sm text-label-sm text-tertiary font-mono\">          <div className=\"flex items-center gap-space-sm\">            <span className=\"w-2 h-2 rounded-full bg-secondary\"></span>            <span className=\"text-on-surface font-semibold\">CNC COPILOT INDUSTRIAL TELEMETRY</span>            <span className=\"text-outline-variant\">|</span>            <span>BUILT FOR GOOGLE CLOUD AI BUILDER CUP 2026</span>          </div>          <div className=\"flex items-center gap-space-md\">            <span>STATION ID: MC-094</span>            <span className=\"text-outline-variant\">|</span>            <span className=\"text-secondary font-bold\">V2.4 CORE</span>          </div>        </footer>      </div>    </div>  );}"
