            }
            lines {
              text: "      maxY = Math.max(...segments.map(s => Math.max(s.from.y, s.to.y)));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      minZ = Math.min(...segments.map(s => Math.min(s.from.z, s.to.z)));"
