              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      currentDayVal: counts[counts.length - 1] || 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
