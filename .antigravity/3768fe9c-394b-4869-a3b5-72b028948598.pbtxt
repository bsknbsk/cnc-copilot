ading={justCalculated}\\n              icon={justCalculated ? \'check_circle\' : \'precision_manufacturing\'}\\n              className=\\\"w-full h-12\\\"\\n            >\\n              {justCalculated ? \'Physics Engine Computed & Logged\' : \'Calculate Physics Engine\'}\\n            </ButtonPrimary>\\n          </Card>\",\"StartLine\":660,\"TargetContent\":\"            {/* Recalculate Physics CTA Button */}\\n            <button\\n              onClick={logCalculation}\\n              className={`w-full min-h-[48px] py-space-sm rounded-lg font-headline-sm text-headline-sm font-bold flex items-center justify-center gap-space-sm shadow-md transition-all cursor-pointer ${\\n                justCalculated\\n                  ? \'bg-secondary text-on-secondary scale-[0.99]\'\\n                  : \'bg-primary-container hover:bg-primary-container/90 active:scale-[0.99] text-on-primary\'\\n              }`}\\n              type=\\\"button\\\"\\n            >\\n              <span className=\\\"material-symbols-outlined text-[20px]\\\">\\n                {justCalculated ? \'check_circle\' : \'precision_manufacturing\'}\\n              </span>\\n              <span>{justCalculated ? \'Physics Engine Computed & Logged\' : \'Calculate Physics Engine\'}</span>\\n            </button>\\n          </div>\"},{\"AllowMultiple\":false,\"EndLine\":819,\"ReplacementContent\":\"            {/* Core Physics Metrics Grid (2x2) */}\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-space-md\\\">\\n              {/* Metric Card 1: Spindle Speed (n) */}\\n              <Card className=\\\"p-space-md flex flex-col justify-between\\\">\\n                <SectionHeader \\n                  title=\\\"Spindle Speed (n)\\\" \\n                  actions={<Badge variant=\\\"secondary\\\">{Math.round((results.rpm / maxSpindleRpm) * 100)}% Cap</Badge>}\\n                  className=\\\"border-b-0 mb-0 pb-0\\\"\\n                />\\n                <div className=\\\"flex item