            }
            lines {
              text: "      if (seg.type === \'rapid\') {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        rapidPts.push(p1, p2);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
