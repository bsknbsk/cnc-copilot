            }
            lines {
              text: "// 3D Toolpath Scene"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "function ToolpathScene({"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  segments,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
