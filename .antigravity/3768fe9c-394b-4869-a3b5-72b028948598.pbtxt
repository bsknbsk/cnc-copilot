>\\n                  <span className=\\\"material-symbols-outlined text-[18px]\\\">error</span>\\n                  <div>\\n                    <span className=\\\"font-bold block\\\">Analysis Failed</span>\\n                    <span>{explainError}</span>\\n                  </div>\\n                </div>\\n              )}\\n\\n              {explanation && (\\n                <div className=\\\"p-4 rounded-xl bg-surface-container border border-outline-variant/40 text-on-surface text-sm leading-relaxed whitespace-pre-wrap font-body-md shadow-sm\\\">\\n                  {explanation}\\n                </div>\\n              )}\\n            </div>\\n\\n            <div className=\\\"pt-4 border-t border-surface-container-high flex items-center justify-between\\\">\\n              <span className=\\\"font-label-sm text-[10px] text-tertiary font-mono\\\">\\n                AI explains. Physics decides.\\n              </span>\\n              <button\\n                onClick={() => setExplainDrawerOpen(false)}\\n                className=\\\"px-4 py-2 rounded-lg bg-surface-container hover:bg-surface-container-high text-xs font-mono text-on-surface cursor-pointer\\\"\\n                type=\\\"button\\\"\\n              >\\n                Close\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      )}\",\"TargetFile\":\"/src/components/calculator/CuttingCalculator.tsx\",\"toolAction\":\"Refactoring CuttingCalculator G84 block and drawer\",\"toolSummary\":\"Refactor CuttingCalculator G84 block and drawer\"}"
