  view_file {
    absolute_path_uri: "file:///src/context/AuthContext.tsx"
    end_line: 137
    content: "import React, { createContext, useContext, useEffect, useState, useMemo } from \'react\';\nimport { User, onAuthStateChanged } from \'firebase/auth\';\nimport { doc, onSnapshot } from \'firebase/firestore\';\nimport { auth, db, loginWithGoogle, logoutUser, apiFetch, handleFirestoreError, OperationType } from \'../lib/firebase.js\';\n\nexport interface UserProfile {\n  displayName: string;\n  email: string;\n  photoURL?: string;\n  preferredLanguage: \'en\' | \'hi\' | \'ml\' | \'ta\';\n  preferredController: \'fanuc\' | \'mitsubishi\' | \'generic\';\n  role: \'user\' | \'admin\';\n  createdAt?: string;\n}\n\ninterface AuthContextType {\n  user: User | null;\n  profile: UserProfile | null;\n  loading: boolean;\n  isAdmin: boolean;\n  login: () => Promise<void>;\n  logout: () => Promise<void>;\n  updatePreferences: (updates: { preferredLanguage?: \'en\' | \'hi\' | \'ml\' | \'ta\'; preferredController?: \'fanuc\' | \'mitsubishi\' | \'generic\' }) => Promise<void>;\n}\n\nconst AuthContext = createContext<AuthContextType | undefined>(undefined);\n\nexport function AuthProvider({ children }: { children: React.ReactNode }) {\n  const [user, setUser] = useState<User | null>(null);\n  const [profile, setProfile] = useState<UserProfile | null>(null);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    const unsubscribeAuth = onAuthStateChanged(auth, async (currentUser) => {\n      setUser(currentUser);\n      if (!currentUser) {\n        setProfile(null);\n        setLoading(false);\n        return;\n      }\n\n      // Synchronize with server /api/user/me to register user and obtain role\n      try {\n        const res = await apiFetch(\'/api/user/me\');\n        if (res.ok) {\n          const data = await res.json();\n          setProfile(data);\n        }\n      } catch (err) {\n        console.warn(\'[AuthProvider] /api/user/me initial fetch failed:\', err);\n      }\n\n      // Listen to users/{uid} in real-time\n      const userDocRef = doc(db, \'users\', currentUser.uid);\n      const unsubscribeDoc = onSnapshot(\n        userDocRef,\n        (snap) => {\n          if (snap.exists()) {\n            setProfile(snap.data() as UserProfile);\n          }\n          setLoading(false);\n        },\n        (error) => {\n          console.warn(\'[AuthProvider] onSnapshot error:\', error);\n          setLoading(false);\n        }\n      );\n\n      return () => unsubscribeDoc();\n    });\n\n    return () => unsubscribeAuth();\n  }, []);\n\n  const login = async () => {\n    try {\n      await loginWithGoogle();\n    } catch (err) {\n      console.error(\'Google Sign In failed:\', err);\n      throw err;\n    }\n  };\n\n  const logout = async () => {\n    try {\n      await logoutUser();\n    } catch (err) {\n      console.error(\'Sign Out failed:\', err);\n      throw err;\n    }\n  };\n\n  const updatePreferences = async (updates: { preferredLanguage?: \'en\' | \'hi\' | \'ml\' | \'ta\'; preferredController?: \'fanuc\' | \'mitsubishi\' | \'generic\' }) => {\n    try {\n      const res = await apiFetch(\'/api/user/preferences\', {\n        method: \'PATCH\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify(updates),\n      });\n      if (!res.ok) {\n        throw new Error(\'Failed to update preferences on server\');\n      }\n      setProfile((prev) => (prev ? { ...prev, ...updates } : null));\n    } catch (err) {\n      console.error(\'Failed to update preferences:\', err);\n      throw err;\n    }\n  };\n\n  const isAdmin = useMemo(() => {\n    return profile?.role === \'admin\';\n  }, [profile?.role]);\n\n  return (\n    <AuthContext.Provider\n      value={{\n        user,\n        profile,\n        loading,\n        isAdmin,\n        login,\n        logout,\n        updatePreferences,\n      }}\n    >\n      {children}\n    </AuthContext.Provider>\n  );\n}\n\nexport function useAuth(): AuthContextType {\n  const context = useContext(AuthContext);\n  if (!context) {\n    throw new Error(\'useAuth must be used within an AuthProvider\');\n  }\n  return context;\n}\n"
    num_lines: 138
    num_bytes: 3878
    line_range_bytes: 3878
  }
