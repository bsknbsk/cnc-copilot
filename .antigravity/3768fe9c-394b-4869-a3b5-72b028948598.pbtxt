              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return `${(cm3Min / 16.387).toFixed(2)} in\302\263/min`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
