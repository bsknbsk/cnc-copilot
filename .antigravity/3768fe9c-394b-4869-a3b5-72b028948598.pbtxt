  planner_response {
    thinking: "**Examining Access Control**\n\nI\'m currently reviewing `server/authMiddleware.ts`. I\'ve realized that errors related to `adminDb`\'s connection to Firestore shouldn\'t trigger critical failures or intimidating messages. The crucial element for determining a user\'s role hinges on the `email` extraction and its conversion to lowercase, alongside the determination of `isAdmin`.\n\n\n"
    tool_calls {
      id: "call_1067792"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { Request, Response, NextFunction } from \'express\';\\nimport { adminAuth, adminDb } from \'./firebase.js\';\\nimport { ADMIN_EMAILS } from \'./config.js\';\\n\\nexport interface AuthenticatedUser {\\n  uid: string;\\n  email: string;\\n  role: \'user\' | \'admin\';\\n  displayName?: string;\\n  photoURL?: string;\\n  preferredLanguage?: \'en\' | \'hi\' | \'ml\' | \'ta\';\\n  preferredController?: \'fanuc\' | \'mitsubishi\' | \'generic\';\\n}\\n\\ndeclare global {\\n  namespace Express {\\n    interface Request {\\n      user?: AuthenticatedUser;\\n    }\\n  }\\n}\\n\\nexport async function requireAuth(req: Request, res: Response, next: NextFunction): Promise<void> {\\n  const authHeader = req.headers.authorization;\\n  if (!authHeader || !authHeader.startsWith(\'Bearer \')) {\\n    res.status(401).json({ error: \'unauthorized\', message: \'Missing or malformed Authorization header\' });\\n    return;\\n  }\\n\\n  const idToken = authHeader.split(\'Bearer \')[1]?.trim();\\n  if (!idToken) {\\n    res.status(401).json({ error: \'unauthorized\', message: \'Missing token\' });\\n    return;\\n  }\\n\\n  try {\\n    const decoded = await adminAuth.verifyIdToken(idToken);\\n    const email = (decoded.email || \'\').toLowerCase();\\n    const isAdmin = ADMIN_EMAILS.includes(email);\\n    const role: \'user\' | \'admin\' = isAdmin ? \'admin\' : \'user\';\\n\\n    let preferredLanguage: \'en\' | \'hi\' | \'ml\' | \'ta\' = \'en\';\\n    let preferredController: \'fanuc\' | \'mitsubishi\' | \'generic\' = \'fanuc\';\\n\\n    // Best-effort sync to Firestore user doc (graceful fallback if admin service account lacks write permission)\\n    try {\\n      const userRef = adminDb.collection(\'users\').doc(decoded.uid);\\n      const userSnap = await userRef.get();\\n      if (!userSnap.exists) {\\n        await userRef.set({\\n          displayName: decoded.name || decoded.email?.split(\'@\')[0] || \'Operator\',\\n          email: decoded.email || \'\',\\n          photoURL: decoded.picture || \'\',\\n          preferredLanguage: \'en\',\\n          preferredController: \'fanuc\',\\n          role,\\n          createdAt: new Date().toISOString(),\\n        }, { merge: true });\\n      } else {\\n        const data = userSnap.data();\\n        preferredLanguage = data?.preferredLanguage || \'en\';\\n        preferredController = data?.preferredController || \'fanuc\';\\n        if (data?.role !== role) {\\n          await userRef.update({ role });\\n        }\\n      }\\n    } catch {\\n      // Graceful fallback: role is already securely enforced from ADMIN_EMAILS & verified ID token\\n    }\\n\\n    req.user = {\\n      uid: decoded.uid,\\n      email,\\n      role,\\n      displayName: decoded.name || decoded.email?.split(\'@\')[0] || \'Operator\',\\n      photoURL: decoded.picture || \'\',\\n      preferredLanguage,\\n      preferredController,\\n    };\\n\\n    next();\\n  } catch (error: any) {\\n    console.error(\'[authMiddleware] Token verification failed:\', error?.message);\\n    res.status(401).json({ error: \'unauthorized\', message: \'Invalid or expired token\' });\\n  }\\n}\\n\\nexport function requireAdmin(req: Request, res: Response, next: NextFunction): void {\\n  if (!req.user || req.user.role !== \'admin\') {\\n    res.status(403).json({ error: \'forbidden\', message: \'Admin access required\' });\\n    return;\\n  }\\n  next();\\n}\\n\",\"Description\":\"Make Firestore synchronization graceful in authMiddleware.ts\",\"Overwrite\":true,\"TargetFile\":\"/server/authMiddleware.ts\",\"toolAction\":\"Updating authMiddleware.ts\",\"toolSummary\":\"Handle Firestore sync gracefully in auth middleware\"}"
      thought_signature: ""
      original_name: "write_to_file"
