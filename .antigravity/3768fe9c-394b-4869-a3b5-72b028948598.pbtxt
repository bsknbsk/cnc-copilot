  view_file {
    absolute_path_uri: "file:///firestore.rules"
    end_line: 65
    content: "rules_version = \'2\';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    // Default-deny catch-all\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isOwner(uid) {\n      return isSignedIn() && request.auth.uid == uid;\n    }\n\n    // users/{uid} collection\n    match /users/{uid} {\n      allow read: if isOwner(uid);\n      // Client can update preferences, but never mutate the role field\n      allow update: if isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([\'role\']);\n      // Client can create own document on first sign in (role defaults to user)\n      allow create: if isOwner(uid) && (!(\'role\' in request.resource.data) || request.resource.data.role == \'user\');\n      allow delete: if false;\n\n      // Subcollections of users/{uid}\n      match /chats/{chatId} {\n        allow read, write: if isOwner(uid);\n\n        match /messages/{msgId} {\n          allow read, write: if isOwner(uid);\n        }\n      }\n\n      match /activity/{activityId} {\n        allow read, create: if isOwner(uid);\n        allow update, delete: if false;\n      }\n\n      match /academy/{docId} {\n        allow read, write: if isOwner(uid);\n      }\n    }\n\n    // kb_docs: readable by any signed-in user, no client writes (server only)\n    match /kb_docs/{docId} {\n      allow read: if isSignedIn();\n      allow write: if false;\n    }\n\n    // Server-only collections: usage, feedback, config\n    match /usage/{docId} {\n      allow read, write: if false;\n    }\n\n    match /feedback/{docId} {\n      allow read, write: if false;\n    }\n\n    match /config/{docId} {\n      allow read, write: if false;\n    }\n  }\n}\n"
    num_lines: 66
    num_bytes: 1739
    line_range_bytes: 1739
  }
}
