          target_content: "            {/* Tapping Rigid G-code Block Display (if tapping) */}\n            {process === \'tapping\' && results.gcodeBlock && (\n              <div className=\"bg-surface-container rounded-xl p-space-md border border-secondary/30 flex flex-col gap-2\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"font-label-sm text-xs font-mono text-secondary uppercase font-bold flex items-center gap-1\">\n                    <span className=\"material-symbols-outlined text-[16px]\">terminal</span>\n                    Fanuc Rigid Tapping Block (G84)\n                  </span>\n                  <span className=\"font-mono text-xs text-tertiary\">\n                    Tap Drill: <strong className=\"text-on-surface\">\303\230{results.tapDrillMm} mm</strong>\n                  </span>\n                </div>\n                <div className=\"bg-surface-container-lowest p-space-md rounded-lg border border-outline-variant/30 font-mono text-sm text-secondary shadow-inner relative overflow-hidden\">\n                  <div className=\"absolute top-0 right-0 p-2 opacity-10\">\n                    <span className=\"material-symbols-outlined text-[48px]\">terminal</span>\n                  </div>\n                  <div className=\"relative z-10\">\n                    <div className=\"text-tertiary-container text-[10px] mb-1 uppercase tracking-widest\">\n                      G84 Rigid Cycle Output\n                    </div>\n                    <pre className=\"whitespace-pre-wrap\">{results.gcodeBlock}</pre>\n                  </div>\n                </div>\n              </div>\n            )}\n\n            {/* Copilot Advice Card */}\n            <div\n              className={`bg-surface-container rounded-xl p-space-lg flex flex-col gap-space-md shadow-lg relative overflow-hidden border ${\n                results.powerZone === \'red\'\n                  ? \'border-error/40\'\n                  : results.powerZone === \'amber\'\n                  ? \'border-primary-container/40\'\n                  : \'border-secondary/40\'\n              }`}\n            >\n              {/* Colored side ribbon */}\n              <div\n                className={`absolute left-0 top-0 bottom-0 w-1.5 ${\n                  results.powerZone === \'red\'\n                    ? \'bg-error\'\n                    : results.powerZone === \'amber\'\n                    ? \'bg-primary-container\'\n                    : \'bg-secondary\'\n                }`}\n              ></div>\n\n              <div className=\"flex items-center gap-space-md pl-space-xs\">\n                <div className=\"w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-secondary shadow-inner\">\n                  <span className=\"material-symbols-outlined text-[28px]\">psychology</span>\n                </div>\n                <div className=\"flex flex-col\">\n                  <h3 className=\"font-headline-sm text-headline-sm font-bold text-on-surface\">Copilot Advice</h3>\n                  <p className=\"font-body-sm text-body-sm text-tertiary\">\n                    Ask the process engineer to verify these parameters.\n                  </p>\n                </div>\n              </div>\n\n              <button\n                onClick={handleAskCopilot}\n                className=\"w-full h-12 rounded-xl bg-secondary text-on-secondary font-headline-sm text-sm font-bold flex items-center justify-center gap-space-sm hover:brightness-110 active:scale-95 transition-all shadow-md shadow-secondary/20 cursor-pointer\"\n                type=\"button\"\n              >\n                <span className=\"material-symbols-outlined text-[20px]\">psychology</span>\n                <span>Verify with Copilot Engineer</span>\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Slide-out Side Drawer for \"Ask Copilot Why\" AI Explanation */}\n      {explainDrawerOpen && (\n        <div className=\"fixed inset-0 z-50 flex justify-end bg-black/60 backdrop-blur-sm\">\n          <div className=\"w-full max-w-lg bg-surface-container-low border-l border-outline-variant shadow-2xl p-space-lg flex flex-col justify-between h-full overflow-y-auto\">\n            <div className=\"flex flex-col gap-space-md\">\n              <div className=\"flex items-center justify-between border-b border-surface-container-high pb-space-sm\">\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-9 h-9 rounded-lg bg-secondary/15 flex items-center justify-center text-secondary\">\n                    <span className=\"material-symbols-outlined text-[20px]\">psychology</span>\n                  </div>\n                  <div>\n                    <h3 className=\"font-headline-sm text-base font-bold text-on-surface\">\n                      Copilot Process Analysis\n                    </h3>\n                    <span className=\"font-label-sm text-[11px] text-secondary font-mono\">\n                      Senior CNC Process Engineer\n                    </span>\n                  </div>\n                </div>\n                <button\n                  onClick={() => setExplainDrawerOpen(false)}\n                  className=\"p-1 rounded text-tertiary hover:text-on-surface cursor-pointer\"\n                  type=\"button\"\n                >\n                  <span className=\"material-symbols-outlined text-[22px]\">close</span>\n                </button>\n              </div>\n\n              {/* Engine Summary Banner */}\n              <div className=\"p-3 rounded-lg bg-surface-container border border-outline-variant/30 text-xs font-mono space-y-1\">\n                <div className=\"flex justify-between\">\n                  <span className=\"text-tertiary\">Material:</span>\n                  <span className=\"text-on-surface font-semibold\">{material.name}</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span className=\"text-tertiary\">Spindle Load:</span>\n                  <span\n                    className={\n                      results.powerZone === \'red\'\n                        ? \'text-error font-bold\'\n                        : results.powerZone === \'amber\'\n                        ? \'text-primary-container font-bold\'\n                        : \'text-secondary font-bold\'\n                    }\n                  >\n                    {results.powerPercent}% ({results.powerKw} kW)\n                  </span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span className=\"text-tertiary\">Speed Band:</span>\n                  <span className=\"text-tertiary-fixed\">\n                    {vc} m/min (Recommended: {recRange.min}-{recRange.max})\n                  </span>\n                </div>\n              </div>\n\n              {/* AI Explanation Area */}\n              {explaining && (\n                <div className=\"py-12 flex flex-col items-center justify-center gap-3 text-secondary font-mono text-xs\">\n                  <span className=\"material-symbols-outlined text-[32px] animate-spin\">refresh</span>\n                  <span>Synthesizing Kienzle force and chip dynamics...</span>\n                </div>\n              )}\n\n              {explainError && (\n                <div className=\"p-4 rounded-lg bg-error-container/20 border border-error/30 text-error text-xs font-mono flex items-start gap-2\">\n                  <span className=\"material-symbols-outlined text-[18px]\">error</span>\n                  <div>\n                    <span className=\"font-bold block\">Analysis Failed</span>\n                    <span>{explainError}</span>\n                  </div>\n                </div>\n              )}\n\n              {explanation && (\n                <div className=\"p-4 rounded-xl bg-surface-container border border-outline-variant/40 text-on-surface text-sm leading-relaxed whitespace-pre-wrap font-body-md shadow-sm\">\n                  {explanation}\n                </div>\n              )}\n            </div>\n\n            <div className=\"pt-4 border-t border-surface-container-high flex items-center justify-between\">\n              <span className=\"font-label-sm text-[10px] text-tertiary font-mono\">\n                AI explains. Physics decides.\n              </span>\n              <button\n                onClick={() => setExplainDrawerOpen(false)}\n                className=\"px-4 py-2 rounded-lg bg-surface-container hover:bg-surface-container-high text-xs font-mono text-on-surface cursor-pointer\"\n                type=\"button\"\n              >\n                Close\n              </button>\n            </div>\n          </div>\n        </div>\n      )}"
          replacement_content: "            {/* Tapping Rigid G-code Block Display (if tapping) */}\n            {process === \'tapping\' && results.gcodeBlock && (\n              <Card className=\"p-space-md border border-secondary/30 flex flex-col gap-2\">\n                <SectionHeader \n                  title=\"Fanuc Rigid Tapping Block (G84)\" \n                  icon=\"terminal\"\n                  actions={<span className=\"font-mono text-xs text-tertiary\">Tap Drill: <strong className=\"text-on-surface\">\303\230{results.tapDrillMm} mm</strong></span>}\n                  className=\"border-b-0 mb-0 pb-0\"\n                />\n                <div className=\"bg-surface-container-lowest p-space-md rounded-lg border border-outline-variant/30 font-mono text-sm text-secondary shadow-inner relative overflow-hidden\">\n                  <div className=\"absolute top-0 right-0 p-2 opacity-10\">\n                    <span className=\"material-symbols-outlined text-[48px]\">terminal</span>\n                  </div>\n                  <div className=\"relative z-10\">\n                    <div className=\"text-tertiary-container text-[10px] mb-1 uppercase tracking-widest\">G84 Rigid Cycle Output</div>\n                    <pre className=\"whitespace-pre-wrap\">{results.gcodeBlock}</pre>\n                  </div>\n                </div>\n              </Card>\n            )}\n\n            {/* Copilot Advice Card */}\n            <Card accent={results.powerZone === \'red\' ? \'red\' : results.powerZone === \'amber\' ? \'amber\' : \'cyan\'} className=\"p-space-lg flex flex-col gap-space-md\">\n              <div className=\"flex items-center gap-space-md\">\n                <div className=\"w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-secondary shadow-inner\">\n                  <span className=\"material-symbols-outlined text-[28px]\">psychology</span>\n                </div>\n                <div className=\"flex flex-col\">\n                  <h3 className=\"font-headline-sm text-headline-sm font-bold text-on-surface\">Copilot Advice</h3>\n                  <p className=\"font-body-sm text-body-sm text-tertiary\">Ask the process engineer to verify these parameters.</p>\n                </div>\n              </div>\n              <ButtonPrimary onClick={handleAskCopilot} icon=\"psychology\" className=\"w-full\">\n                Verify with Copilot Engineer\n              </ButtonPrimary>\n            </Card>\n          </div>\n        </div>\n      </div>\n\n      {/* Slide-out Side Drawer for \"Ask Copilot Why\" AI Explanation */}\n      <Drawer\n        isOpen={explainDrawerOpen}\n        onClose={() => setExplainDrawerOpen(false)}\n        title=\"Copilot Process Analysis\"\n        footer={\n          <div className=\"flex items-center justify-between w-full\">\n            <span className=\"font-label-sm text-[10px] text-tertiary font-mono uppercase\">AI explains. Physics decides.</span>\n            <ButtonSecondary onClick={() => setExplainDrawerOpen(false)}>Close</ButtonSecondary>\n          </div>\n        }\n      >\n        <div className=\"flex flex-col gap-space-md\">\n          {/* Engine Summary Banner */}\n          <div className=\"p-3 rounded-lg bg-surface-container border border-outline-variant/30 text-xs font-mono space-y-1\">\n            <div className=\"flex justify-between\">\n              <span className=\"text-tertiary\">Material:</span>\n              <span className=\"text-on-surface font-semibold\">{material.name}</span>\n            </div>\n            <div className=\"flex justify-between\">\n              <span className=\"text-tertiary\">Spindle Load:</span>\n              <span className={results.powerZone === \'red\' ? \'text-error font-bold\' : results.powerZone === \'amber\' ? \'text-primary-container font-bold\' : \'text-secondary font-bold\'}>\n                {results.powerPercent}% ({results.powerKw} kW)\n              </span>\n            </div>\n            <div className=\"flex justify-between\">\n              <span className=\"text-tertiary\">Speed Band:</span>\n              <span className=\"text-tertiary-fixed\">{vc} m/min (Recommended: {recRange.min}-{recRange.max})</span>\n            </div>\n          </div>\n\n          {/* AI Explanation Area */}\n          {explaining && (\n            <div className=\"py-12 flex flex-col items-center justify-center gap-3 text-secondary font-mono text-xs text-center\">\n              <div className=\"w-12 h-12 border-2 border-secondary border-t-transparent rounded-full animate-spin mb-2\" />\n              <span>Synthesizing Kienzle force and chip dynamics...</span>\n            </div>\n          )}\n\n          {explainError && (\n            <div className=\"p-4 rounded-lg bg-error-container/20 border border-error/30 text-error text-xs font-mono flex items-start gap-2\">\n              <span className=\"material-symbols-outlined text-[18px]\">error</span>\n              <div>\n                <span className=\"font-bold block\">Analysis Failed</span>\n                <span>{explainError}</span>\n              </div>\n            </div>\n          )}\n\n          {explanation && (\n            <div className=\"p-4 rounded-xl bg-surface-container border border-outline-variant/40 text-on-surface text-sm leading-relaxed whitespace-pre-wrap font-body-md shadow-sm\">\n              {explanation}\n            </div>\n          )}\n        </div>\n      </Drawer>\n    </div>\n  );\n}"
          start_line: 821
