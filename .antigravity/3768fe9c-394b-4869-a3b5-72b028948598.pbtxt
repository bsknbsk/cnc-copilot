    replacement_infos {
      original_chunk {
        target_content: "            {/* Core Physics Metrics Grid (2x2) */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-space-md\">\n              {/* Metric Card 1: Spindle Speed (n) */}\n              <div className=\"bg-surface-container rounded-xl p-space-md flex flex-col justify-between shadow-sm relative overflow-hidden group hover:bg-surface-container-high transition-colors border border-outline-variant/30\">\n                <div className=\"flex items-center justify-between mb-space-xs\">\n                  <span className=\"font-label-sm text-label-sm uppercase font-mono text-tertiary-container tracking-wider\">\n                    Spindle Speed (n)\n                  </span>\n                  <span className=\"px-space-xs py-0.5 rounded bg-secondary/15 text-secondary font-label-sm text-label-sm font-mono font-semibold\">\n                    {Math.round((results.rpm / maxSpindleRpm) * 100)}% Cap\n                  </span>\n                </div>\n                <div className=\"flex items-baseline gap-space-xs my-space-xs\">\n                  <span className=\"font-code-lg text-[32px] leading-none font-bold text-on-surface tracking-tight\">\n                    {results.rpm.toLocaleString()}\n                  </span>\n                  <span className=\"font-label-md text-label-md font-mono text-tertiary\">RPM</span>\n                </div>\n                <div className=\"flex items-center justify-between pt-space-xs text-tertiary-container font-label-sm text-label-sm font-mono\">\n                  <span>\n                    Vc = {vc} m/min \342\200\242 Dc = {diameter}mm\n                  </span>\n                  <span className=\"text-secondary font-semibold\">\n                    {results.rpm > maxSpindleRpm ? \'EXCEEDS CAPACITY\' : \'Axis Safe\'}\n                  </span>\n                </div>\n              </div>\n\n              {/* Metric Card 2: Feed Rate (Vf) */}\n              <div className=\"bg-surface-container rounded-xl p-space-md flex flex-col justify-between shadow-sm relative overflow-hidden group hover:bg-surface-container-high transition-colors border border-outline-variant/30\">\n                <div className=\"flex items-center justify-between mb-space-xs\">\n                  <span className=\"font-label-sm text-label-sm uppercase font-mono text-tertiary-container tracking-wider\">\n                    Feed Rate (Vf)\n                  </span>\n                  <span className=\"px-space-xs py-0.5 rounded bg-surface-container-low text-tertiary font-label-sm text-label-sm font-mono\">\n                    h: {results.chipThickness}mm\n                  </span>\n                </div>\n                <div className=\"flex items-baseline gap-space-xs my-space-xs\">\n                  <span className=\"font-code-lg text-[32px] leading-none font-bold text-on-surface tracking-tight\">\n                    {isMetric ? results.feedRate.toLocaleString() : (results.feedRate / 25.4).toFixed(1)}\n                  </span>\n                  <span className=\"font-label-md text-label-md font-mono text-tertiary\">\n                    {isMetric ? \'mm/min\' : \'IPM\'}\n                  </span>\n                </div>\n                <div className=\"flex items-center justify-between pt-space-xs text-tertiary-container font-label-sm text-label-sm font-mono\">\n                  <span>\n                    {process === \'milling\' ? `z = ${flutes} teeth` : `Single edge`} \342\200\242{\' \'}\n                    {(results.feedRate / 60).toFixed(1)} mm/s\n                  </span>\n                  <span className=\"text-on-surface\">Axis Limit Safe</span>\n                </div>\n              </div>\n\n              {/* Metric Card 3: Material Removal Rate (MRR) */}\n              <div className=\"bg-surface-container rounded-xl p-space-md flex flex-col justify-between shadow-sm relative overflow-hidden group hover:bg-surface-container-high transition-colors border border-outline-variant/30\">\n                <div className=\"flex items-center justify-between mb-space-xs\">\n                  <span className=\"font-label-sm text-label-sm uppercase font-mono text-tertiary-container tracking-wider\">\n                    Material Removal Rate (MRR)\n                  </span>\n                  <span className=\"px-space-xs py-0.5 rounded bg-primary-container/20 text-primary-container font-label-sm text-label-sm font-mono font-bold\">\n                    High Efficiency\n                  </span>\n                </div>\n                <div className=\"flex items-baseline gap-space-xs my-space-xs\">\n                  <span className=\"font-code-lg text-[32px] leading-none font-bold text-primary-container tracking-tight\">\n                    {formatMrr(results.mrr).split(\' \')[0]}\n                  </span>\n                  <span className=\"font-label-md text-label-md font-mono text-tertiary\">\n                    {isMetric ? \'cm\302\263/min\' : \'in\302\263/min\'}\n                  </span>\n                </div>\n                <div className=\"flex items-center justify-between pt-space-xs text-tertiary-container font-label-sm text-label-sm font-mono\">\n                  <span>\n                    {process === \'milling\' ? `ap: ${ap}mm \303\227 ae: ${ae}mm` : `ap: ${ap || 2}mm`}\n                  </span>\n                  <span className=\"text-primary-container font-semibold\">\n                    {Math.round((results.mrr * 60) / 1000)} dm\302\263/hr\n                  </span>\n                </div>\n              </div>\n\n              {/* Metric Card 4: Spindle Torque (Mc) or Ra for Turning */}\n              <div className=\"bg-surface-container rounded-xl p-space-md flex flex-col justify-between shadow-sm relative overflow-hidden group hover:bg-surface-container-high transition-colors border border-outline-variant/30\">\n                <div className=\"flex items-center justify-between mb-space-xs\">\n                  <span className=\"font-label-sm text-label-sm uppercase font-mono text-tertiary-container tracking-wider\">\n                    {process === \'turning\' || process === \'boring\'\n                      ? \'Surface Finish (Ra)\'\n                      : process === \'drilling\'\n                      ? \'Drill Thrust (Ff)\'\n                      : \'Spindle Torque\'}\n                  </span>\n                  <span className=\"px-space-xs py-0.5 rounded bg-surface-container-low text-tertiary font-label-sm text-label-sm font-mono\">\n                    {process === \'turning\' || process === \'boring\'\n                      ? \'Nose r: 0.8mm\'\n                      : process === \'drilling\'\n                      ? \'Point: 140\302\260\'\n                      : \'Rated: 42 N\302\267m max\'}\n                  </span>\n                </div>\n                <div className=\"flex items-baseline gap-space-xs my-space-xs\">\n                  <span className=\"font-code-lg text-[32px] leading-none font-bold text-on-surface tracking-tight\">\n                    {process === \'turning\' || process === \'boring\'\n                      ? results.raUm\n                      : process === \'drilling\'\n                      ? results.thrustForceN\n                      : results.torqueNm}\n                  </span>\n                  <span className=\"font-label-md text-label-md font-mono text-tertiary\">\n                    {process === \'turning\' || process === \'boring\'\n                      ? \'\302\265m Ra\'\n                      : process === \'drilling\'\n                      ? \'N\'\n                      : isMetric\n                      ? \'N\302\267m\'\n                      : \'ft\302\267lb\'}\n                  </span>\n                </div>\n                <div className=\"flex items-center justify-between pt-space-xs text-tertiary-container font-label-sm text-label-sm font-mono\">\n                  <span>\n                    {process === \'turning\' || process === \'boring\'\n                      ? `Cycle: ${results.cycleTimeMin} min`\n                      : \'Low Thermal Strain\'}\n                  </span>\n                  <span className=\"text-secondary font-semibold\">\n                    {process === \'turning\' || process === \'boring\' ? \'Iso Finish N7\' : \'19.5% Curve\'}\n                  </span>\n                </div>\n              </div>\n            </div>"
        replacement_content: "            {/* Core Physics Metrics Grid (2x2) */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-space-md\">\n              {/* Metric Card 1: Spindle Speed (n) */}\n              <Card className=\"p-space-md flex flex-col justify-between\">\n                <SectionHeader \n                  title=\"Spindle Speed (n)\" \n                  actions={<Badge variant=\"secondary\">{Math.round((results.rpm / maxSpindleRpm) * 100)}% Cap</Badge>}\n                  className=\"border-b-0 mb-0 pb-0\"\n                />\n                <div className=\"flex items-baseline gap-space-xs my-space-xs\">\n                  <span className=\"font-code-lg text-[32px] leading-none font-bold text-on-surface tracking-tight\">\n                    {results.rpm.toLocaleString()}\n                  </span>\n                  <span className=\"font-label-md text-label-md font-mono text-tertiary\">RPM</span>\n                </div>\n                <div className=\"flex items-center justify-between pt-space-xs text-tertiary-container font-label-sm text-label-sm font-mono\">\n                  <span>Vc = {vc} m/min \342\200\242 Dc = {diameter}mm</span>\n                  <span className=\"text-secondary font-semibold\">\n                    {results.rpm > maxSpindleRpm ? \'EXCEEDS CAPACITY\' : \'Axis Safe\'}\n                  </span>\n                </div>\n              </Card>\n\n              {/* Metric Card 2: Feed Rate (Vf) */}\n              <Card className=\"p-space-md flex flex-col justify-between\">\n                <SectionHeader \n                  title=\"Feed Rate (Vf)\" \n                  actions={<Badge variant=\"tertiary\">h: {results.chipThickness}mm</Badge>}\n                  className=\"border-b-0 mb-0 pb-0\"\n                />\n                <div className=\"flex items-baseline gap-space-xs my-space-xs\">\n                  <span className=\"font-code-lg text-[32px] leading-none font-bold text-on-surface tracking-tight\">\n                    {isMetric ? results.feedRate.toLocaleString() : (results.feedRate / 25.4).toFixed(1)}\n                  </span>\n                  <span className=\"font-label-md text-label-md font-mono text-tertiary\">\n                    {isMetric ? \'mm/min\' : \'IPM\'}\n                  </span>\n                </div>\n                <div className=\"flex items-center justify-between pt-space-xs text-tertiary-container font-label-sm text-label-sm font-mono\">\n                  <span>{process === \'milling\' ? `z = ${flutes} teeth` : `Single edge`} \342\200\242 {(results.feedRate / 60).toFixed(1)} mm/s</span>\n                  <span className=\"text-on-surface\">Axis Limit Safe</span>\n                </div>\n              </Card>\n\n              {/* Metric Card 3: Material Removal Rate (MRR) */}\n              <Card className=\"p-space-md flex flex-col justify-between\">\n                <SectionHeader \n                  title=\"Material Removal Rate\" \n                  actions={<Badge variant=\"primary\">High Efficiency</Badge>}\n                  className=\"border-b-0 mb-0 pb-0\"\n                />\n                <div className=\"flex items-baseline gap-space-xs my-space-xs\">\n                  <span className=\"font-code-lg text-[32px] leading-none font-bold text-primary-container tracking-tight\">\n                    {formatMrr(results.mrr).split(\' \')[0]}\n                  </span>\n                  <span className=\"font-label-md text-label-md font-mono text-tertiary\">\n                    {isMetric ? \'cm\302\263/min\' : \'in\302\263/min\'}\n                  </span>\n                </div>\n                <div className=\"flex items-center justify-between pt-space-xs text-tertiary-container font-label-sm text-label-sm font-mono\">\n                  <span>{process === \'milling\' ? `ap: ${ap}mm \303\227 ae: ${ae}mm` : `ap: ${ap || 2}mm`}</span>\n                  <span className=\"text-primary-container font-semibold\">\n                    {Math.round((results.mrr * 60) / 1000)} dm\302\263/hr\n                  </span>\n                </div>\n              </Card>\n\n              {/* Metric Card 4: Spindle Torque (Mc) */}\n              <Card className=\"p-space-md flex flex-col justify-between\">\n                <SectionHeader \n                  title={process === \'turning\' || process === \'boring\' ? \'Surface Finish (Ra)\' : process === \'drilling\' ? \'Drill Thrust (Ff)\' : \'Spindle Torque\'}\n                  actions={<Badge variant=\"tertiary\">{process === \'turning\' || process === \'boring\' ? \'Nose r: 0.8mm\' : \'Rated: 42 N\302\267m\'}</Badge>}\n                  className=\"border-b-0 mb-0 pb-0\"\n                />\n                <div className=\"flex items-baseline gap-space-xs my-space-xs\">\n                  <span className=\"font-code-lg text-[32px] leading-none font-bold text-on-surface tracking-tight\">\n                    {process === \'turning\' || process === \'boring\' ? results.raUm : process === \'drilling\' ? results.thrustForceN : results.torqueNm}\n                  </span>\n                  <span className=\"font-label-md text-label-md font-mono text-tertiary\">\n                    {process === \'turning\' || process === \'boring\' ? \'\302\265m Ra\' : process === \'drilling\' ? \'N\' : isMetric ? \'N\302\267m\' : \'ft\302\267lb\'}\n                  </span>\n                </div>\n                <div className=\"flex items-center justify-between pt-space-xs text-tertiary-container font-label-sm text-label-sm font-mono\">\n                  <span>{process === \'turning\' || process === \'boring\' ? `Cycle: ${results.cycleTimeMin} min` : \'Low Thermal Strain\'}</span>\n                  <span className=\"text-secondary font-semibold\">\n                    {process === \'turning\' || process === \'boring\' ? \'Iso Finish N7\' : \'19.5% Curve\'}\n                  </span>\n                </div>\n              </Card>\n            </div>"
        start_line: 690
        end_line: 819
      }
      use_global_match: true
    }
    description: "Refactor CuttingCalculator input and results panels to use Card, SectionHeader, Badge, and StatChip components"
    diff_stats {
