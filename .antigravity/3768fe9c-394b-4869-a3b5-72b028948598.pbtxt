              text: "  material: MaterialSpec;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  toolMaterial: ToolMaterialType;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  diameter: number; // D (mm)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  flutes: number;   // z (teeth)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  vc: number;       // Vc (m/min)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  feed: number;     // fz (mm/tooth) for milling, fn (mm/rev) for turning/drilling/boring, pitch P for tapping"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ap?: number;      // Axial depth of cut (mm)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ae?: number;      // Radial width of cut (mm)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  depth?: number;   // Hole/cut length L (mm)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  machineMaxKw: number; // kW"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  eta?: number;     // Spindle mechanical efficiency, default 0.8"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  krDeg?: number;   // Tool lead angle for turning/boring, default 95 deg"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  noseRadius?: number; // Tool nose radius r for turning/boring (mm), default 0.8"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  pointAngleDeg?: number; // Drill point angle, default 140 deg"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  overhang?: number; // Boring bar stickout (mm)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  tapType?: TapType; // Cutting or forming tap"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  isImperial?: boolean; // For display formatting"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export interface CuttingValidation {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  isValid: boolean;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  errors: string[];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  warnings: string[];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export interface CuttingResults {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  process: ProcessType;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  rpm: number;           // n (RPM)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  feedRate: number;      // vf (mm/min)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  mrr: number;           // Q (cm3/min)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  powerKw: number;       // Pc (kW)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  torqueNm: number;      // Mc (Nm)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  powerPercent: number;  // Pc / machineMaxKw * 100"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  powerZone: \'green\' | \'amber\' | \'red\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  chipThickness: number; // h or hm (mm)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  specificForce: number; // kc (N/mm2)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  tangentialForce: number; // Ft (N)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Process-specific outputs"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  raUm?: number;         // Theoretical surface roughness Ra (micrometre) for turning/boring"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  thrustForceN?: number; // Ff (N) for drilling"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  cycleTimeMin?: number; // Cycle time (min) for turning/drilling/boring"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  tapDrillMm?: number;   // Tap drill diameter (mm)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  gcodeBlock?: string[]; // G-code rigid tapping block"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  validation: CuttingValidation;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function validateCuttingInputs(inputs: CuttingInputs): CuttingValidation {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const errors: string[] = [];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const warnings: string[] = [];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (inputs.diameter <= 0 || isNaN(inputs.diameter)) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    errors.push(\'Tool diameter must be greater than 0 mm\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (inputs.vc <= 0 || isNaN(inputs.vc)) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    errors.push(\'Cutting speed (Vc) must be greater than 0 m/min\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (inputs.feed <= 0 || isNaN(inputs.feed)) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    errors.push(\'Feed must be greater than 0\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (inputs.process === \'milling\' && (!inputs.flutes || inputs.flutes < 1)) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    errors.push(\'Number of flutes must be at least 1\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (inputs.machineMaxKw <= 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    errors.push(\'Machine spindle motor power must be greater than 0 kW\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Check speed vs recommended band"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const rec = inputs.toolMaterial === \'carbide\' ? inputs.material.carbide : inputs.material.hss;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (inputs.vc > rec.vc.max) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    warnings.push(`Surface speed ${inputs.vc} m/min exceeds recommended ${inputs.toolMaterial.toUpperCase()} limit (${rec.vc.max} m/min) for ${inputs.material.name}. Increased tool wear/thermal breakdown risk.`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  } else if (inputs.vc < rec.vc.min) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    warnings.push(`Surface speed ${inputs.vc} m/min is below optimal range (${rec.vc.min}-${rec.vc.max} m/min). Risk of built-up edge (BUE).`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Process specific physical warnings"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (inputs.process === \'boring\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const barDia = inputs.diameter;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const overhang = inputs.overhang || inputs.depth || 50;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (overhang / barDia > 4) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      warnings.push(`Overhang-to-diameter ratio is ${(overhang / barDia).toFixed(1)}xD (>4xD). Above 4xD use a damped bar or reduce Vc and ap to avoid severe chatter.`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (inputs.process === \'drilling\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const depth = inputs.depth || 30;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    if (depth / inputs.diameter > 5) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      warnings.push(`Hole depth is ${(depth / inputs.diameter).toFixed(1)}xD (>5xD). Use peck drilling cycle (G83) or a through-coolant drill to evacuate chips safely.`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    isValid: errors.length === 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    errors,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    warnings,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function calculateCutting(inputs: CuttingInputs): CuttingResults {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const validation = validateCuttingInputs(inputs);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (!validation.isValid) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      process: inputs.process,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      rpm: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      feedRate: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      mrr: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      powerKw: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      torqueNm: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      powerPercent: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      powerZone: \'green\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      chipThickness: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      specificForce: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      tangentialForce: 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      validation,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const eta = inputs.eta ?? 0.8;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const D = inputs.diameter;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const Vc = inputs.vc;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const kc1 = inputs.material.kc1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const mc = inputs.material.mc;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // 1. Spindle speed n (rpm) = (1000 x Vc) / (pi x D)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const rpm = Math.round((1000 * Vc) / (Math.PI * D));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let feedRate = 0;      // vf (mm/min)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let mrr = 0;           // Q (cm3/min)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let h = 0.08;          // Chip thickness (mm)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let powerKw = 0;       // Pc (kW)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let raUm: number | undefined;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let thrustForceN: number | undefined;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let cycleTimeMin: number | undefined;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let tapDrillMm: number | undefined;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let gcodeBlock: string[] | undefined;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  switch (inputs.process) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    case \'milling\': {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const z = inputs.flutes || 4;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const fz = inputs.feed;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const ap = inputs.ap ?? D;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const ae = inputs.ae ?? (D * 0.4);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Feed rate vf = fz x z x n"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      feedRate = Math.round(fz * z * rpm);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // MRR Q (cm3/min) = (ap x ae x vf) / 1000"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      mrr = Number(((ap * ae * feedRate) / 1000).toFixed(1));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Average chip thickness hm"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (ae / D <= 0.5) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        h = fz * Math.sqrt(ae / D);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      } else {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        h = fz;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      h = Math.max(0.005, h);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // kc (N/mm2) = kc1 x h^(-mc)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const kc = kc1 * Math.pow(h, -mc);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Pc (kW) = (ap x ae x vf x kc) / (60 x 10^6 x eta)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      powerKw = (ap * ae * feedRate * kc) / (60 * 1000000 * eta);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      break;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    case \'turning\':"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    case \'boring\': {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const fn = inputs.feed;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const ap = inputs.ap ?? 2.0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const kr = (inputs.krDeg ?? 95) * (Math.PI / 180);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const r = inputs.noseRadius ?? 0.8;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const L = inputs.depth ?? 100;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // vf = fn x n"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      feedRate = Math.round(fn * rpm);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // MRR Q = Vc x ap x fn"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      mrr = Number((Vc * ap * fn).toFixed(1));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // h = fn x sin(kr)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      h = Math.max(0.005, fn * Math.sin(kr));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // kc = kc1 x h^(-mc)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const kc = kc1 * Math.pow(h, -mc);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Pc = (Vc x ap x fn x kc) / (60 x 10^3 x eta)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      powerKw = (Vc * ap * fn * kc) / (60 * 1000 * eta);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Ra = (fn^2 / (8 x r)) x 1000"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      raUm = Number(((Math.pow(fn, 2) / (8 * r)) * 1000).toFixed(2));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Cycle time = L / vf"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      cycleTimeMin = feedRate > 0 ? Number((L / feedRate).toFixed(2)) : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      break;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    case \'drilling\': {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const fn = inputs.feed;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const pointAngle = (inputs.pointAngleDeg ?? 140) * (Math.PI / 180);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const L = inputs.depth ?? 40;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      feedRate = Math.round(fn * rpm);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Q = (Vc x D x fn) / 4"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      mrr = Number(((Vc * D * fn) / 4).toFixed(1));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // h = (fn / 2) x sin(pointAngle / 2)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      h = Math.max(0.005, (fn / 2) * Math.sin(pointAngle / 2));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // kc = kc1 x h^(-mc)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const kc = kc1 * Math.pow(h, -mc);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Pc = (fn x Vc x D x kc) / (240 x 10^3 x eta)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      powerKw = (fn * Vc * D * kc) / (240 * 1000 * eta);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Thrust Ff (N) ~ 0.5 x kc x (D / 2) x fn x sin(pointAngle / 2)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      thrustForceN = Math.round(0.5 * kc * (D / 2) * fn * Math.sin(pointAngle / 2));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      cycleTimeMin = feedRate > 0 ? Number((L / feedRate).toFixed(2)) : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      break;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    case \'tapping\': {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const pitch = inputs.feed; // Thread pitch P"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const tapType = inputs.tapType ?? \'cutting\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const L = inputs.depth ?? 20;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // vf = P x n"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      feedRate = Math.round(pitch * rpm);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Tap drill: cutting = D - P, forming = D - 0.5 x P"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      tapDrillMm = tapType === \'cutting\' ? Number((D - pitch).toFixed(2)) : Number((D - 0.5 * pitch).toFixed(2));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Equivalent chip thickness for thread flank"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      h = Math.max(0.01, pitch * 0.15);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const kc = kc1 * Math.pow(h, -mc);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Power Pc estimation for tapping"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      powerKw = ((D * pitch * feedRate * kc) / (200 * 1000000 * eta));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      mrr = Number(((Math.PI * Math.pow(D / 2, 2) * feedRate) / 1000).toFixed(1));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // Fanuc rigid tapping block: \"M29 S{n}\" then \"G84 Z-{L} R2.0 F{vf}\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      gcodeBlock = ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        `M29 S${rpm}`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        `G84 Z-${L.toFixed(1)} R2.0 F${feedRate}`,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      break;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Torque Mc (Nm) = (Pc x 30000) / (pi x n)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const torqueNm = rpm > 0 ? Number(((powerKw * 30000) / (Math.PI * rpm)).toFixed(1)) : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Tangential cutting force Ft = (Pc * 1000 * 60) / Vc"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const tangentialForce = Vc > 0 ? Math.round((powerKw * 60000) / Vc) : 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Specific force kc at h"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const specificForce = Math.round(kc1 * Math.pow(h, -mc));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Power percentage & color zone"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const powerPercent = Number(((powerKw / inputs.machineMaxKw) * 100).toFixed(1));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let powerZone: \'green\' | \'amber\' | \'red\' = \'green\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (powerPercent >= 90) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    powerZone = \'red\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    validation.warnings.push(`Cutting power (${powerKw.toFixed(1)} kW) exceeds 90% of machine limit (${inputs.machineMaxKw} kW). Spindle stall / thermal overload risk.`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  } else if (powerPercent >= 70) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    powerZone = \'amber\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    validation.warnings.push(`Cutting power (${powerKw.toFixed(1)} kW) is between 70% and 90% of continuous duty rating. Monitor chip evacuation and spindle temperature.`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    process: inputs.process,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    rpm,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    feedRate,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    mrr,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
