\": \"Operator Activity\",\n      \"description\": \"Recent actions taken by the operator across tools\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"type\": { \"type\": \"string\", \"enum\": [\"chat\", \"calc\", \"gcode\", \"academy\"] },\n        \"title\": { \"type\": \"string\" },\n        \"summary\": { \"type\": \"string\" },\n        \"link\": { \"type\": \"string\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"type\", \"title\", \"link\"]\n    },\n    \"AcademyProgress\": {\n      \"title\": \"Academy Progress\",\n      \"description\": \"Operator gamified training metrics and badges\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"xp\": { \"type\": \"number\" },\n        \"level\": { \"type\": \"string\" },\n        \"streakDays\": { \"type\": \"number\" },\n        \"lastActiveDate\": { \"type\": \"string\" },\n        \"badges\": { \"type\": \"array\" },\n        \"missions\": { \"type\": \"object\" }\n      },\n      \"required\": [\"xp\", \"level\", \"streakDays\"]\n    },\n    \"KnowledgeBaseDoc\": {\n      \"title\": \"Knowledge Base Document\",\n      \"description\": \"OEM manual or shop standard indexed in File Search\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"name\": { \"type\": \"string\" },\n        \"controller\": { \"type\": \"string\" },\n        \"docType\": { \"type\": \"string\", \"enum\": [\"Manual\", \"Shop Notes\", \"Parameter List\"] },\n        \"pages\": { \"type\": \"number\" },\n        \"status\": { \"type\": \"string\", \"enum\": [\"Indexing\", \"Ready\", \"Failed\"] },\n        \"fileSearchDocumentName\": { \"type\": \"string\" },\n        \"storagePath\": { \"type\": \"string\" },\n        \"uploadedBy\": { \"type\": \"string\" },\n        \"createdAt\": { \"type\": \"string\", \"format\": \"date-time\" }\n      },\n      \"required\": [\"name\", \"controller\", \"docType\", \"status\"]\n    }\n  }