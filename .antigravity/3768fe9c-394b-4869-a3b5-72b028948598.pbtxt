      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { AuthProvider, useAuth } from \'./context/AuthContext.js\';\nimport { Navigation } from \'./components/Navigation.js\';\nimport { LandingPage } from \'./components/LandingPage.js\';\nimport { Dashboard } from \'./components/Dashboard.js\';\nimport { Cpu, Calculator, FileCode, GraduationCap, BookOpen, AlertCircle } from \'lucide-react\';\n\nfunction AppContent() {\n  const { user, profile, loading, isAdmin } = useAuth();\n  const [currentTab, setCurrentTab] = useState<\'home\' | \'agent\' | \'calculator\' | \'gcode\' | \'academy\' | \'kb\'>(\'home\');\n  const [navigationState, setNavigationState] = useState<any>(null);\n\n  const handleNavigate = (tab: string, state?: any) => {\n    setCurrentTab(tab as any);\n    setNavigationState(state || null);\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  if (loading) {\n    return (\n      <div className=\"min-h-screen bg-[#0B0F14] flex flex-col items-center justify-center gap-4 text-[#8B98A5]\">\n        <div className=\"w-12 h-12 rounded-xl bg-white/5 border border-[#1F2A37] flex items-center justify-center text-[#FF7A1A] animate-spin\">\n          <div className=\"w-6 h-6 border-2 border-[#FF7A1A] border-t-transparent rounded-full\" />\n        </div>\n        <div className=\"flex flex-col items-center gap-1\">\n          <span className=\"font-mono text-xs uppercase tracking-wider text-[#E6EDF3]\">Connecting Kinematic Link</span>\n          <span className=\"text-[11px] font-mono text-[#8B98A5]\">Verifying Firebase credentials...</span>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-[#0B0F14] text-[#E6EDF3] flex flex-col\">\n      <Navigation currentTab={currentTab} onSelectTab={handleNavigate} />\n\n      <main className=\"flex-1 pt-16\">\n        {currentTab === \'home\' && (\n          user ? <Dashboard onNavigate={handleNavigate} /> : <LandingPage />\n        )}\n\n        {currentTab === \'agent\' && (\n          <div className=\"max-w-7xl mx-auto px-4 py-8\">\n            <div className=\"glass-panel p-8 text-center flex flex-col items-center justify-center gap-4\">\n              <div className=\"w-16 h-16 rounded-2xl bg-[#FF7A1A]/10 border border-[#FF7A1A]/30 flex items-center justify-center text-[#FF7A1A]\">\n                <Cpu className=\"w-8 h-8\" />\n              </div>\n              <h2 className=\"text-xl font-bold text-white\">Shopfloor Agent</h2>\n              <p className=\"text-sm text-[#8B98A5] max-w-md\">\n                Voice, camera diagnostics, and manual grounding are scheduled in Milestone 3.\n              </p>\n              <button\n                onClick={() => setCurrentTab(\'home\')}\n                className=\"px-4 py-2 rounded-xl bg-white/5 border border-[#1F2A37] text-xs font-mono text-white hover:bg-white/10\"\n              >\n                Return to Dashboard\n              </button>\n            </div>\n          </div>\n        )}\n\n        {currentTab === \'calculator\' && (\n          <div className=\"max-w-7xl mx-auto px-4 py-8\">\n            <div className=\"glass-panel p-8 text-center flex flex-col items-center justify-center gap-4\">\n              <div className=\"w-16 h-16 rounded-2xl bg-[#22D3EE]/10 border border-[#22D3EE]/30 flex items-center justify-center text-[#22D3EE]\">\n                <Calculator className=\"w-8 h-8\" />\n              </div>\n              <h2 className=\"text-xl font-bold text-white\">Cutting Calculator</h2>\n              <p className=\"text-sm text-[#8B98A5] max-w-md\">\n                Deterministic Kienzle cutting physics engine and Live 3D tool contact simulation are scheduled in Milestone 2.\n              </p>\n              <button\n                onClick={() => setCurrentTab(\'home\')}\n                className=\"px-4 py-2 rounded-xl bg-white/5 border border-[#1F2A37] text-xs font-mono text-white hover:bg-white/10\"\n              >\n                Return to Dashboard\n              </button>\n            </div>\n          </div>\n        )}\n\n        {currentTab === \'gcode\' && (\n          <div className=\"max-w-7xl mx-auto px-4 py-8\">\n            <div className=\"glass-panel p-8 text-center flex flex-col items-center justify-center gap-4\">\n              <div className=\"w-16 h-16 rounded-2xl bg-[#22C55E]/10 border border-[#22C55E]/30 flex items-center justify-center text-[#22C55E]\">\n                <FileCode className=\"w-8 h-8\" />\n              </div>\n              <h2 className=\"text-xl font-bold text-white\">G-code Verifier</h2>\n              <p className=\"text-sm text-[#8B98A5] max-w-md\">\n                Deterministic modal parser and 3D toolpath backplot verification are scheduled in Milestone 5.\n              </p>\n              <button\n                onClick={() => setCurrentTab(\'home\')}\n                className=\"px-4 py-2 rounded-xl bg-white/5 border border-[#1F2A37] text-xs font-mono text-white hover:bg-white/10\"\n              >\n                Return to Dashboard\n              </button>\n            </div>\n          </div>\n        )}\n\n        {currentTab === \'academy\' && (\n          <div className=\"max-w-7xl mx-auto px-4 py-8\">\n            <div className=\"glass-panel p-8 text-center flex flex-col items-center justify-center gap-4\">\n              <div className=\"w-16 h-16 rounded-2xl bg-[#F59E0B]/10 border border-[#F59E0B]/30 flex items-center justify-center text-[#F59E0B]\">\n                <GraduationCap className=\"w-8 h-8\" />\n              </div>\n              <h2 className=\"text-xl font-bold text-white\">Operator Academy & Crash Lab</h2>\n              <p className=\"text-sm text-[#8B98A5] max-w-md\">\n                Kinematic crash engine, 4 mission challenges, and AI instructor hints are scheduled in Milestone 6.\n              </p>\n              <button\n                onClick={() => setCurrentTab(\'home\')}\n                className=\"px-4 py-2 rounded-xl bg-white/5 border border-[#1F2A37] text-xs font-mono text-white hover:bg-white/10\"\n              >\n                Return to Dashboard\n              </button>\n            </div>\n          </div>\n        )}\n\n        {currentTab === \'kb\' && (\n          <div className=\"max-w-7xl mx-auto px-4 py-8\">\n            {!isAdmin ? (\n              <div className=\"glass-panel p-8 text-center flex flex-col items-center justify-center gap-4 text-[#EF4444]\">\n                <AlertCircle className=\"w-10 h-10\" />\n                <h2 className=\"text-xl font-bold\">Access Restricted</h2>\n                <p className=\"text-sm text-[#8B98A5]\">Knowledge Base is restricted to authorized workshop administrators.</p>\n                <button\n                  onClick={() => setCurrentTab(\'home\')}\n                  className=\"px-4 py-2 rounded-xl bg-white/5 border border-[#1F2A37] text-xs font-mono text-white\"\n                >\n                  Go to Dashboard\n                </button>\n              </div>\n            ) : (\n              <div className=\"glass-panel p-8 text-center flex flex-col items-center justify-center gap-4\">\n                <div className=\"w-16 h-16 rounded-2xl bg-[#22D3EE]/10 border border-[#22D3EE]/30 flex items-center justify-center text-[#22D3EE]\">\n                  <BookOpen className=\"w-8 h-8\" />\n                </div>\n                <h2 className=\"text-xl font-bold text-white\">Knowledge Base & Manual Indexer</h2>\n                <p className=\"text-sm text-[#8B98A5] max-w-md\">\n                  File Search multi-format upload, PDF chunking, and semantic test simulator are scheduled in Milestone 4.\n                </p>\n                <button\n                  onClick={() => setCurrentTab(\'home\')}\n                  className=\"px-4 py-2 rounded-xl bg-white/5 border border-[#1F2A37] text-xs font-mono text-white hover:bg-white/10\"\n                >\n                  Return to Dashboard\n                </button>\n              </div>\n            )}\n          </div>\n        )}\n      </main>\n    </div>\n  );\n}\n\nexport default function App() {\n  return (\n    <AuthProvider>\n      <AppContent />\n    </AuthProvider>\n  );\n}\n"
