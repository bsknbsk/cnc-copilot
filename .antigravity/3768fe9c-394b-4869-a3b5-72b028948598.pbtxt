urface-container-low p-6 rounded-xl border border-outline-variant/30 flex flex-col justify-between shadow-md\">\n            <div className=\"flex flex-col gap-4\">\n              <div className=\"w-12 h-12 rounded-xl bg-secondary/10 border border-secondary/30 flex items-center justify-center text-secondary\">\n                <span className=\"material-symbols-outlined text-[28px]\">calculate</span>\n              </div>\n              <div>\n                <h3 className=\"text-lg font-bold text-on-surface mb-1\">Cutting Calculator</h3>\n                <p className=\"text-sm text-tertiary leading-relaxed\">\n                  Rigorous Kienzle force and chip thickness math for milling, turning, drilling, and tapping. Real-time machine power gauge and torque limits.\n                </p>\n              </div>\n            </div>\n            <div className=\"mt-6 pt-4 border-t border-outline-variant/30 flex items-center justify-between text-xs font-mono text-secondary\">\n              <span>Physics Engine \342\200\242 Zero Guesswork</span>\n              <span className=\"material-symbols-outlined text-[16px]\">arrow_forward</span>\n            </div>\n          </div>\n\n          {/* Card 3: G-code Verifier */}\n          <div className=\"bg-surface-container-low p-6 rounded-xl border border-outline-variant/30 flex flex-col justify-between shadow-md\">\n            <div className=\"flex flex-col gap-4\">\n              <div className=\"w-12 h-12 rounded-xl bg-secondary-fixed/10 border border-secondary-fixed/30 flex items-center justify-center text-secondary-fixed\">\n                <span className=\"material-symbols-outlined text-[28px]\">terminal</span>\n              </div>\n              <div>\n                <h3 className=\"text-lg font-bold text-on-surface mb-1\">G-code Verifier</h3>\n                <p className=\"text-sm text-tertiary leading-relaxed\">\n                  Deterministic syntax & motion parser with 3D kinematic backplot. Catches rapid plunges into stock, missing G43 offsets, and spindle-off feeds.\n                </p>\n              </div>"
