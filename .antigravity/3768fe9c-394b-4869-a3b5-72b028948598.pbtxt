  view_file {
    absolute_path_uri: "file:///server/authMiddleware.ts"
    start_line: 34
    end_line: 94
    content: "\n  try {\n    const decoded = await adminAuth.verifyIdToken(idToken);\n    const email = (decoded.email || \'\').toLowerCase();\n    const isAdmin = ADMIN_EMAILS.includes(email);\n    const role: \'user\' | \'admin\' = isAdmin ? \'admin\' : \'user\';\n\n    // Check or create user document in Firestore\n    const userRef = adminDb.collection(\'users\').doc(decoded.uid);\n    let userSnap;\n    try {\n      userSnap = await userRef.get();\n    } catch (e) {\n      console.warn(\'[authMiddleware] Firestore get user warning:\', e);\n    }\n\n    let preferredLanguage: \'en\' | \'hi\' | \'ml\' | \'ta\' = \'en\';\n    let preferredController: \'fanuc\' | \'mitsubishi\' | \'generic\' = \'fanuc\';\n\n    if (!userSnap || !userSnap.exists) {\n      // First sign-in: create user profile\n      const newUser = {\n        displayName: decoded.name || decoded.email?.split(\'@\')[0] || \'Operator\',\n        email: decoded.email || \'\',\n        photoURL: decoded.picture || \'\',\n        preferredLanguage: \'en\',\n        preferredController: \'fanuc\',\n        role,\n        createdAt: new Date().toISOString(),\n      };\n      try {\n        await userRef.set(newUser, { merge: true });\n      } catch (err) {\n        console.warn(\'[authMiddleware] Could not write user doc:\', err);\n      }\n    } else {\n      const data = userSnap.data();\n      preferredLanguage = data?.preferredLanguage || \'en\';\n      preferredController = data?.preferredController || \'fanuc\';\n\n      // Ensure role matches current ADMIN_EMAILS definition\n      if (data?.role !== role) {\n        try {\n          await userRef.update({ role });\n        } catch (err) {\n          console.warn(\'[authMiddleware] Could not update user role:\', err);\n        }\n      }\n    }\n\n    req.user = {\n      uid: decoded.uid,\n      email,\n      role,\n      displayName: decoded.name || \'Operator\',\n      photoURL: decoded.picture || \'\',\n      preferredLanguage,\n      preferredController,\n    };\n\n    next();"
    num_lines: 109
    num_bytes: 3369
    line_range_bytes: 1901
  }
}
