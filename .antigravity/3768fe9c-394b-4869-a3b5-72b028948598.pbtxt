      arguments_json: "{\"CodeContent\":\"import { Router } from \'express\';\\nimport { requireAuth } from \'../authMiddleware.js\';\\nimport { adminDb } from \'../firebase.js\';\\n\\nexport const userRouter = Router();\\n\\nuserRouter.use(requireAuth);\\n\\nuserRouter.get(\'/me\', async (req, res) => {\\n  try {\\n    const uid = req.user!.uid;\\n    const userDoc = await adminDb.collection(\'users\').doc(uid).get();\\n    if (!userDoc.exists) {\\n      res.json(req.user);\\n      return;\\n    }\\n    res.json({ ...req.user, ...userDoc.data() });\\n  } catch (err: any) {\\n    res.status(500).json({ error: \'failed_to_fetch_profile\', message: err.message });\\n  }\\n});\\n\\nuserRouter.patch(\'/preferences\', async (req, res) => {\\n  try {\\n    const uid = req.user!.uid;\\n    const { preferredLanguage, preferredController } = req.body;\\n    const updates: Record<string, any> = {};\\n\\n    if (preferredLanguage && [\'en\', \'hi\', \'ml\', \'ta\'].includes(preferredLanguage)) {\\n      updates.preferredLanguage = preferredLanguage;\\n    }\\n    if (preferredController && [\'fanuc\', \'mitsubishi\', \'generic\'].includes(preferredController)) {\\n      updates.preferredController = preferredController;\\n    }\\n\\n    if (Object.keys(updates).length > 0) {\\n      await adminDb.collection(\'users\').doc(uid).set(updates, { merge: true });\\n    }\\n\\n    res.json({ success: true, updates });\\n  } catch (err: any) {\\n    res.status(500).json({ error: \'failed_to_update_preferences\', message: err.message });\\n  }\\n});\\n\\nuserRouter.get(\'/activity\', async (req, res) => {\\n  try {\\n    const uid = req.user!.uid;\\n    const snap = await adminDb\\n      .collection(\'users\')\\n      .doc(uid)\\n      .collection(\'activity\')\\n      .orderBy(\'createdAt\', \'desc\')\\n      .limit(5)\\n      .get();\\n\\n    const items = snap.docs.map(doc => ({ id: doc.id, ...doc.data() }));\\n    res.json(items);\\n  } catch (err: any) {\\n    console.warn(\'[userRouter] Activity fetch warning:\', err?.message);\\n    res.json([]);\\n  }\\n});\\n\",\"Description\":\"Create /server/routes/user.ts for user profile and preferences\",\"Overwrite\":true,\"TargetFile\":\"/server/routes/user.ts\",\"toolAction\":\"Creating /server/routes/user.ts\",\"toolSummary\":\"Create user route\"}"
