    content: "  };\n\n  // Trigger Copilot Explain API\n  const handleAskCopilot = async () => {\n    setExplainDrawerOpen(true);\n    setExplaining(true);\n    setExplainError(null);\n    setExplanation(null);\n\n    try {\n      const res = await apiFetch(\'/api/explain\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          inputs,\n          results,\n          language: profile?.preferredLanguage || \'en\',\n        }),\n      });\n\n      if (!res.ok) {\n        const errJson = await res.json().catch(() => ({}));\n        throw new Error(errJson.message || \'Failed to explain cutting parameters\');\n      }\n\n      const data = await res.json();\n      setExplanation(data.explanation);\n    } catch (err: any) {\n      console.error(\'[CuttingCalculator] Explain error:\', err);\n      setExplainError(err.message || \'Could not reach Copilot process engineer.\');\n    } finally {\n      setExplaining(false);\n    }\n  };\n\n  return (\n    <div className=\"w-full px-margin py-margin\">\n      <div className=\"flex flex-col w-full\">\n        {/* Top Process Tabs Bar */}\n        <div className=\"w-full bg-surface-container-low rounded-xl px-space-md py-space-xs flex items-center justify-between mb-space-lg shadow-sm border border-outline-variant/30\">\n          <div className=\"flex items-center gap-space-xs overflow-x-auto\">\n            <button\n              onClick={() => {\n                setProcess(\'milling\');\n                setFeed(0.08);\n              }}"
    num_lines: 1002
    num_bytes: 53455
    line_range_bytes: 1495
  }
