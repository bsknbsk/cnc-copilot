    tool_calls {
      id: "call_1200475"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Refactor GCodeVerifier to use CodeEditor and Viewport3D components\",\"Instruction\":\"Replace the manual G-code editor and 3D canvas implementation with shared UI components.\",\"ReplacementChunks\":[{\"AllowMultiple\":false,\"EndLine\":786,\"ReplacementContent\":\"              <div className=\\\"flex-1 min-h-[500px]\\\">\\n                <CodeEditor\\n                  code={gcodeText}\\n                  onChange={(code) => {\\n                    setGcodeText(code);\\n                    setActivePresetId(\'\');\\n                  }}\\n                  onLineClick={jumpToLine}\\n                  selectedLine={selectedFindingLine}\\n                  flaggedLines={Array.from(criticalFindingLines)}\\n                  language=\\\"gcode\\\"\\n                />\\n              </div>\\n\",\"StartLine\":733,\"TargetContent\":\"              <div className=\\\"flex-1 flex overflow-hidden min-h-[500px]\\\" id=\\\"gcode-editor-container\\\">\\n                {/* Line Number Gutter */}\\n                <div className=\\\"w-12 bg-surface-container-low border-r border-outline-variant/20 select-none flex flex-col py-3 overflow-hidden text-right pr-2 text-outline/60\\\">\\n                  {editorLines.map((_, idx) => {\\n                    const lineNum = idx + 1;\\n                    const isCritical = criticalFindingLines.has(lineNum);\\n                    const isSelected = selectedFindingLine === lineNum;\\n                    const hasFinding = parseResult.findings.some(f => f.line === lineNum);\\n\\n                    return (\\n                      <div\\n                        key={`gutter-${lineNum}`}\\n                        onClick={() => jumpToLine(lineNum)}\\n                        className={`h-5 leading-5 flex items-center justify-end gap-1 cursor-pointer transition-colors ${\\n                          isSelected\\n                            ? \'text-secondary font-bold\'\\n                            : isCritical\\n                            ? \'text-error font-bold\'\\n                            : hasFinding\\n                            ? \'text-amber-400 font-bold\'\\n                            : \'hover:text-on-surface\'\\n                        }`}\\n                      >\\n                        {isCritical && (\\n                          <span className=\\\"w-1.5 h-1.5 rounded-full bg-error animate-pulse\\\" />\\n                        )}\\n                        {!isCritical && hasFinding && (\\n                          <span className=\\\"w-1.5 h-1.5 rounded-full bg-amber-400\\\" />\\n                        )}\\n                        <span>{lineNum}</span>\\n                      </div>\\n                    );\\n                  })}\\n                </div>\\n\\n                {/* Editable Text Area */}\\n                <textarea\\n                  ref={textareaRef}\\n                  value={gcodeText}\\n                  onChange={e => {\\n                    setGcodeText(e.target.value);\\n                    setActivePresetId(\'\');\\n                  }}\\n                  spellCheck={false}\\n                  placeholder=\\\"(Paste ISO G-code program here or select a verification scenario...)\\\"\\n                  className=\\\"flex-1 p-3 bg-transparent text-on-surface font-mono text-xs leading-5 resize-none focus:outline-none overflow-y-auto whitespace-pre\\\"\\n                  style={{ tabSize: 2 }}\\n                />\\n              </div>\\n\"},{\"AllowMultiple\":false,\"EndLine\":869,\"ReplacementContent\":\"              <div className=\\\"h-[340px] w-full\\\">\\n                <Viewport3D\\n                  cameraPosition={[3.2, 3.2, 3.2]}\\n                  showGrid={true}\\n                  overlay={\\n                    <>\\n                      {/* 3D Visualizer Scene Legend */}\\n                      <div className=\\\"absolute bottom-3 left-3 bg-surface-container-lowest/85 backdrop-blur-md p-2.5 rounded-lg border border-outline-variant/30 text-[9px] font-mono flex flex-col gap-1 text-on-surface shadow-lg pointer-events-none\\\">\\n                        <div className=\\\"flex items-center gap-2\\\">\\n                          <span className=\\\"w-2.5 h-1 bg-secondary rounded-full\\\" />\\n                          <span>FEED MOTION (G01/G02/G03)</span>\\n                        </div>\\n                        <div className=\\\"flex items-center gap-2\\\">\\n                          <span className=\\\"w-2.5 h-1 bg-amber-400 rounded-full\\\" />\\n                          <span>RAPID MOTION (G00)</span>\\n                        </div>\\n                        <div className=\\\"flex items-center gap-2\\\">\\n                          <span className=\\\"w-2.5 h-1 bg-[#ef4444] rounded-full\\\" />\\n                          <span className=\\\"text-error\\\">COLLISION / ERROR POINT</span>\\n                        </div>\\n                        <div className=\\\"flex items-center gap-2 text-outline pt-1 border-t border-outline-variant/20\\\">\\n                          <span>ORIGIN: G54 (0,0,0)</span>\\n                        </div>\\n                      </div>\\n\\n                      {/* Active Tool Readout */}\\n                      {currentSimulationSegment && (\\n                        <div className=\\\"absolute top-3 right-3 bg-surface-container-lowest/85 backdrop-blur-md px-3 py-1.5 rounded-lg border border-outline-variant/30 text-[10px] font-mono flex items-center gap-2 text-on-surface shadow-lg\\\">\\n                          <span className=\\\"text-tertiary\\\">TOOL COORD:</span>\\n                          <span className=\\\"text-secondary font-bold\\\">X{currentSimulationSegment.to.x.toFixed(2)}</span>\\n                          <span className=\\\"text-secondary font-bold\\\">Y{currentSimulationSegment.to.y.toFixed(2)}</span>\\n                          <span className=\\\"text-primary font-bold\\\">Z{currentSimulationSegment.to.z.toFixed(2)}</span>\\n                        </div>\\n                      )}\\n                    </>\\n                  }\\n                >\\n                  <ToolpathScene\\n                    segments={parseResult.segments}\\n                    currentStepIndex={playbackIndex}\\n                    criticalFindingLines={criticalFindingLines}\\n                    bounds={bounds}\\n                  />\\n                </Viewport3D>\\n              </div>\\n\",\"StartLine\":822,\"TargetContent\":\"              <div className=\\\"relative h-[340px] w-full bg-surface-container-lowest\\\">\\n                <Canvas camera={{ position: [3.2, 3.2, 3.2], fov: 45 }}>\\n                  <ambientLight intensity={0.6} />\\n                  <directionalLight position={[5, 10, 5]} intensity={1.2} />\\n                  <pointLight position={[-5, 5, -5]} intensity={0.5} />\\n                  <ToolpathScene\\n                    segments={parseResult.segments}\\n                    currentStepIndex={playbackIndex}\\n                    criticalFindingLines={criticalFindingLines}\\n                    bounds={bounds}\\n                  />\\n                  <OrbitControls ref={controlsRef} />\\n                </Canvas>\\n\\n                {/* 3D Visualizer Scene Legend */}\\n                <div className=\\\"absolute bottom-3 left-3 bg-surface-container-lowest/85 backdrop-blur-md p-2.5 rounded-lg border border-outline-variant/30 text-[9px] font-mono flex flex-col gap-1 text-on-surface shadow-lg pointer-events-none\\\">\\n                  <div className=\\\"flex items-center gap-2\\\">\\n                    <span className=\\\"w-2.5 h-1 bg-secondary rounded-full\\\" />\\n                    <span>FEED MOTION (G01/G02/G03)</span>\\n                  </div>\\n                  <div className=\\\"flex items-center gap-2\\\">\\n                    <span className=\\\"w-2.5 h-1 bg-amber-400 rounded-full\\\" />\\n                    <span>RAPID MOTION (G00