            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    return { rapidLines: rapidGeo, feedLines: feedGeo, collisionPoints: collisions };"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  }, [segments, currentStepIndex, bounds, criticalFindingLines]);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
