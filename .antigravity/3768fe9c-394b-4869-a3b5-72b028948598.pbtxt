  view_file {
    absolute_path_uri: "file:///src/components/ui/Viewport3D.tsx"
    end_line: 63
    content: "import React, { Suspense, useEffect } from \'react\';\nimport { Canvas, useThree } from \'@react-three/fiber\';\nimport { OrbitControls, Grid, PerspectiveCamera, GizmoHelper, GizmoViewport } from \'@react-three/drei\';\n\nfunction CameraUpdater({ position }: { position: [number, number, number] }) {\n  const { camera, controls } = useThree();\n  \n  useEffect(() => {\n    camera.position.set(...position);\n    if (controls) {\n      (controls as any).target.set(0, 0, 0);\n      (controls as any).update();\n    }\n  }, [position, camera, controls]);\n  \n  return null;\n}\n\ninterface Viewport3DProps {\n  children: React.ReactNode;\n  cameraPosition?: [number, number, number];\n  gridSize?: number;\n  showGrid?: boolean;\n  overlay?: React.ReactNode;\n}\n\nexport function Viewport3D({ children, cameraPosition = [150, 150, 150], gridSize = 200, showGrid = true, overlay }: Viewport3DProps) {\n  return (\n    <div className=\"w-full h-full min-h-[400px] bg-black/20 rounded-xl border border-outline-variant/20 overflow-hidden relative\">\n      <Canvas shadows gl={{ antialias: true, alpha: true }}>\n        <PerspectiveCamera makeDefault position={cameraPosition} fov={45} />\n        <CameraUpdater position={cameraPosition} />\n        \n        {/* Shared Industrial Lighting */}\n        <ambientLight intensity={0.5} />\n        <spotLight position={[100, 200, 100]} angle={0.15} penumbra={1} intensity={1} castShadow />\n        <pointLight position={[-100, -100, -100]} intensity={0.5} />\n\n        {showGrid && (\n          <Grid\n            infiniteGrid\n            fadeDistance={500}\n            fadeStrength={5}\n            sectionSize={10}\n            sectionColor=\"#584236\"\n            cellColor=\"#1c2025\"\n          />\n        )}\n\n        <Suspense fallback={null}>\n          {children}\n        </Suspense>\n\n        <OrbitControls makeDefault />\n\n        <GizmoHelper alignment=\"bottom-right\" margin={[80, 80]}>\n          <GizmoViewport axisColors={[\'#ff7a1a\', \'#00cbe6\', \'#ffb68e\']} labelColor=\"white\" />\n        </GizmoHelper>\n      </Canvas>\n      {overlay}\n    </div>\n  );\n}\n"
    num_lines: 64
    num_bytes: 2058
    line_range_bytes: 2058
  }
}
