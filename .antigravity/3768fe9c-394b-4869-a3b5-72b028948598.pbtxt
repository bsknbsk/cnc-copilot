            }
            lines {
              text: "    return new THREE.Vector3("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      (cur.to.x - bounds.centerX) * bounds.scale,"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
