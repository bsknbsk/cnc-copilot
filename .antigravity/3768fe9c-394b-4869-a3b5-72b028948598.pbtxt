  view_file {
    absolute_path_uri: "file:///server.ts"
    end_line: 47
    content: "import express from \'express\';\nimport path from \'path\';\nimport { fileURLToPath } from \'url\';\nimport { PORT } from \'./server/config.js\';\nimport { healthRouter } from \'./server/routes/health.js\';\nimport { userRouter } from \'./server/routes/user.js\';\nimport { explainRouter } from \'./server/routes/explain.js\';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\nasync function startServer() {\n  const app = express();\n  app.use(express.json({ limit: \'25mb\' }));\n  app.use(express.urlencoded({ extended: true, limit: \'25mb\' }));\n\n  // Mount API endpoints\n  app.use(\'/api\', healthRouter);\n  app.use(\'/api\', explainRouter);\n  app.use(\'/api/user\', userRouter);\n\n  const isDev = process.env.NODE_ENV !== \'production\';\n\n  if (isDev) {\n    const { createServer } = await import(\'vite\');\n    const vite = await createServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.resolve(__dirname, \'dist\');\n    app.use(express.static(distPath));\n    app.get(\'*\', (_req, res) => {\n      res.sendFile(path.resolve(distPath, \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`[CNC Copilot] Unified full-stack server running on http://0.0.0.0:${PORT}`);\n  });\n}\n\nstartServer().catch(err => {\n  console.error(\'[CNC Copilot] Server failed to start:\', err);\n  process.exit(1);\n});\n"
    num_lines: 48
    num_bytes: 1427
    line_range_bytes: 1427
  }
}
