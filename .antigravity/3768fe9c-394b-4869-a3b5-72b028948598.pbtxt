            }
            lines {
              text: "    const date = new Date(iso);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const diffMs = now.getTime() - date.getTime();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const diffMin = Math.floor(diffMs / 60000);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const diffHr = Math.floor(diffMin / 60);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (diffMin < 1) return \'Just now\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (diffMin < 60) return `${diffMin}m ago`;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (diffHr < 24) return `${diffHr}h ago`;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    return date.toLocaleDateString([], { month: \'short\', day: \'numeric\' });"
