    replacement_infos {
      original_chunk {
        target_content: "interface CodeEditorProps {\n  code: string;\n  onChange?: (code: string) => void;\n  readOnly?: boolean;\n  flaggedLines?: number[];\n  language?: \'gcode\' | \'javascript\' | \'json\';\n}\n\nexport function CodeEditor({ code, onChange, readOnly, flaggedLines = [], language = \'gcode\' }: CodeEditorProps) {\n  const lines = code.split(\'\\n\');\n\n  const highlightLine = (line: string) => {\n    if (language === \'gcode\') {\n      // Very basic G-code highlighting\n      return line\n        .replace(/([GMXYZFSTH][0-9.]+)/g, \'<span class=\"text-secondary font-bold\">$1</span>\')\n        .replace(/(\\([^)]*\\))/g, \'<span class=\"text-tertiary-container italic\">$1</span>\')\n        .replace(/(N[0-9]+)/g, \'<span class=\"text-primary-container\">$1</span>\');\n    }\n    return line;\n  };\n\n  return (\n    <div className=\"flex bg-surface-container-lowest border border-outline-variant/30 rounded-xl overflow-hidden font-mono text-xs shadow-inner min-h-[300px]\">\n      {/* Line Numbers */}\n      <div className=\"bg-surface-container-low border-r border-outline-variant/20 px-3 py-4 text-right text-tertiary-container select-none\">\n        {lines.map((_, i) => (\n          <div key={i} className=\"h-5\">{i + 1}</div>\n        ))}\n      </div>\n\n      {/* Code Area */}\n      <div className=\"flex-1 relative overflow-x-auto py-4\">\n        {readOnly ? (\n          <div className=\"px-4\">\n            {lines.map((line, i) => (\n              <div\n                key={i}\n                className={`h-5 whitespace-nowrap px-2 rounded-sm ${flaggedLines.includes(i + 1) ? \'bg-error-container/20 border-l-2 border-l-error -ml-4 pl-[14px]\' : \'\'}`}\n                dangerouslySetInnerHTML={{ __html: highlightLine(line) || \'&nbsp;\' }}\n              />\n            ))}\n          </div>\n        ) : (\n          <textarea\n            value={code}\n            onChange={(e) => onChange?.(e.target.value)}\n            className=\"absolute inset-0 w-full h-full px-4 bg-transparent text-on-surface resize-none focus:outline-none placeholder:text-tertiary-container\"\n            spellCheck={false}\n          />\n        )}\n      </div>\n    </div>\n  );\n}\n"
        replacement_content: "interface CodeEditorProps {\n  code: string;\n  onChange?: (code: string) => void;\n  readOnly?: boolean;\n  flaggedLines?: number[];\n  language?: \'gcode\' | \'javascript\' | \'json\';\n  onLineClick?: (line: number) => void;\n  selectedLine?: number | null;\n}\n\nexport function CodeEditor({ \n  code, \n  onChange, \n  readOnly, \n  flaggedLines = [], \n  language = \'gcode\',\n  onLineClick,\n  selectedLine\n}: CodeEditorProps) {\n  const lines = code.split(\'\\n\');\n\n  const highlightLine = (line: string) => {\n    if (language === \'gcode\') {\n      // Very basic G-code highlighting\n      return line\n        .replace(/([GMXYZFSTH][0-9.-]+)/g, \'<span class=\"text-secondary font-bold\">$1</span>\')\n        .replace(/(\\([^)]*\\))/g, \'<span class=\"text-tertiary-container italic\">$1</span>\')\n        .replace(/(N[0-9]+)/g, \'<span class=\"text-primary-container\">$1</span>\');\n    }\n    return line;\n  };\n\n  return (\n    <div className=\"flex bg-surface-container-lowest border border-outline-variant/30 rounded-xl overflow-hidden font-mono text-xs shadow-inner min-h-[300px] h-full\">\n      {/* Line Numbers Gutter */}\n      <div className=\"bg-surface-container-low border-r border-outline-variant/20 py-4 text-right text-tertiary-container/60 select-none flex flex-col\">\n        {lines.map((_, i) => {\n          const lineNum = i + 1;\n          const isFlagged = flaggedLines.includes(lineNum);\n          const isSelected = selectedLine === lineNum;\n          \n          return (\n            <div \n              key={i} \n              onClick={() => onLineClick?.(lineNum)}\n              className={`h-5 px-3 cursor-pointer transition-colors hover:text-on-surface flex items-center justify-end gap-1 ${isSelected ? \'bg-secondary/10 text-secondary font-bold\' : \'\'} ${isFlagged ? \'text-error font-bold\' : \'\'}`}\n            >\n              {isFlagged && <span className=\"w-1.5 h-1.5 rounded-full bg-error animate-pulse\" />}\n              <span>{lineNum}</span>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Code Area */}\n      <div className=\"flex-1 relative overflow-auto py-4 scrollbar-thin scrollbar-thumb-surface-container-high\">\n        {readOnly ? (\n          <div className=\"min-w-max\">\n            {lines.map((line, i) => {\n              const lineNum = i + 1;\n              const isFlagged = flaggedLines.includes(lineNum);\n              const isSelected = selectedLine === lineNum;\n              \n              return (\n                <div\n                  key={i}\n                  className={`h-5 px-4 whitespace-pre rounded-sm transition-colors ${isSelected ? \'bg-secondary/5\' : \'\'} ${isFlagged ? \'bg-error-container/10 border-l-2 border-l-error -ml-[2px]\' : \'\'}`}\n                  dangerouslySetInnerHTML={{ __html: highlightLine(line) || \'&nbsp;\' }}\n                />\n              );\n            })}\n          </div>\n        ) : (\n          <textarea\n            value={code}\n            onChange={(e) => onChange?.(e.target.value)}\n            className=\"absolute inset-0 w-full h-full px-4 bg-transparent text-on-surface resize-none focus:outline-none placeholder:text-tertiary-container whitespace-pre overflow-auto\"\n            spellCheck={false}\n          />\n        )}\n      </div>\n    </div>\n  );\n}\n"
