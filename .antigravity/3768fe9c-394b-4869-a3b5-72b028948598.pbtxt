        target_content: "    <div className=\"w-full px-margin py-margin\">\n      <div className=\"flex flex-col w-full\">\n        {/* Top Process Tabs Bar */}\n        <div className=\"w-full bg-surface-container-low rounded-xl px-space-md py-space-xs flex items-center justify-between mb-space-lg shadow-sm border border-outline-variant/30\">\n          <div className=\"flex items-center gap-space-xs overflow-x-auto\">\n            <button\n              onClick={() => {\n                setProcess(\'milling\');\n                setFeed(0.08);\n              }}\n              className={`px-space-md py-space-sm rounded-lg font-headline-sm text-headline-sm flex items-center gap-space-xs transition-colors cursor-pointer ${\n                process === \'milling\'\n                  ? \'bg-surface-container text-on-surface shadow-inner border border-primary-container/30\'\n                  : \'text-tertiary hover:text-on-surface hover:bg-surface-container\'\n              }`}\n              type=\"button\"\n            >\n              <span className={`w-2 h-2 rounded-full ${process === \'milling\' ? \'bg-primary-container\' : \'bg-transparent\'}`}></span>\n              <span>Milling</span>\n              {process === \'milling\' && (\n                <span className=\"px-space-xs py-0.5 rounded bg-primary-container/20 text-primary-container font-label-sm text-label-sm font-mono uppercase ml-space-xs\">\n                  Active\n                </span>\n              )}\n            </button>\n\n            <button\n              onClick={() => {\n                setProcess(\'turning\');\n                setFeed(0.15);\n              }}\n              className={`px-space-md py-space-sm rounded-lg font-headline-sm text-headline-sm flex items-center gap-space-xs transition-colors cursor-pointer ${\n                process === \'turning\'\n                  ? \'bg-surface-container text-on-surface shadow-inner border border-secondary/30\'\n                  : \'text-tertiary hover:text-on-surface hover:bg-surface-container\'\n              }`}\n              type=\"button\"\n            >\n              <span className=\"material-symbols-outlined text-[18px]\">rotate_right</span>\n              <span>Turning</span>\n            </button>\n\n            <button\n              onClick={() => {\n                setProcess(\'drilling\');\n                setFeed(0.12);\n              }}\n              className={`px-space-md py-space-sm rounded-lg font-headline-sm text-headline-sm flex items-center gap-space-xs transition-colors cursor-pointer ${\n                process === \'drilling\'\n                  ? \'bg-surface-container text-on-surface shadow-inner border border-secondary/30\'\n                  : \'text-tertiary hover:text-on-surface hover:bg-surface-container\'\n              }`}\n              type=\"button\"\n            >\n              <span className=\"material-symbols-outlined text-[18px]\">arrow_downward</span>\n              <span>Drilling</span>\n            </button>\n\n            <button\n              onClick={() => {\n                setProcess(\'tapping\');\n                setPitch(1.5);\n                setDiameter(10.0);\n              }}\n              className={`px-space-md py-space-sm rounded-lg font-headline-sm text-headline-sm flex items-center gap-space-xs transition-colors cursor-pointer ${\n                process === \'tapping\'\n                  ? \'bg-surface-container text-on-surface shadow-inner border border-secondary/30\'\n                  : \'text-tertiary hover:text-on-surface hover:bg-surface-container\'\n              }`}\n              type=\"button\"\n            >\n              <span className=\"material-symbols-outlined text-[18px]\">build</span>\n              <span>Tapping</span>\n            </button>\n\n            <button\n              onClick={() => {\n                setProcess(\'boring\');\n                setFeed(0.12);\n              }}\n              className={`px-space-md py-space-sm rounded-lg font-headline-sm text-headline-sm flex items-center gap-space-xs transition-colors cursor-pointer ${\n                process === \'boring\'\n                  ? \'bg-surface-container text-on-surface shadow-inner border border-secondary/30\'\n                  : \'text-tertiary hover:text-on-surface hover:bg-surface-container\'\n              }`}\n              type=\"button\"\n            >\n              <span className=\"material-symbols-outlined text-[18px]\">trip_origin</span>\n              <span>Boring</span>\n            </button>\n          </div>\n\n          <div className=\"hidden lg:flex items-center gap-space-md\">\n            <div className=\"flex items-center gap-space-xs font-label-md text-label-md font-mono text-tertiary-container\">\n              <span>KINEMATIC ENGINE:</span>\n              <span className=\"text-secondary font-semibold\">KIENZLE FORCE V4.2</span>\n            </div>\n            <span className=\"w-1.5 h-1.5 rounded-full bg-secondary animate-pulse\"></span>\n          </div>\n        </div>"
        replacement_content: "    <div className=\"w-full px-margin py-margin\">\n      <div className=\"flex flex-col w-full\">\n        {/* Header & Process Tabs */}\n        <section className=\"w-full mb-space-lg\">\n          <PageHeader\n            label=\"Kinematic Engine: Kienzle Force V4.2\"\n            title=\"Cutting Physics Calculator\"\n            caption=\"Optimize spindle RPM, chip load (fz), and cutting power with real-time physics.\"\n            actions={\n              <Tabs\n                activeTab={process}\n                onTabChange={(id) => {\n                  setProcess(id as ProcessType);\n                  if (id === \'milling\') setFeed(0.08);\n                  if (id === \'turning\') setFeed(0.15);\n                  if (id === \'drilling\') setFeed(0.12);\n                  if (id === \'tapping\') { setPitch(1.5); setDiameter(10.0); }\n                  if (id === \'boring\') setFeed(0.12);\n                }}\n                tabs={[\n                  { id: \'milling\', label: \'Milling\', icon: \'engineering\' },\n                  { id: \'turning\', label: \'Turning\', icon: \'rotate_right\' },\n                  { id: \'drilling\', label: \'Drilling\', icon: \'arrow_downward\' },\n                  { id: \'tapping\', label: \'Tapping\', icon: \'build\' },\n                  { id: \'boring\', label: \'Boring\', icon: \'trip_origin\' },\n                ]}\n              />\n            }\n          />\n        </section>"
        start_line: 143
        end_line: 242
      }
