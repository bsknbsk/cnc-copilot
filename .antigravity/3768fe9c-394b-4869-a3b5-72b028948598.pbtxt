        target_content: "      <div className=\"max-w-7xl mx-auto px-margin pt-6 flex flex-col gap-6\">\n        {/* Top 4 KPI Strip matching Stitch Tokens & Classes */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n          {/* Card 1: Safety Audit Index */}\n          <div className=\"bg-surface-container rounded-xl p-4 border border-outline-variant/30 relative overflow-hidden flex flex-col justify-between\">\n            <div className=\"flex items-center justify-between text-xs font-mono text-tertiary uppercase tracking-wider\">\n              <span>SAFETY STATUS</span>\n              <span className=\"material-symbols-outlined text-[18px]\">\n                {parseResult.criticalCount > 0 ? \'error\' : parseResult.warningCount > 0 ? \'warning\' : \'verified_user\'}\n              </span>\n            </div>\n            <div className=\"mt-2\">\n              <div className=\"font-code-lg text-xl font-bold flex items-center gap-2\">\n                {parseResult.criticalCount > 0 ? (\n                  <span className=\"text-error\">{parseResult.criticalCount} CRITICAL COLLISION</span>\n                ) : parseResult.warningCount > 0 ? (\n                  <span className=\"text-amber-400\">{parseResult.warningCount} WARNINGS</span>\n                ) : (\n                  <span className=\"text-emerald-400\">100% PRE-FLIGHT PASS</span>\n                )}\n              </div>\n              <div className=\"text-[11px] font-mono text-tertiary mt-1\">\n                {parseResult.criticalCount > 0\n                  ? \'Catastrophic tool / workpiece hazard detected\'\n                  : \'ISO-6983 & DIN 66025 compliant\'}\n              </div>\n            </div>\n            <div className=\"mt-3 pt-2 border-t border-outline-variant/20 flex items-center justify-between text-[10px] font-mono text-outline\">\n              <span>DIALECT: {controller.toUpperCase()}</span>\n              <span className=\"text-secondary-fixed\">MODAL AUDIT ACTIVE</span>\n            </div>\n          </div>\n\n          {/* Card 2: Block Count & Motion Breakdown */}\n          <div className=\"bg-surface-container rounded-xl p-4 border border-outline-variant/30 flex flex-col justify-between\">\n            <div className=\"flex items-center justify-between text-xs font-mono text-tertiary uppercase tracking-wider\">\n              <span>PARSED BLOCKS</span>\n              <span className=\"material-symbols-outlined text-[18px]\">data_array</span>\n            </div>\n            <div className=\"mt-2\">\n              <div className=\"font-code-lg text-xl font-bold text-on-surface\">\n                {parseResult.blockCount}{\' \'}\n                <span className=\"text-xs text-tertiary font-normal\">LINES</span>\n              </div>\n              <div className=\"text-[11px] font-mono text-tertiary mt-1 flex items-center gap-2\">\n                <span className=\"text-secondary\">{parseResult.segments.filter(s => s.type !== \'rapid\').length} FEED</span>\n                <span>\342\200\242</span>\n                <span className=\"text-amber-300\">{parseResult.segments.filter(s => s.type === \'rapid\').length} RAPID</span>\n              </div>\n            </div>\n            <div className=\"mt-3 pt-2 border-t border-outline-variant/20 flex items-center justify-between text-[10px] font-mono text-outline\">\n              <span>TOTAL MOTIONS</span>\n              <span className=\"text-on-surface font-bold\">{parseResult.segments.length} SEGMENTS</span>\n            </div>\n          </div>\n\n          {/* Card 3: Work Envelope Bounds */}\n          <div className=\"bg-surface-container rounded-xl p-4 border border-outline-variant/30 flex flex-col justify-between\">\n            <div className=\"flex items-center justify-between text-xs font-mono text-tertiary uppercase tracking-wider\">\n              <span>WORK ENVELOPE BOUNDS</span>\n              <span className=\"material-symbols-outlined text-[18px]\">view_in_ar</span>\n            </div>\n            <div className=\"mt-2\">\n              <div className=\"font-mono text-xs font-bold text-on-surface flex flex-col gap-0.5\">\n                <div className=\"flex justify-between\">\n                  <span className=\"text-tertiary\">X TRAVEL:</span>\n                  <span className=\"text-secondary-fixed\">{travelBounds.xRange}</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span className=\"text-tertiary\">Y TRAVEL:</span>\n                  <span className=\"text-secondary-fixed\">{travelBounds.yRange}</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span className=\"text-tertiary\">Z TRAVEL:</span>\n                  <span className=\"text-primary\">{travelBounds.zRange}</span>\n                </div>\n              </div>\n            </div>\n            <div className=\"mt-3 pt-2 border-t border-outline-variant/20 flex items-center justify-between text-[10px] font-mono text-outline\">\n              <span>DATUM REF</span>\n              <span className=\"text-emerald-400\">G54 WCS MODAL</span>\n            </div>\n          </div>\n\n          {/* Card 4: Kinematic Rates */}\n          <div className=\"bg-surface-container rounded-xl p-4 border border-outline-variant/30 flex flex-col justify-between\">\n            <div className=\"flex items-center justify-between text-xs font-mono text-tertiary uppercase tracking-wider\">\n              <span>PEAK RATES</span>\n              <span className=\"material-symbols-outlined text-[18px]\">speed</span>\n            </div>\n            <div className=\"mt-2\">\n              <div className=\"font-code-lg text-xl font-bold text-on-surface\">\n                {travelBounds.maxRpm > 0 ? `S${travelBounds.maxRpm}` : \'S0\'}{\' \'}\n                <span className=\"text-xs text-tertiary font-normal\">RPM</span>\n              </div>\n              <div className=\"text-[11px] font-mono text-tertiary mt-1\">\n                PEAK FEED: <span className=\"text-secondary font-bold\">{travelBounds.maxFeed} mm/min</span>\n              </div>\n            </div>\n            <div className=\"mt-3 pt-2 border-t border-outline-variant/20 flex items-center justify-between text-[10px] font-mono text-outline\">\n              <span>LENGTH COMP (G43)</span>\n              <span className={criticalFindingLines.size > 0 ? \'text-error\' : \'text-emerald-400\'}>\n                {criticalFindingLines.size > 0 ? \'AUDIT ALERT\' : \'CHECKED\'}\n              </span>\n            </div>\n          </div>\n        </div>"
        replacement_content: "        {/* Top 4 KPI Strip */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n          <Card className=\"p-4 flex flex-col justify-between\">\n            <SectionHeader title=\"Safety Status\" icon={parseResult.criticalCount > 0 ? \'error\' : \'verified_user\'} className=\"border-b-0 mb-0 pb-0\" />\n            <div className=\"mt-2\">\n              <div className=\"font-code-lg text-xl font-bold\">\n                {parseResult.criticalCount > 0 ? (\n                  <span className=\"text-error\">{parseResult.criticalCount} COLLISION</span>\n                ) : (\n                  <span className=\"text-secondary\">100% PRE-FLIGHT PASS</span>\n                )}\n              </div>\n              <div className=\"text-[11px] font-mono text-tertiary mt-1 uppercase\">ISO-6983 COMPLIANT</div>\n            </div>\n          </Card>\n\n          <Card className=\"p-4 flex flex-col justify-between\">\n            <SectionHeader title=\"Parsed Blocks\" icon=\"data_array\" className=\"border-b-0 mb-0 pb-0\" />\n            <div className=\"mt-2\">\n              <div className=\"font-code-lg text-xl font-bold text-on-surface\">\n                {parseResult.blockCount} <span className=\"text-xs text-tertiary font-normal\">LINES</span>\n              </div>\n              <div className=\"text-[11px] font-mono text-tertiary mt-1 flex items-center gap-2\">\n                <Badge variant=\"secondary\">{parseResult.segments.filter(s => s.type !== \'rapid\').length} FEED</Badge>\n                <Badge variant=\"warning\">{parseResult.segments.filter(s => s.type === \'rapid\').length} RAPID</Badge>\n              </div>\n            </div>\n          </Card>\n\n          <Card className=\"p-4 flex flex-col justify-between\">\n            <SectionHeader title=\"Envelope\" icon=\"view_in_ar\" className=\"border-b-0 mb-0 pb-0\" />\n            <div className=\"mt-2 space-y-1\">\n              <StatChip label=\"X Range\" value={travelBounds.xRange} variant=\"secondary\" />\n              <StatChip label=\"Y Range\" value={travelBounds.yRange} variant=\"secondary\" />\n              <StatChip label=\"Z Range\" value={travelBounds.zRange} variant=\"primary\" />\n            </div>\n          </Card>\n\n          <Card className=\"p-4 flex flex-col justify-between\">\n            <SectionHeader title=\"Peak Rates\" icon=\"speed\" className=\"border-b-0 mb-0 pb-0\" />\n            <div className=\"mt-2\">\n              <div className=\"font-code-lg text-xl font-bold text-on-surface\">\n                {travelBounds.maxRpm > 0 ? `S${travelBounds.maxRpm}` : \'S0\'} <span className=\"text-xs text-tertiary font-normal\">RPM</span>\n              </div>\n              <div className=\"text-[11px] font-mono text-tertiary mt-1\">\n                PEAK FEED: <span className=\"text-secondary font-bold\">{travelBounds.maxFeed} mm/min</span>\n              </div>\n            </div>\n          </Card>\n        </div>"
