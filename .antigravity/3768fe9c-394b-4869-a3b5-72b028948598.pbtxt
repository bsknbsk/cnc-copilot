      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false,\"Description\":\"Update imports in CuttingCalculator.tsx to use shared UI components\",\"EndLine\":7,\"Instruction\":\"Import shared UI components from src/components/ui/ while keeping existing imports\",\"ReplacementContent\":\"import React, { useState, useMemo } from \'react\';\\nimport { useAuth } from \'../../context/AuthContext.js\';\\nimport { collection, addDoc } from \'firebase/firestore\';\\nimport { MATERIALS, MaterialSpec } from \'../../engine/materials.js\';\\nimport { calculateCutting, ProcessType, ToolMaterialType, CuttingInputs, CuttingResults } from \'../../engine/cutting.js\';\\nimport { Calculator3DView } from \'./Calculator3DView.js\';\\nimport { apiFetch, db } from \'../../lib/firebase.js\';\\nimport { \\n  PageHeader, \\n  SectionHeader, \\n  StatChip, \\n  Card, \\n  Badge \\n} from \'../ui/Headers.js\';\\nimport { ButtonPrimary, ButtonSecondary } from \'../ui/Button.js\';\\nimport { Tabs, Skeleton, ProgressBar, Drawer } from \'../ui/Feedback.js\';\",\"StartLine\":1,\"TargetContent\":\"import React, { useState, useMemo } from \'react\';\\nimport { useAuth } from \'../../context/AuthContext.js\';\\nimport { collection, addDoc } from \'firebase/firestore\';\\nimport { MATERIALS, MaterialSpec } from \'../../engine/materials.js\';\\nimport { calculateCutting, ProcessType, ToolMaterialType, CuttingInputs, CuttingResults } from \'../../engine/cutting.js\';\\nimport { Calculator3DView } from \'./Calculator3DView.js\';\\nimport { apiFetch, db } from \'../../lib/firebase.js\';\",\"TargetFile\":\"/src/components/calculator/CuttingCalculator.tsx\",\"toolAction\":\"Updating CuttingCalculator.tsx imports\",\"toolSummary\":\"Update CuttingCalculator.tsx imports\"}"
