        target_content: "          {/* Left Inputs Panel (approx 460px on wide viewports -> xl:col-span-5) */}\n          <div className=\"xl:col-span-5 bg-surface-container rounded-xl p-space-lg shadow-md flex flex-col gap-space-md border border-outline-variant/30\">\n            {/* Units Toggle & Header */}\n            <div className=\"flex items-center justify-between pb-space-xs\">\n              <div className=\"flex flex-col\">\n                <span className=\"font-headline-sm text-headline-sm text-on-surface\">Tool & Cut Geometry</span>\n                <span className=\"font-label-sm text-label-sm text-tertiary-container font-mono uppercase\">\n                  Setup Parameters\n                </span>\n              </div>\n              {/* Segmented Unit Switcher */}\n              <div className=\"p-1 rounded bg-surface-container-low flex items-center font-label-sm text-label-sm font-mono border border-outline-variant/30\">\n                <button\n                  onClick={() => setIsMetric(true)}\n                  className={`px-space-sm py-1 rounded cursor-pointer transition-all ${\n                    isMetric ? \'bg-surface text-secondary font-bold shadow-sm\' : \'text-tertiary hover:text-on-surface\'\n                  }`}\n                  type=\"button\"\n                >\n                  Metric (mm/min)\n                </button>\n                <button\n                  onClick={() => setIsMetric(false)}\n                  className={`px-space-sm py-1 rounded cursor-pointer transition-all ${\n                    !isMetric ? \'bg-surface text-secondary font-bold shadow-sm\' : \'text-tertiary hover:text-on-surface\'\n                  }`}\n                  type=\"button\"\n                >\n                  Imperial (IPM)\n                </button>\n              </div>\n            </div>"
        replacement_content: "          {/* Left Inputs Panel */}\n          <Card className=\"xl:col-span-5 p-space-lg flex flex-col gap-space-md\">\n            {/* Units Toggle & Header */}\n            <div className=\"flex items-center justify-between pb-space-xs\">\n              <SectionHeader title=\"Tool & Cut Geometry\" className=\"border-b-0 mb-0 pb-0\" />\n              {/* Segmented Unit Switcher */}\n              <div className=\"p-1 rounded bg-surface-container-low flex items-center font-label-sm text-label-sm font-mono border border-outline-variant/30\">\n                <button\n                  onClick={() => setIsMetric(true)}\n                  className={`px-space-sm py-1 rounded cursor-pointer transition-all ${\n                    isMetric ? \'bg-surface text-secondary font-bold shadow-sm\' : \'text-tertiary hover:text-on-surface\'\n                  }`}\n                  type=\"button\"\n                >\n                  Metric\n                </button>\n                <button\n                  onClick={() => setIsMetric(false)}\n                  className={`px-space-sm py-1 rounded cursor-pointer transition-all ${\n                    !isMetric ? \'bg-surface text-secondary font-bold shadow-sm\' : \'text-tertiary hover:text-on-surface\'\n                  }`}\n                  type=\"button\"\n                >\n                  IPM\n                </button>\n              </div>\n            </div>"
